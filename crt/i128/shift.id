// a >> n, logical (unsigned): zeros come in from the top.
ci128_shr(word wqd, word wqa, word wqn) {
  word wql = peek64(wqa);
  word wqh = peek64(wqa + 8);
  word wqs = wqn & 127;
} chain (word wqd, word wqa, word wqn) {
  if(wqs >= 64) {
    wql = ushr(wqh, wqs - 64);
    wqh = 0;
  } else if(wqs > 0) {
    wql = ushr(wql, wqs) | (wqh << (64 - wqs));
    wqh = ushr(wqh, wqs);
  }
  ld_cset(wqd, wql, wqh);
} return word wqd;
