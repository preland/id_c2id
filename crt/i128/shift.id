// a >> n, arithmetic (signed): the sign comes in from the top.
ci128_sar(word wqd, word wqa, word wqn) {
  word wql = peek64(wqa);
  word wqh = peek64(wqa + 8);
  word wqs = wqn & 127;
} chain (word wqd, word wqa, word wqn) {
  if(wqs >= 64) {
    wql = wqh >> (wqs - 64);
    wqh = wqh >> 63;
  } else if(wqs > 0) {
    wql = ushr(wql, wqs) | (wqh << (64 - wqs));
    wqh = wqh >> wqs;
  }
  ld_cset(wqd, wql, wqh);
} return word wqd;
