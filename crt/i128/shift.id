// a << n for a count n of 0 to 127: counts of 64 and more move the low word up whole.
ci128_shl(word wqd, word wqa, word wqn) {
  word wql = peek64(wqa);
  word wqh = peek64(wqa + 8);
  word wqs = wqn & 127;
} chain (word wqd, word wqa, word wqn) {
  if(wqs >= 64) {
    wqh = wql << (wqs - 64);
    wql = 0;
  } else if(wqs > 0) {
    wqh = (wqh << wqs) | ushr(wql, 64 - wqs);
    wql = wql << wqs;
  }
  ld_cset(wqd, wql, wqh);
} return word wqd;
