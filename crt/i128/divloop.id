// Both operands fit a word: the words' own division.
wq_divfast(word[] wqu) {
  wqu[4] = udiv(wqu[0], wqu[2]);
  wqu[6] = umod(wqu[0], wqu[2]);
} return void;
([100, 0, 7, 0, 0, 0, 0, 0, 0, 0]):([100, 0, 7, 0, 14, 0, 2, 0, 0, 0])
([-1, 0, 2, 0, 0, 0, 0, 0, 0, 0]):([-1, 0, 2, 0, 9223372036854775807, 0, 1, 0, 0, 0])

// The quotient and remainder of the unsigned dividend by the divisor. Dividing by
// zero is undefined in C; here the quotient is 0 and the remainder the dividend.
wq_udivmod(word[] wqu) {
  if(wqu[2] == 0 && wqu[3] == 0) {
    wq_zerodiv(wqu);
  } else if(wqu[1] == 0 && wqu[3] == 0) {
    wq_divfast(wqu);
  } else {
    wq_divloop(wqu);
  }
} return void;
