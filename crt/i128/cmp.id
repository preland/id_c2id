// The order of two 128-bit values as -1, 0 or 1: the high words decide, by signed
// comparison for signed values (wqs 1) and unsigned for unsigned ones (wqs 0), then
// the low words, always unsigned.
wq_order(word wqa, word wqb, word wqs) {
  word wqah = peek64(wqa + 8);
  word wqbh = peek64(wqb + 8);
  word wqr = wq_ord64(wqah, wqbh, wqs);
} chain (word wqa, word wqb, word wqs) {
  if(wqr == 0) {
    wqr = wq_ord64(peek64(wqa), peek64(wqb), 0);
  }
} return word wqr;
