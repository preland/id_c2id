// -1, 0 or 1 for two words compared signed (wqs 1) or unsigned (wqs 0).
wq_ord64(word wqa, word wqb, word wqs) {
  word wqr = 0;
  if(wqa != wqb) {
    wqr = wq_ord64b(wqa, wqb, wqs);
  }
} return word wqr;
(5, 5, 1):(0)
(1, 2, 1):(-1)

wq_ord64b(word wqa, word wqb, word wqs) {
  word wqr = 1;
  if(wqs == 1 && wqa < wqb) {
    wqr = -1;
  }
  if(wqs == 0 && ult(wqa, wqb) == 1) {
    wqr = -1;
  }
} return word wqr;
(-1, 1, 1):(-1)
(-1, 1, 0):(1)
