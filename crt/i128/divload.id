// The ten words for the division of the values at wqa and wqb. For a signed division
// (wqs 1) the operands are their magnitudes and words 8 and 9 their signs.
wq_load(word wqa, word wqb, word wqs) {
  word wqsa = wqs & ushr(peek64(wqa + 8), 63);
  word wqsb = wqs & ushr(peek64(wqb + 8), 63);
  word[] wqu = [peek64(wqa), peek64(wqa + 8), peek64(wqb), peek64(wqb + 8), (import wzero), (import wzero), (import wzero), (import wzero), wqsa, wqsb];
} chain (word wqa, word wqb, word wqs) {
  wq_mag(wqu);
} return word[] wqu;
