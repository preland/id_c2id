// The magnitudes of the operands marked negative.
wq_mag(word[] wqu) {
  if(wqu[8] == 1) {
    wq_neg2(wqu, 0);
  }
  if(wqu[9] == 1) {
    wq_neg2(wqu, 2);
  }
} return void;
