wq_rel(word wqd, int wqop) {
  int[] wqk = [wqd < 0, wqd <= 0, wqd > 0, wqd >= 0, wqd == 0, wqd != 0];
  int wqj = wqk[wqop];
  word wqr = wqj;
} return word wqr;
