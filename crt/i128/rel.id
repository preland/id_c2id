// a < b, a <= b, a > b, a >= b, a == b, a != b as 0 or 1 for the operator's code
// 0 to 5, signed (cmps) or unsigned (cmpu).
ci128_cmps(word wqa, word wqb, int wqop) {
  word wqr = wq_rel(wq_order(wqa, wqb, 1), wqop);
} return word wqr;
