ci128_divs(word wqd, word wqa, word wqb) {
  word[] wqu = wq_load(wqa, wqb, 1);
  wq_udivmod(wqu);
  wq_out(wqd, wqu, 0);
} return word wqd;
given wq_cells ((import wqz), (import wqx), (import wqy)):((import wqz)) then wq_zl:(-1) then wq_zh:(0)
