ci128_not(word wqd, word wqa) {
  word wql = ~peek64(wqa);
  word wqh = ~peek64(wqa + 8);
  ld_cset(wqd, wql, wqh);
} return word wqd;
given wq_cells ((import wqz), (import wqx)):((import wqz)) then wq_zl:(0) then wq_zh:(-2)
given wq_cells ((import wqz), (import wqy)):((import wqz)) then wq_zl:(-3) then wq_zh:(-1)

// 1 when the value is not zero.
ci128_nz(word wqa) {
  word wqr = ult(0, peek64(wqa) | peek64(wqa + 8));
} return word wqr;
