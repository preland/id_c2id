ci128_neg(word wqd, word wqa) {
  word wql = 0 - peek64(wqa);
  word wqh = 0 - peek64(wqa + 8) - ult(0, peek64(wqa));
  ld_cset(wqd, wql, wqh);
} return word wqd;
