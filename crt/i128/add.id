// 128-bit integers (`__int128`, `unsigned __int128`): 16 bytes, the low word first,
// handled like a long double: no word holds one, so a value in an expression is the
// address of its bytes, and an operation hands these functions the address of a
// 16-byte frame temporary for the result and the addresses of its operands. The
// result is written to the first and answered. Both operands are read before it is
// written, so it may be one of them. Arithmetic wraps modulo 2^128; a shift count is
// taken as given (0 to 127), as C leaves other counts undefined.
ci128_add(word wqd, word wqa, word wqb) {
  word wql = peek64(wqa) + peek64(wqb);
  word wqh = peek64(wqa + 8) + peek64(wqb + 8) + ult(wql, peek64(wqa));
  ld_cset(wqd, wql, wqh);
} return word wqd;
given wq_cells ((import wqz), (import wqx), (import wqy)):((import wqz)) then wq_zl:(1) then wq_zh:(2)
given wq_cells ((import wqz), (import wqy), (import wqy)):((import wqz)) then wq_zl:(4) then wq_zh:(0)

ci128_sub(word wqd, word wqa, word wqb) {
  word wql = peek64(wqa) - peek64(wqb);
  word wqh = peek64(wqa + 8) - peek64(wqb + 8) - ult(peek64(wqa), peek64(wqb));
  ld_cset(wqd, wql, wqh);
} return word wqd;
given wq_cells ((import wqz), (import wqx), (import wqy)):((import wqz)) then wq_zl:(-3) then wq_zh:(1)
