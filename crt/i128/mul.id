// a * b modulo 2^128: the low word is the low half of the low words' product, the high
// word adds the carry out of that product and the two cross products' low halves.
ci128_mul(word wqd, word wqa, word wqb) {
  word wql = peek64(wqa) * peek64(wqb);
  word wqc = wq_mulhi(peek64(wqa), peek64(wqb));
  word wqh = wqc + peek64(wqa) * peek64(wqb + 8) + peek64(wqa + 8) * peek64(wqb);
} chain (word wqd, word wqa, word wqb) {
  ld_cset(wqd, wql, wqh);
} return word wqd;
