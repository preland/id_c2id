// The high 64 bits of the 128-bit product of two unsigned 64-bit words, from their
// 32-bit halves: no partial product or sum below overflows a word.
wq_mulhi(word wqe, word wqf) {
  word wqm = 4294967295;
  word wqp = (wqe & wqm) * (wqf & wqm);
  word wqq = ushr(wqe, 32) * (wqf & wqm) + ushr(wqp, 32);
} chain (word wqe, word wqf) {
  word wqr = (wqe & wqm) * ushr(wqf, 32) + (wqq & wqm);
  word wqt = ushr(wqe, 32) * ushr(wqf, 32) + ushr(wqq, 32);
  word wqs = wqt + ushr(wqr, 32);
} return word wqs;
