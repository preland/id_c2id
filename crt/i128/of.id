// A 128-bit value from an integer, whose C value arrives in a word: sign-extended
// for a signed type (the high word is the sign), zero-extended for an unsigned one.
ci128_of_s(word wqd, word wqv) {
  word wqh = wqv >> 63;
  ld_cset(wqd, wqv, wqh);
} return word wqd;
