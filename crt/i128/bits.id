ci128_xor(word wqd, word wqa, word wqb) {
  word wql = peek64(wqa) ^ peek64(wqb);
  word wqh = peek64(wqa + 8) ^ peek64(wqb + 8);
  ld_cset(wqd, wql, wqh);
} return word wqd;
