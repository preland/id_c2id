// a / b and a % b for unsigned operands (divu, modu) and signed ones (divs, mods,
// in divs.id). The quotient or remainder is written to wqd, which may be an operand.
ci128_divu(word wqd, word wqa, word wqb) {
  word[] wqu = wq_load(wqa, wqb, 0);
  wq_udivmod(wqu);
  wq_out(wqd, wqu, 0);
} return word wqd;
given wq_cells ((import wqz), (import wqx), (import wqy)):((import wqz)) then wq_zl:(-1) then wq_zh:(0)
given wq_cells ((import wqz), (import wqy), (import wqx)):((import wqz)) then wq_zl:(0) then wq_zh:(0)

ci128_modu(word wqd, word wqa, word wqb) {
  word[] wqu = wq_load(wqa, wqb, 0);
  wq_udivmod(wqu);
  wq_out(wqd, wqu, 1);
} return word wqd;
given wq_cells ((import wqz), (import wqx), (import wqy)):((import wqz)) then wq_zl:(1) then wq_zh:(0)
given wq_cells ((import wqz), (import wqy), (import wqx)):((import wqz)) then wq_zl:(2) then wq_zh:(0)
