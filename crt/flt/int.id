cfl_of_uint(word a) {
  float cfx = a + 0.0;
  if(a < 0) {
    word cfh = ushr(a, 1) | (a & 1);
    cfx = (cfh + 0.0) * 2.0;
  }
  word cfr = bits_of_float(cfx);
} return word cfr;
