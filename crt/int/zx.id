// Zero-extension, i.e. truncation to a narrower width with the result read
// as unsigned: a single mask of `bits` ones. The width is a parameter because
// the three widths differ only in that literal.

zx_bits(word v, int bits) {
  word mask = (1 << bits) - 1;
  word x = v & mask;
} return word x;
(0xff, 8):(255)
(0x100, 8):(0)
(0xffff, 16):(65535)
(0x100000000, 32):(0)
(0xffffffff, 32):(4294967295)
