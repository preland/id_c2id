// a * b. Both operands normalised, the product is hi:lo with its top bit at
// bit 127 or 126; ld_pack shifts it up, lowering the exponent, and rounds.
ld_mfin(word[] lqa, word[] lqb) {
  ld_fixn(lqa);
  ld_fixn(lqb);
  word lxh = ld_mulhi(lqa[2], lqb[2]);
} chain (word[] lqa, word[] lqb) {
  word[] lqw = [lqa[0] ^ lqb[0], lqa[1] + lqb[1] - 16382, lxh, lqa[2] * lqb[2]];
  word[] lqr = ld_pack(lqw);
} return word[] lqr;
([0, 16383, -4611686018427387904], [0, 16383, -4611686018427387904]):([-8070450532247928832, 16384])
([1, 16383, -9223372036854775808], [0, 16384, -9223372036854775808]):([-9223372036854775808, 49152])

ld_mul3(word[] lqa, word[] lqb, word lxka, word lxkb) {
  word[] lqr = ld_spec(lqa, lqb, lxka, lxkb, 0);
  if(len(lqr) == 0) {
    lqr = ld_mfin(lqa, lqb);
  }
} return word[] lqr;
([0, 16383, -9223372036854775808], [0, 16383, -9223372036854775808], 1, 1):([-9223372036854775808, 16383])
([0, 0, 0], [0, 16383, -9223372036854775808], 0, 1):([0, 0])
