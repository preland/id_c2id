// dst = a op b for the addresses dst, a and b of long doubles; the result is
// written to dst and dst answered. lxo is the operation's code (see ld_bin4).
ld_bin(word lxa, word lxb, word lxo) {
  word[] lqa = ld_get(lxa);
  word[] lqb = ld_get(lxb);
  word[] lqr = ld_bin2(lqa, lqb, lxo);
} return word[] lqr;
