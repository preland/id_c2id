// dst = a op b under the operation code lxo (0 add, 1 sub, 2 mul, 3 div). One
// function because the four differ only in that literal.
cld_arith(word lxo, word lxd, word lxa, word lxb) {
  word[] lqr = ld_bin(lxa, lxb, lxo);
  ld_put(lxd, lqr);
} return word lxd;
