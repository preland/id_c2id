// The NaN an operation with a NaN operand answers: the operand quieted, and
// when both are NaNs the one with the larger significand (the positive one on
// a tie, a if both are). ld_nanq takes the chosen operand's significand and sign.
ld_nanq(word lxm, word lxs) {
  word[] lqr = [lxm | 0x4000000000000000, (lxs << 15) | 32767];
} return word[] lqr;
(-9223372036854775807, 0):([-4611686018427387903, 32767])
(-4611686018427387904, 1):([-4611686018427387904, 65535])

ld_nanpick(word[] lqa, word[] lqb, word lxka, word lxkb) {
  word lxc = 0;
  if(lxka != 3 || (lxkb == 3 && (ult(lqa[2], lqb[2]) == 1 || (lqa[2] == lqb[2] && lqa[0] == 1)))) {
    lxc = 1;
  }
  word[] lqr = ld_nanq(ld_pk(lqb, lqa, lxc, 2), ld_pk(lqb, lqa, lxc, 0));
} return word[] lqr;
([0, 32767, -9223372036854775807], [0, 32767, -9223372036854775806], 3, 3):([-4611686018427387902, 32767])
([0, 32767, -9223372036854775806], [0, 32767, -9223372036854775807], 3, 3):([-4611686018427387902, 32767])
([1, 32767, -4611686018427387904], [0, 32767, -4611686018427387904], 3, 3):([-4611686018427387904, 32767])
([0, 16383, -9223372036854775808], [1, 32767, -4611686018427387904], 1, 3):([-4611686018427387904, 65535])

// [] when neither operand is a NaN or an invalid encoding. An invalid encoding
// wins over a NaN: the x87 answers the indefinite NaN for it.
ld_nanres(word[] lqa, word[] lqb, word lxka, word lxkb) {
  word[] lqr = [];
  if(lxka == 3 || lxkb == 3) {
    lqr = ld_nanpick(lqa, lqb, lxka, lxkb);
  }
  if(lxka == 4 || lxkb == 4) {
    lqr = ld_indef(1);
  }
} return word[] lqr;
