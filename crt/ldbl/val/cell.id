// An operand read from the store: [sign, biased exponent, significand]. ld_put
// writes a result [significand, sign and exponent] back, with the six padding
// bytes zero.
ld_get(word lxp) {
  word lxs = peek16(lxp + 8);
  word lxm = peek64(lxp);
  word[] lqa = [ushr(lxs, 15), lxs & 32767, lxm];
} return word[] lqa;
