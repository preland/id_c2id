// 0 zero, 1 finite non-zero (a denormal included), 2 infinity, 3 NaN, 4 an
// encoding the x87 refuses (an exponent from 1 to 32767 with the integer bit
// clear: an unnormal, a pseudo-infinity, a pseudo-NaN), which it answers with the
// indefinite NaN whatever the other operand is.
ld_kind(word lxe, word lxm) {
  word lxk = 1;
  if(lxe == 32767) {
    lxk = 2 + ((lxm << 1) != 0);
  }
  if(lxe == 0 && lxm == 0) {
    lxk = 0;
  }
} chain (word lxe, word lxm) {
  if(lxe > 0 && lxm >= 0) {
    lxk = 4;
  }
} return word lxk;
