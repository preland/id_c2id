// long double to a 64-bit integer, truncated toward zero. lxbits is 63 for a
// signed result and 64 for an unsigned one, the only difference between them.
cld_to_integer(word lxbits, word lxa) {
  word[] lqa = ld_get(lxa);
  word lxk = ld_kind(lqa[1], lqa[2]);
  word lxr = ld_toi(lqa, lxk, lxbits);
} return word lxr;
