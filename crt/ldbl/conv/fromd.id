(-4611686018427387904, 1024):([-9223372036854775808, 49152])

ld_ofdd(word lxf, word lxs) {
  word lxk = ld_clz(lxf);
  word[] lqr = [lxf << lxk, (lxs << 15) | (15372 - lxk)];
} return word[] lqr;
