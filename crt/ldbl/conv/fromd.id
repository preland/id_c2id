ld_ofdz(word lxb) {
  word lxf = lxb & 4503599627370495;
  word[] lqr = [0, ushr(lxb, 63) << 15];
  if(lxf != 0) {
    lqr = ld_ofshift(lxf, ushr(lxb, 63), 15372);
  }
} return word[] lqr;
