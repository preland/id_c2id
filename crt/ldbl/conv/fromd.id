// A double (the 64 bits of its binary64) to long double, exact. A denormal
// double is normal in extended precision; a signalling NaN becomes quiet.
ld_ofdn(word lxb, word lxe) {
  word lxm = ((lxb & 4503599627370495) | 4503599627370496) << 11;
  word[] lqr = [lxm, (ushr(lxb, 63) << 15) | (lxe + 15360)];
} return word[] lqr;
