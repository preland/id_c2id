(3, 1):([-4611686018427387904, 48078])

ld_ofdz(word lxb) {
  word lxf = lxb & 4503599627370495;
  word[] lqr = [0, ushr(lxb, 63) << 15];
  if(lxf != 0) {
    lqr = ld_ofdd(lxf, ushr(lxb, 63));
  }
} return word[] lqr;
