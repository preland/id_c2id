// Integers to long double: exact (64 bits hold any 64-bit integer). ld_ofu is the
// value of the unsigned magnitude lxu with sign lxs, [significand, sign and
// exponent]; zero is +0.
ld_ofu(word lxu, word lxs) {
  word[] lqr = [0, 0];
  if(lxu != 0) {
    lqr = ld_ofu2(lxu, lxs);
  }
} return word[] lqr;
