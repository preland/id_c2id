ld_narf(word[] lqa, word lxp, word lxn) {
  ld_fixn(lqa);
  word lxu = lqa[1] - 16383;
  word lxs = 64 - lxp;
} chain (word[] lqa, word lxp, word lxn) {
  if(lxn > lxu) {
    lxs = lxs + lxn - lxu;
  }
  word lxk = ushr(lqa[2], lxs);
  word lxl = ld_jaml(lqa[2], 0, lxs);
} chain (word[] lqa, word lxp, word lxn) {
  word lxq = lxu - 63 + lxs;
  word lxb = ld_asm(lxk + ld_up(lxk, lxl), lxq, lxn);
} return word lxb;
