// Long double to a narrower format, rounded once to nearest even. The result
// is the 64 bits of a binary64: a double's own, or, for a float, the double that
// holds the rounded float (which a float always fits in). lxp is the precision
// of the target in bits (53 or 24) and lxn the exponent of its smallest normal
// (-1022 or -126); its largest is 1 - lxn.
//
// ld_asm builds the bits of kept * 2^q (kept < 2^53, or exactly 2^53 after a
// carry): an infinity above the target's largest, a denormal below -1022.
ld_asm(word lxk, word lxq, word lxn) {
  word lxt = ushr(lxk, 53);
  word lxc = ushr(lxk, lxt);
  word lxy = 64 - ld_clz(lxc);
} chain (word lxk, word lxq, word lxn) {
  word lxx = lxq + lxt + lxy - 1;
  word lxz = ushr((lxc << (64 - lxy)) << 1, 12);
  word lxr = ((lxx + 1023) << 52) | lxz;
} chain (word lxk, word lxq, word lxn) {
  if(lxk == 0 || lxx < 0 - 1022) {
    lxr = lxk;
  }
  if(lxx > 1 - lxn && lxk != 0) {
    lxr = 9218868437227405312;
  }
} return word lxr;
