ld_nar2(word[] lqa, word lxk, word lxp, word lxn) {
  word lxr = (lqa[0] << 63) | 9218868437227405312;
  if(lxk == 0) {
    lxr = lqa[0] << 63;
  }
  if(lxk == 1) {
    lxr = ld_narf(lqa, lxp, lxn) | (lqa[0] << 63);
  }
} chain (word[] lqa, word lxk, word lxp, word lxn) {
  if(lxk >= 3) {
    lxr = ld_nand(lqa, lxp);
  }
  if(lxk == 4) {
    lxr = 0 - 2251799813685248;
  }
} return word lxr;
