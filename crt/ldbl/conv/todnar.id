ld_nar(word lxa, word lxp, word lxn) {
  word[] lqa = ld_get(lxa);
  word lxk = ld_kind(lqa[1], lqa[2]);
  word lxr = ld_nar2(lqa, lxk, lxp, lxn);
} return word lxr;
