// A NaN to the target format: quiet, the top bits of its payload kept (lxp bits
// of precision leave 53 - lxp low bits of the double's fraction clear).
ld_nand(word[] lqa, word lxp) {
  word lxf = ushr(lqa[2], 11) & 4503599627370495;
  word lxm = 0 - (1 << (53 - lxp));
  word lxr = (lqa[0] << 63) | 9218868437227405312 | 2251799813685248 | (lxf & lxm);
} return word lxr;
