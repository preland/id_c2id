// -a: the sign bit flipped, a NaN's too, as the x87's FCHS does.
cld_neg(word lxd, word lxa) {
  word lxs = peek16(lxa + 8) ^ 32768;
  word lxm = peek64(lxa);
  poke64(lxd, lxm);
} chain (word lxd, word lxa) {
  poke64(lxd + 8, lxs);
} return word lxd;
