([0, 5, -9223372036854775808], [0, 5, -9223372036854775808]):(1)
([0, 0, 5], [0, 1, 6]):(0)

ld_scmp(word[] lqa, word[] lqb, word lxka, word lxkb) {
  word lxr = ld_mcmp(lqa, lqb);
  if(lqa[0] == 1) {
    lxr = 2 - lxr;
  }
  if(lqa[0] != lqb[0]) {
    lxr = 2 - 2 * lqa[0];
  }
} chain (word[] lqa, word[] lqb, word lxka, word lxkb) {
  if(lxka == 0 && lxkb == 0) {
    lxr = 1;
  }
} return word lxr;
