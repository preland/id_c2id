// Comparison. ld_mcmp orders two finite or infinite operands by magnitude
// (exponent, a denormal's read as 1, then significand): 0 less, 1 equal, 2
// greater. ld_scmp adds the signs (and makes the two zeros equal), ld_cmp gives
// 3 for an unordered pair (a NaN). cld_cmp answers 0 or 1 for the operator lxo:
// 0 <, 1 <=, 2 >, 3 >=, 4 ==, 5 !=. Its answer is bit (4 * lxo + order) of the
// table 0xD26431, one nibble per operator holding a bit per order (less, equal,
// greater, unordered).
ld_mcmp(word[] lqa, word[] lqb) {
  ld_fixe(lqa);
  ld_fixe(lqb);
  word lxr = (lqa[1] > lqb[1]) + (lqa[1] >= lqb[1]);
} chain (word[] lqa, word[] lqb) {
  if(lqa[1] == lqb[1]) {
    lxr = ult(lqb[2], lqa[2]) + 1 - ult(lqa[2], lqb[2]);
  }
} return word lxr;
