// A quotient with a zero or an infinity in it, lxs being the sign of the
// result: zero over zero and infinity over infinity are the indefinite NaN;
// infinity over a number, and a number over zero, are an infinity; a number
// over infinity, and zero over a number, are zero.
ld_dspec2(word lxs, word lxka, word lxkb) {
  word[] lqr = ld_zero(lxs);
  if(lxka == 2 || lxkb == 0) {
    lqr = ld_inf(lxs);
  }
  if((lxka == 2 && lxkb == 2) || (lxka == 0 && lxkb == 0)) {
    lqr = ld_indef(1);
  }
} return word[] lqr;
(0, 2, 1):([-9223372036854775808, 32767])
(1, 1, 2):([0, 32768])
(0, 2, 2):([-4611686018427387904, 65535])
(0, 1, 0):([-9223372036854775808, 32767])

ld_dspec(word[] lqa, word[] lqb, word lxka, word lxkb) {
  word[] lqr = [];
  if(lxka == 2 || lxkb == 2 || lxka == 0 || lxkb == 0) {
    lqr = ld_dspec2(lqa[0] ^ lqb[0], lxka, lxkb);
  }
} return word[] lqr;
([0, 16383, -9223372036854775808], [0, 16383, -9223372036854775808], 1, 1):([])
([0, 16383, -9223372036854775808], [1, 0, 0], 1, 0):([-9223372036854775808, 65535])

ld_div3(word[] lqa, word[] lqb, word lxka, word lxkb) {
  word[] lqr = ld_dspec(lqa, lqb, lxka, lxkb);
  if(len(lqr) == 0) {
    lqr = ld_dfin(lqa, lqb);
  }
} return word[] lqr;
([0, 16384, -4611686018427387904], [0, 16384, -9223372036854775808], 1, 1):([-4611686018427387904, 16383])
([0, 16383, -9223372036854775808], [0, 0, 0], 1, 0):([-9223372036854775808, 32767])
