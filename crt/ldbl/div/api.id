// a / b for finite non-zero operands: the quotient shifted to the top of a
// 128-bit register, a non-zero remainder kept as its sticky bit, and the
// exponents subtracted; ld_pack normalises a quotient below one.
ld_dfin(word[] lqa, word[] lqb) {
  ld_fixn(lqa);
  ld_fixn(lqb);
  word[] lqs = ld_divq(lqa[2], lqb[2]);
} chain (word[] lqa, word[] lqb) {
  word lxh = ld_shlh(lqs[1], lqs[2], 62);
  word lxo = (lqs[2] << 62) | (lqs[0] != 0);
  word[] lqw = [lqa[0] ^ lqb[0], lqa[1] - lqb[1] + 16383, lxh, lxo];
} chain (word[] lqa, word[] lqb) {
  word[] lqr = ld_pack(lqw);
} return word[] lqr;
