// The 66-bit quotient ma / mb of two normalised significands (an integer bit and
// 65 fraction bits) in lqs[1]:lqs[2], and the remainder in lqs[0].
ld_divq(word lxa, word lxb) {
  word lxg = 1 - ult(lxa, lxb);
  word[] lqs = [lxa - lxg * lxb, 0, lxg];
  ld_dloop(lqs, lxb);
} return word[] lqs;
