ld_mulmid(word lxa, word lxb) {
  word lxm = 4294967295;
  word lxl = ushr((lxa & lxm) * (lxb & lxm), 32);
  word lxs = lxl + (((lxa & lxm) * ushr(lxb, 32)) & lxm) + ((ushr(lxa, 32) * (lxb & lxm)) & lxm);
} return word lxs;
