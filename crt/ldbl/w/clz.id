ld_mulhi2(word lxa, word lxb) {
  word lxm = 4294967295;
  word lxu = ushr(lxb, 32);
  word lxv = ushr(lxa, 32);
} chain (word lxa, word lxb) {
  word lxh = lxv * lxu + ushr((lxa & lxm) * lxu, 32) + ushr(lxv * (lxb & lxm), 32);
} return word lxh;
