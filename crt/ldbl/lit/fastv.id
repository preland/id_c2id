([-4611686018427387904, 16383], -1):([-7378697629483820646, 16380])

ld_fast(word[] lqp) {
  word[] lqr = ld_ofu(lqp[4], 0);
  if(lqp[2] != 0) {
    lqr = ld_fast2(lqr, lqp[2]);
  }
} return word[] lqr;
