ld_fast2(word[] lqr, word lxx) {
  word[] lqa = ld_unp(lqr);
  word lxk = lxx - 2 * lxx * (lxx < 0);
  word[] lqb = ld_unp(ld_p10(lxk));
} chain (word[] lqr, word lxx) {
  word[] lqz = ld_bin2(lqa, lqb, 2 + (lxx < 0));
} return word[] lqz;
