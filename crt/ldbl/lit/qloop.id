ld_qstep(word[] lqr, word[] lqb, word[] lqq) {
  word lxg = bn_cmp(lqr, lqb);
  ld_qsub(lqr, lqb, lxg);
  ld_qput(lqq, lxg >= 1);
} chain (word[] lqr, word[] lqb, word[] lqq) {
  bn_shr1(lqb);
} return void;
([10], [4], [0, 0]):([6], [2], [0, 1])
([3], [4], [0, 0]):([3], [2], [0, 0])

ld_qloop(word[] lqr, word[] lqb, word[] lqq) {
  word lxi = 0;
  while(lxi < 67) {
    ld_qstep(lqr, lqb, lqq);
    lxi = lxi + 1;
  }
} return void;
([5], [0, 0, 12], [0, 0]):([2], [1, 0, 0], [0, 1])
([0], [0, 0, 12], [0, 0]):([0], [1, 0, 0], [0, 0])

ld_qdiv(word[] lqn, word[] lqd, word lxs) {
  word[] lqr = bn_shl(lqn, ld_max0(lxs));
  word[] lqb = bn_shl(lqd, ld_max0(0 - lxs) + 66);
  word[] lqq = [0, 0];
} chain (word[] lqn, word[] lqd, word lxs) {
  ld_qloop(lqr, lqb, lqq);
  push(lqq, 1 - bn_zero(lqr));
} return word[] lqq;
([5], [3], 65):([3, 6148914691236517205, 1])
([3], [1], 65):([6, 0, 0])
