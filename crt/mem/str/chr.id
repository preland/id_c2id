// strchr. `cc` is converted to a byte first, so strchr(s, 0 - 1) looks for
// 0xff exactly as C's (char)c does. Searching for 0 finds the terminator,
// which is also required by C.
c_strchr(word s, int cc) {
  word i = 0;
  word r = 0;
  while(r == 0 && s_more(s, i) != 0) {
    r = chr_hit(s, i, cc);
    i = i + 1;
  }
} return word r;

// A store address is never 0, so the address of a hit doubles as the
// "found" flag.
chr_hit(word s, word i, int cc) {
  word r = 0;
  if(peek8(s + i) == zx8(cc)) {
    r = s + i;
  }
} return word r;
