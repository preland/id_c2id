// "index i is still worth looking at", i.e. the byte before it was not the
// terminator. Shared by strncmp and strchr so that both stop *after* having
// examined the NUL, which is what C requires of each of them.
s_more(word s, word i) {
  int go = 1;
  if(i != 0 && peek8(s + i - 1) == 0) {
    go = 0;
  }
} return int go;
