// strcmp is strncmp with a bound that cannot bite: comparing at most
// strlen(a) + 1 bytes always reaches a's NUL, and the NUL compares unequal
// to whatever b has there.
c_strcmp(word a, word b) {
  word n = c_strlen(a);
  word bound = n + 1;
  word x = c_strncmp(a, b, bound);
} return word x;
