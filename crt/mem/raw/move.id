// memmove: copy in whichever direction does not overwrite source bytes
// before they are read. If the destination is above the source the regions
// may overlap head-to-tail, so copy from the top down; otherwise a plain
// forward copy is safe. This has to be a lazy chain (`if`/`else`) and not
// the cheaper eager one -- running the forward copy unconditionally is
// precisely the bug being avoided.
c_memmove(word dst, word src, word n) {
  word r = dst;
  if(ult(src, dst) != 0) {
    r = mv_back(dst, src, n);
  } else {
    r = c_memcpy(dst, src, n);
  }
} return word r;
