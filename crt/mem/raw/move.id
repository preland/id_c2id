// memcmp over *unsigned* bytes -- peek8 zero-extends, so the comparison is
// unsigned without any extra work. `r` doubles as the early-exit flag,
// since `id` has no `break`.
//
// C promises only the sign of the result. The value returned here is the
// difference of the first differing pair of bytes, which is what glibc
// returns, so the two agree exactly and not merely in sign.
c_memcmp(word a, word b, word n) {
  word i = 0;
  word r = 0;
  while(ult(i, n) != 0 && r == 0) {
    r = cmp_byte(a, b, i);
    i = i + 1;
  }
} return word r;
