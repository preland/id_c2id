// The same byte, one position lower: the descending half of memmove counts
// *down* from n, so it copies the byte at i-1 and returns i-1.
cpy_prev(word dst, word src, word i) {
  word v = peek8(src + i - 1);
  poke8(dst + i - 1, v);
  word r = i - 1;
} return word r;
