// Walk from `h` until a free block is big enough or `stop` is reached; `r` is
// both the answer and the early-exit flag. With stop 0 it is the walk to the
// end of the heap.
fit_from(word h, word need, word stop) {
  word r = 0;
  while(r == 0 && h != stop) {
    r = fit_at(h, need);
    h = walk_next(h);
  }
} return word r;
