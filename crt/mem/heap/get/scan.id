// What find_fit does after the walk from the rover: if it found nothing, try
// the blocks before the rover, then a new island; and leave the rover on what
// was found, so the next search starts there.
fit_wrap(word r, word hrv, word need) {
  if(r == 0) {
    r = fit_from((import crt_heap) + 16, need, hrv);
  }
  if(r == 0) {
    r = grow_heap(need);
  }
  if(r != 0) {
    poke64((import crt_heap), r);
  }
} return word r;
