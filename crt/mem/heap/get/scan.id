// The block physically after `h`, or 0 if `h` ends its island. Coalescing must
// not cross into the next island, which is not next to it in the store.
adj_next(word h) {
  word nx = h + bsize(h);
  word r = nx;
  if(peek64(nx) == 0) {
    r = 0;
  }
} return word r;
