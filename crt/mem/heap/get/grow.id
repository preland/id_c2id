// Lay the island down as one free block, chain the previous last sentinel to
// it, and make it the last. The store hands out zeroed bytes, so the new
// sentinel (size 0, link 0) needs no writing.
grow_isl(word need) {
  word sz = isl_size(need);
  word ibase = alloc(sz + 16);
  word last = peek64((import crt_heap) + 8);
} chain (word need) {
  poke64(last + 8, ibase);
  poke64((import crt_heap) + 8, ibase + sz);
  init_rest(ibase, sz, 0);
} return word ibase;
