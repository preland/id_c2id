// Add an island to the heap: the first block of a new island at least `need`
// bytes long, or 0 when `need` is more than a gigabyte, which no program of
// this size means to ask for.
grow_heap(word need) {
  word r = 0;
  if(need <= 1073741824) {
    r = grow_isl(need);
  }
} return word r;
