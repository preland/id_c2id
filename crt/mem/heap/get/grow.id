// The island's bytes: `need` rounded to 8, and never less than a mebibyte, so
// a heap that grows does so in steps rather than one block at a time.
isl_size(word need) {
  word sz = align8(need);
  if(sz < 1048576) {
    sz = 1048576;
  }
} return word sz;
(32):(1048576)
