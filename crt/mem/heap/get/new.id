// kmalloc: first fit. Returns an 8-byte aligned payload address, or 0 when
// the heap cannot satisfy the request.
kmalloc(word n) {
  word need = blk_need(n);
  word h = find_fit(need);
  word w = alloc_at(h, need);
} return word w;
