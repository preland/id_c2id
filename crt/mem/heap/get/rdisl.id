// The size word of the second island's first block, which is where the island
// grow_heap added begins.
isl1_word() {
  word x = peek64((import crt_heap) + 96);
} return word x;
given crt_heap_grown(32) ():(1048576)
given crt_heap_grown(2097152) ():(2097152)

// A heap that has grown once, by a request of hreq bytes (32 gives the 64-byte island and, after its sentinel, a
// mebibyte island at hnext; more than a mebibyte gives one that large).
crt_heap_grown(int hreq) {
  crt_heap_fixture();
  grow_heap(hreq);
} return void;
