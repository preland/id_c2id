// Hand out block `h`. Split first, because splitting changes the size that
// then gets written back with the in-use bit.
alloc_at(word h, word need) {
  word r = 0;
  if(h != 0) {
    split_blk(h, need);
    bset(h, bsize(h), 1);
    r = h + 16;
  }
} return word r;

// Cut `need` bytes off the front of `h` if what is left over is itself a
// usable block (32 bytes: a 16-byte header and a 16-byte payload). A smaller
// remainder is left attached to the allocation rather than lost.
split_blk(word h, word need) {
  word rest = bsize(h) - need;
  if(rest >= 32) {
    bset(h, need, 0);
    init_rest(h + need, rest, h);
  }
} return void;

re_min(word a, word b) {
  word r = b;
  if(a < b) {
    r = a;
  }
} return word r;
