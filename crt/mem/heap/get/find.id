// Walk the implicit list from the first block until a free block is big
// enough. `r` is both the answer and the early-exit flag.
find_fit(word need) {
  word h = (import crt_heap) + 16;
  word r = 0;
  while(r == 0 && h != 0) {
    r = fit_at(h, need);
    h = walk_next(h);
  }
} return word r;
