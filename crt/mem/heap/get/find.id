// The block after `h` in address order, going on into the next island when `h`
// ends one, or 0 if `h` is the last block there is.
walk_next(word h) {
  word nx = h + bsize(h);
  word r = nx;
  if(peek64(nx) == 0) {
    r = peek64(nx + 8);
  }
} return word r;
