// The size word with the in-use flag masked off. Sizes are multiples of 8,
// so masking the low three bits cannot lose information.
bsize(word h) {
  word x = peek64(h);
  word w = x & ~7;
} return word w;
given crt_heap_fixture ((import h0)):(64)
given crt_heap_fixture2 ((import h0)):(128)

// 1 if the block is handed out, 0 if it is on the free list.
bused(word h) {
  word x = peek64(h);
  word w = x & 1;
} return word w;
given crt_heap_fixture ((import h0)):(0)
given crt_heap_fixture2 ((import h0)):(1)

// Write the size and the flag back as one word.
bset(word h, word sz, word used) {
  poke64(h, sz | used);
} return void;
given crt_heap_fixture ((import h0), 128, 0):() then h0_word:(128)
given crt_heap_fixture ((import h0), 64, 1):() then h0_word:(65)
