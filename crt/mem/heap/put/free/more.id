// A rover standing on the block that was just absorbed would point into the
// middle of its neighbour; move it to the block that now holds it.
rover_fix(word h, word nx) {
  if(peek64((import crt_heap)) == nx) {
    poke64((import crt_heap), h);
  }
} return void;
