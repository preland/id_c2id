// Absorb `nx` (which must be the block immediately after `h`) into `h`, then
// repair the back link of whatever now follows the merged block. The merged
// size is read again for that: the block that follows is `nx`'s successor, not
// `nx`, and a stale link there let a later free merge into a block that no
// longer existed.
merge_blk(word h, word nx) {
  word hz = bsize(h);
  merge_set(h, hz, nx);
  word hy = bsize(h);
} chain (word h, word nx) {
  fix_prev(h + hy, h);
} return void;
