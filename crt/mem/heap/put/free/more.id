// The merged size written and the rover kept on a live block, split out of
// merge_blk so its block stays under the three-action limit.
merge_set(word h, word hz, word nx) {
  word nz = bsize(nx);
  bset(h, hz + nz, 0);
  rover_fix(h, nx);
} return void;
