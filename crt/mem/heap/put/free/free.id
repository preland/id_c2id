// kfree. Like C's free, a null pointer is a no-op.
kfree(word p) {
  if(p != 0) {
    free_at(p - 16);
  }
} return void;

// Mark free, then merge with the next block and with the previous one. Both
// directions matter: merging only forwards leaves the heap fragmented into
// a staircase that never recovers.
free_at(word h) {
  word hz = bsize(h);
  bset(h, hz, 0);
  coal_both(h);
} return void;

// Both directions, in one action. Split out of free_at so its block stays
// under the three-action limit.
coal_both(word h) {
  coal_next(h);
  coal_prev(h);
} return void;
