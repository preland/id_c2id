// The back link is read directly rather than through an accessor: it is the
// only reader, and the heap's function budget is spent elsewhere.
coal_prev(word h) {
  word pv = peek64(h + 8);
  if(pv != 0 && bused(pv) == 0) {
    merge_blk(pv, h);
  }
} return void;
