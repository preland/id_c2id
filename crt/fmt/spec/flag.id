scan_flags(word fmt, word[] st, word[] fs) {
  word c = peek8(fmt + st[0]);
  while(is_flag(c) != 0) {
    take_flag(c, st, fs);
    c = peek8(fmt + st[0]);
  }
} return void;
given crt_fmt_fixture ((import fmtbuf), [0], [0, 0, 0, 0, 0]):((import fmtbuf), [2], [0, 1, 1, 0, 0])
given crt_fmt_fixture ((import fmtbuf), [2], [0, 0, 0, 0, 0]):((import fmtbuf), [2], [0, 0, 0, 0, 0])

// '-' and '0'. C's other flags ('+', ' ', '#') are not implemented; they are
// not recognised here, so they fall through to the conversion character and
// come out echoed literally rather than silently ignored.
is_flag(word c) {
  int go = 0;
  if(c == 45 || c == 48) {
    go = 1;
  }
} return int go;
(45):(1)
(100):(0)

take_flag(word c, word[] st, word[] fs) {
  set_flag(c, fs);
  wset(st, 0, st[0] + 1);
} return void;
(45, [0], [0, 0, 0, 0, 0]):(45, [1], [0, 1, 0, 0, 0])
(48, [0], [0, 0, 0, 0, 0]):(48, [1], [0, 0, 1, 0, 0])
