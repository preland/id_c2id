// A precision: '.', then digits or '*'. No digits after the '.' is a precision
// of 0.
prec_val(word fmt, word[] args, word[] st, word[] fs) {
  word c = peek8(fmt + st[0]);
  if(c == 42) {
    star_prec(args, st, fs);
  } else {
    scan_digits(fmt, st, fs, 9);
  }
} return void;
