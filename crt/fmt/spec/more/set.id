// Unsigned trick: c - 48 wraps to something huge for any byte below '0',
// so one unsigned compare covers both ends of the range.
is_digit(word c) {
  int go = 0;
  if(ult(c - 48, 10) != 0) {
    go = 1;
  }
} return int go;
