// The minimum field width, as decimal digits. A '*' width would need an
// argument and is not supported; it is not a digit, so it ends up echoed.
scan_width(word fmt, word[] st, word[] fs) {
  word c = peek8(fmt + st[0]);
  while(is_digit(c) != 0) {
    take_digit(c, st, fs);
    c = peek8(fmt + st[0]);
  }
} return void;
