take_len(word c, word[] st, word[] fs) {
  word code = len_code(c, fs[4]);
  wset(fs, 4, code);
  wset(st, 0, st[0] + 1);
} return void;

// 'l' and 'z' both mean 64-bit here, so both give 3; 'll' is 'l' twice and
// lands on 3 again.
len_code(word c, word prev) {
  word r = 3;
  if(c == 104) {
    r = hh_code(prev);
  }
} return word r;

// 'h' means 16-bit, but a second 'h' means 8-bit.
hh_code(word prev) {
  word r = 2;
  if(prev == 2) {
    r = 1;
  }
} return word r;
