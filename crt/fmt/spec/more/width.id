// The next argument as the int it is: its low 32 bits, sign-extended.
star_arg(word[] args, word[] st) {
  word sv = next_arg(args, st);
  word sn = narrow_s(sv, 0);
} return word sn;
([7], [0, 0]):(7)
([4294967295], [0, 0]):(-1)

// A negative width is a '-' flag and the positive width.
set_width(word sn, word[] fs) {
  if(sn < 0) {
    wset(fs, 1, 1);
    wset(fs, 3, 0 - sn);
  } else {
    wset(fs, 3, sn);
  }
} return void;
(5, [0, 0, 0, 0, 0]):(5, [0, 0, 0, 5, 0])
(-5, [0, 0, 0, 0, 0]):(-5, [0, 1, 0, 5, 0])
