// Field width and precision. Either is a run of digits, or a '*' that takes the
// next argument (an int) instead; a negative '*' width means '-' and its
// magnitude, and a negative '*' precision means no precision.
//
// The digits of a number, into cell `slot` of fs.
scan_digits(word fmt, word[] st, word[] fs, int slot) {
  word c = peek8(fmt + st[0]);
  while(is_digit(c) != 0) {
    take_digit(c, st, fs, slot);
    c = peek8(fmt + st[0]);
  }
} return void;
given crt_fmt_fixture ((import fmtbuf), [2], [0, 0, 0, 0, 0], 3):((import fmtbuf), [3], [0, 0, 0, 5, 0], 3)
given crt_fmt_fixture ((import fmtbuf), [3], [0, 0, 0, 0, 0], 3):((import fmtbuf), [3], [0, 0, 0, 0, 0], 3)
