narrow_s2(word v, word lm) {
  word res = v;
  if(lm == 1) {
    res = sx8(v);
  } else if(lm == 2) {
    res = sx16(v);
  }
} return word res;

// Radix of an unsigned conversion: 16 for x/X, 8 for o, 10 for u.
base_of(word c) {
  int base = 10;
  if(c == 120 || c == 88) {
    base = 16;
  } else if(c == 111) {
    base = 8;
  }
} return int base;

// Only %X uses upper-case digits.
up_of(word c) {
  int upper = 0;
  if(c == 88) {
    upper = 1;
  }
} return int upper;
