dec_of(word v, word[] fs) {
  word w = narrow_s(v, fs[4]);
  string txt = sdec(w);
} return string txt;
(4294967295, [0, 0, 0, 0, 0]):("-1")
(42, [0, 0, 0, 0, 0]):("42")

// Signed decimal. The negation of the most negative value wraps back to
// itself, and str_of_base reads that as unsigned -- which is exactly the
// right answer, 9223372036854775808.
sdec(word v) {
  string txt = "";
  if(v < 0) {
    txt = "-" + str_of_base(0 - v, 10, 0);
  } else {
    txt = str_of_base(v, 10, 0);
  }
} return string txt;
(42):("42")
(-5):("-5")

// Reduce an argument to the signed value the length modifier describes:
// code 0 is C's default `int`, so a bare %d of a 64-bit word prints the low
// 32 bits, sign-extended, just as C would.
narrow_s(word v, word lm) {
  word res = v;
  if(lm == 0) {
    res = sx32(v);
  } else {
    res = narrow_s2(v, lm);
  }
} return word res;
(4294967295, 0):(-1)
(255, 1):(-1)
