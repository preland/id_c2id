// The unsigned counterpart of narrow_s: truncate, do not sign-extend, so
// %x of -1 as an `int` is ffffffff and not ffffffffffffffff.
narrow_u(word v, word lm) {
  word res = v;
  if(lm == 0) {
    res = zx_bits(v, 32);
  } else {
    res = narrow_u2(v, lm);
  }
} return word res;
(4294967295, 0):(4294967295)
(255, 1):(255)

// Code 3 (l, ll, z) is the whole 64-bit word, so it is the fall-through.
narrow_u2(word v, word lm) {
  word res = v;
  if(lm == 1) {
    res = zx_bits(v, 8);
  } else if(lm == 2) {
    res = zx_bits(v, 16);
  }
} return word res;
(255, 1):(255)
(65535, 2):(65535)
