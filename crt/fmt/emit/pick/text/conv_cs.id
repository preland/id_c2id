// %c. pad_str, not pad_out: the '0' flag does not apply to a character.
conv_cs(word fmt, word c, word[] args, word[] st, word[] fs) {
  string txt = "";
  if(c == 99) {
    word w = next_arg(args, st);
    txt = ch_pad(w, fs);
  } else {
    txt = conv_sp(fmt, c, args, st, fs);
  }
} return string txt;
given crt_fmt_fixture ((import fmtbuf), 99, [65], [0, 0], [0, 0, 0, 0, 0]):("A")
given crt_fmt_fixture ((import fmtbuf), 115, [0], [0, 0], [0, 0, 0, 0, 0]):("(null)")

// %s. The argument is a store address of a NUL-terminated string.
conv_sp(word fmt, word c, word[] args, word[] st, word[] fs) {
  string txt = "";
  if(c == 115) {
    word w = next_arg(args, st);
    string out = str_at(w);
    txt = pad_str(out, fs);
  } else {
    txt = conv_p(fmt, c, args, st, fs);
  }
} return string txt;
given crt_fmt_fixture ((import fmtbuf), 115, [0], [0, 0], [0, 0, 0, 0, 0]):("(null)")
given crt_fmt_fixture ((import fmtbuf), 112, [0], [0, 0], [0, 0, 0, 0, 0]):("(nil)")

// The character, padded. Split out of conv_cs: narrowing the argument, turning
// it into a string and padding it is three actions, and the branch it sits in
// already spent one on reading the argument.
ch_pad(word w, word[] fs) {
  int cc = w;
  string out = ch_of(cc);
  string txt = pad_str(out, fs);
} return string txt;
(65, [0, 0, 0, 0, 0]):("A")
(97, [0, 0, 0, 0, 0]):("a")
