// %e %E %f %F %g %G: the argument is the bits of a double (fmt/flt); anything
// else is echoed verbatim, so a specifier this runtime does not implement shows
// up in the output as a visible gap instead of vanishing.
is_fconv(word c) {
  int fcv = 0;
  if(c == 101 || c == 69 || c == 102 || c == 70 || c == 103 || c == 71) {
    fcv = 1;
  }
} return int fcv;
