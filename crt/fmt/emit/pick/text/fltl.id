conv_fv(word c, word[] args, word[] st, word[] fs) {
  word w = next_arg(args, st);
  int cc = c;
  string txt = "";
} chain (word c, word[] args, word[] st, word[] fs) {
  if(fs[4] == 4) {
    txt = conv_fl(w, cc, args, st, fs);
  } else {
    txt = fl_conv(w, cc, fs);
  }
} return string txt;
