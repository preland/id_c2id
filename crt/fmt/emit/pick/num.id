// Dispatch on the conversion character. A lazy chain, not an eager one:
// every arm that is not taken must *not* consume an argument, so the
// alternative has to sit in an `else`.
//
// "%%" is first because it takes no argument and, per C, ignores the flags
// and the field width entirely.
conv_do(word fmt, word c, word[] args, word[] st, word[] fs) {
  string txt = "";
  if(c == 37) {
    txt = "%";
  } else {
    txt = conv_num(fmt, c, args, st, fs);
  }
} return string txt;
given crt_fmt_fixture ((import fmtbuf), 37, [], [0, 0], [0, 0, 0, 0, 0]):("%")
given crt_fmt_fixture ((import fmtbuf), 100, [42], [0, 0], [0, 0, 0, 0, 0]):("42")

// %d and %i: signed decimal, narrowed to the width the length modifier asks
// for and then sign-extended back.
conv_num(word fmt, word c, word[] args, word[] st, word[] fs) {
  string txt = "";
  if(c == 100 || c == 105) {
    txt = dec_of_padded(0, args, st, fs);
  } else {
    txt = conv_uns(fmt, c, args, st, fs);
  }
} return string txt;
given crt_fmt_fixture ((import fmtbuf), 100, [42], [0, 0], [0, 0, 0, 0, 0]):("42")
given crt_fmt_fixture ((import fmtbuf), 120, [255], [0, 0], [0, 0, 0, 0, 0]):("ff")

// %u, %x, %X and %o: one unsigned value, three radices, two digit cases.
conv_uns(word fmt, word c, word[] args, word[] st, word[] fs) {
  string txt = "";
  if(c == 117 || c == 120 || c == 88 || c == 111) {
    txt = uns_of_padded(0, c, args, st, fs);
  } else {
    txt = conv_cs(fmt, c, args, st, fs);
  }
} return string txt;
given crt_fmt_fixture ((import fmtbuf), 120, [255], [0, 0], [0, 0, 0, 0, 0]):("ff")
given crt_fmt_fixture ((import fmtbuf), 99, [65], [0, 0], [0, 0, 0, 0, 0]):("A")
