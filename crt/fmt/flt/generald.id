// %g of the digits ds (first digit weight 10^ffx0) at precision ffp0.
fg_text(string ds, int ffx0, int ffp0, int fec, int fea) {
  int fgp = fg_prec(ffp0);
  string fer = rd_round(ds, fgp);
  string fgt = fg_fin(fer, ffx0, fgp, fec, fea);
} return string fgt;
("123456789", 0, 6, 103, 0):("1.23457")
("100", 2, 6, 103, 0):("100")
("1", 6, 6, 103, 0):("1e+06")
("12345", -5, 6, 103, 0):("1.2345e-05")
("0", 0, 6, 103, 0):("0")
("999999", 5, 6, 103, 0):("999999")
("9999995", 5, 6, 103, 0):("1e+06")
