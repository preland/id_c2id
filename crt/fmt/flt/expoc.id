fe_exp(int fex, int fec) {
  string fel = fe_letter(fec);
  string fen = fe_sign(fex);
  string fet = fe_tail(fex, fel, fen);
} return string fet;
(5, 101):("e+05")
(-12, 69):("E-12")
(100, 101):("e+100")

fe_fin(string fer, int fex, int ffp, int fec, int fea) {
  string fes = str_slice(fer, 0, ffp + 1);
  string fem = fe_mant(fes, ffp, fea);
  string fet = fem + fe_exp(fex, fec);
} return string fet;
("1234567", 3, 6, 101, 0):("1.234567e+03")
("12", -2, 1, 69, 0):("1.2E-02")

// %e of the digits ds (first digit weight 10^ffx0) with ffp places after the point.
fe_text(string ds, int ffx0, int ffp, int fec, int fea) {
  string fer = rd_round(ds, ffp + 1);
  int fex = ffx0 + len(fer) - ffp - 1;
  string fet = fe_fin(fer, fex, ffp, fec, fea);
} return string fet;
("123456789", 0, 2, 101, 0):("1.23e+00")
("9999", 3, 1, 101, 0):("1.0e+04")
("5", -5, 0, 101, 1):("5.e-05")
