// %f %F %e %E %g %G: the argument is the bits of a double.
fl_conv(word flb, int flc, word[] fs) {
  int fln = flb < 0;
  string fle = fl_sign(fln, fs);
  string flo = fl_pad(flb, flc, fle, fs);
} return string flo;
