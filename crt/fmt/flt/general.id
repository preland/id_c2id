// %g: P significant digits (a precision of 0 means 1), written as %f when the
// exponent X of the rounded value is at least -4 and below P, else as %e, and
// without the zeros that end the fraction unless the # flag is given.
fg_prec(int ffp0) {
  int fgp = ffp0;
  if(ffp0 == 0) {
    fgp = 1;
  }
} return int fgp;
(0):(1)
(6):(6)

fg_frac(string rds, int fgx, int fea) {
  string fgf = fx_fp(rds, fgx);
  if(fea == 0) {
    fgf = rd_strip(fgf, 0);
  }
} return string fgf;
("123457", 0, 0):("23457")
("100000", 2, 0):("")
("100000", 2, 1):("000")

fg_dot(string fgf, int fea) {
  string fgd = "";
  if(len(fgf) > 0 || fea > 0) {
    fgd = ".";
  }
} return string fgd;
("23", 0):(".")
("", 0):("")
("", 1):(".")
