// Rounding a digit string to a number of digits, the way printf does: to nearest,
// and a tie (the dropped digits are exactly 5 followed by zeros) to the even
// digit. The digits are a double's exact ones (fmt/dec), so a tie is a real tie
// and 0.125 prints as 0.12 under %.2f while 0.375 prints as 0.38.
//
// Digit rdi of the string, 0 outside it.
rd_dig(string rds, int rdi) {
  int rdd = 0;
  if(rdi >= 0 && rdi < len(rds)) {
    rdd = character_code_at(rds, rdi) - 48;
  }
} return int rdd;
("123", 1):(2)
("123", 5):(0)

// 1 when any digit from index rdg on is not 0.
rd_rest(string rds, int rdg) {
  int rdk = 0;
  int rdi = rdg;
  while(rdi < len(rds)) {
    if(rd_dig(rds, rdi) != 0) {
      rdk = 1;
    }
    rdi = rdi + 1;
  }
} return int rdk;
("1005", 1):(1)
("1000", 1):(0)

// Whether a dropped first digit rdd rounds up, given rdw: more than 0 when the
// digits after it are not all zero or the last kept digit is odd.
rd_up2(int rdd, int rdw) {
  int rdu = 0;
  if(rdd > 5) {
    rdu = 1;
  }
  if(rdd == 5 && rdw > 0) {
    rdu = 1;
  }
} return int rdu;
(6, 0):(1)
(5, 0):(0)
(5, 1):(1)
(4, 3):(0)
