// A stream is the number rt/libc/io.id gives it: 1 stdout, 2 stderr, 3 stdin.
// Text for stderr goes to eprint, everything else to stdout.
rt_emit(word f, string txt) {
  if(f == 2) {
    eprint(txt);
  } else {
    put(txt);
  }
} return void;

c_fprintf(word f, word fmt, word[] args) {
  string txt = c_format(fmt, args);
  rt_emit(f, txt);
  int plen = len(txt);
} return word plen;

c_fputs(word s, word f) {
  word n = c_strlen(s);
  string txt = str_of_mem(s, n);
  rt_emit(f, txt);
} return word n;
