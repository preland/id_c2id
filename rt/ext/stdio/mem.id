// printf into memory: the formatted text and its terminating NUL are stored at
// buf, and the length of the text is answered.
c_sprintf(word buf, word fmt, word[] args) {
  string txt = c_format(fmt, args);
  int plen = len(txt);
  str_blit(txt, 0, plen, buf);
} chain (word buf, word fmt, word[] args) {
  poke8(buf + plen, 0);
} return word plen;

// As sprintf but at most n - 1 characters and the NUL, so a long text is cut; the
// answer is still the length the whole text would have had, as C's is.
c_snprintf(word buf, word n, word fmt, word[] args) {
  string txt = c_format(fmt, args);
  int plen = len(txt);
  word most = re_min(plen, n - 1);
} chain (word buf, word n, word fmt, word[] args) {
  int keep = most;
  str_blit(txt, 0, keep, buf);
  poke8(buf + keep, 0);
} return word plen;
