// time and clock over idstd's clocks: the wall clock in whole seconds (stored
// through the pointer too, unless it is NULL), and the processor time in
// microseconds, which is what CLOCKS_PER_SEC of 1000000 makes clock() count in.
c_time(word rtp) {
  word rns = clock_nanoseconds((import clock_real));
  word rsec = clock_secs_of(rns);
  rt_stamp(rtp, rsec);
} return word rsec;

rt_stamp(word rtp, word rsec) {
  if(rtp != 0) {
    poke64(rtp, rsec);
  }
} return void;

c_clock() {
  word rns = clock_nanoseconds((import clock_cpu));
  word rus = rns / 1000;
} return word rus;
