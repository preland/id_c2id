c___builtin_parity(word pcv) {
  word pcn = rt_popc(pcv, 32) & 1;
} return word pcn;

c___builtin_parityll(word pcv) {
  word pch = ushr(pcv, 32);
  word pcn = (c___builtin_parity(pcv) + c___builtin_parity(pch)) & 1;
} return word pcn;
