// The digits themselves: each one below the base is taken into the value.
rt_acc(word rs, word[] rst) {
  word rch = peek8(rs + rst[0]);
  word rd = rt_dv(rch);
  while(rd < rst[1]) {
    rt_step(rst, rd);
    rch = peek8(rs + rst[0]);
    rd = rt_dv(rch);
  }
} return void;

rt_step(word[] rst, word rd) {
  word_list_set(rst, 3, rst[3] * rst[1] + rd);
  word_list_set(rst, 4, rst[4] + 1);
  word_list_set(rst, 0, rst[0] + 1);
} return void;
