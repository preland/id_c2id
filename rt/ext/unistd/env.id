// getenv over idstd's environment: the value as a NUL-terminated copy in the
// store, or NULL for a variable that is not set (an empty one answers "").
c_getenv(word renm) {
  word rn = c_strlen(renm);
  string rtxt = str_of_mem(renm, rn);
  int rhas = environment_has(rtxt);
} chain (word renm) {
  word rres = rt_envval(rhas, rtxt);
} return word rres;

rt_envval(int rhas, string rtxt) {
  word rres = 0;
  if(rhas == 1) {
    string rval = environment_text(rtxt);
    rres = mem_of_str(rval);
  }
} return word rres;
