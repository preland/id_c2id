c_log2(word a) {
  float cmx = float_of_bits(a);
  float cmz = flt_log2(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

c_log10(word a) {
  float cmx = float_of_bits(a);
  float cmz = flt_log10(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

c_floor(word a) {
  float cmx = float_of_bits(a);
  float cmz = flt_floor(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

