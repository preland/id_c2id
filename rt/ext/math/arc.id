c_asin(word a) {
  float cmx = float_of_bits(a);
  float cmz = flt_asin(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

c_acos(word a) {
  float cmx = float_of_bits(a);
  float cmz = flt_acos(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

c_atan(word a) {
  float cmx = float_of_bits(a);
  float cmz = flt_atan(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

