c_exp(word a) {
  float cmx = float_of_bits(a);
  float cmz = float_exponential(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

c_exp2(word a) {
  float cmx = float_of_bits(a);
  float cmz = float_exponential_base_two(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

c_log(word a) {
  float cmx = float_of_bits(a);
  float cmz = float_log(cmx);
  word cmr = bits_of_float(cmz);
} return word cmr;

