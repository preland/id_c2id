// The rest of ctype over the ASCII range: printable (space included), graphic
// (printable but not space), control, and punctuation (graphic but not alnum).
c_isprint(word cv) {
  word r = c_ctype_in(cv, 32, 126);
} return word r;
(32):(1)
(127):(0)

c_isgraph(word cv) {
  word r = c_isprint(cv);
  if(cv == 32) {
    r = 0;
  }
} return word r;
(33):(1)
(32):(0)

c_iscntrl(word cv) {
  word r = 0;
  if(cv >= 0 && cv <= 31 || cv == 127) {
    r = 1;
  }
} return word r;
(127):(1)
(65):(0)
