// ctype over the ASCII range, answering 1 or 0 as C does (any non-zero is true,
// and these answer exactly 1). The argument is an unsigned char value or EOF.
c_isdigit(word cv) {
  word r = 0;
  if(cv >= 48 && cv <= 57) {
    r = 1;
  }
} return word r;
(48):(1)
(58):(0)

c_isupper(word cv) {
  word lw = c_tolower(cv);
  word r = 0;
  if(lw != cv) {
    r = 1;
  }
} return word r;
(65):(1)
(97):(0)

c_islower(word cv) {
  word up = c_toupper(cv);
  word r = 0;
  if(up != cv) {
    r = 1;
  }
} return word r;
(97):(1)
(65):(0)
