// One step of the format: a conversion, white space, or a character to match.
rt_one(word rstr, word rfmt, word[] rargs, word[] rst) {
  word rch = peek8(rfmt + rst[1]);
  if(rch == 37) {
    rt_conv(rstr, rfmt, rargs, rst);
  } else {
    rt_one2(rstr, rch, rst);
  }
} return void;

// White space in the format matches any amount of it in the input.
rt_lws(word rstr, word[] rst) {
  wset(rst, 1, rst[1] + 1);
  word rch = peek8(rstr + rst[0]);
  while(c_isspace(rch) == 1) {
    wset(rst, 0, rst[0] + 1);
    rch = peek8(rstr + rst[0]);
  }
} return void;

// Any other format character must be the next input byte.
rt_lch(word rstr, word rch, word[] rst) {
  word rin = peek8(rstr + rst[0]);
  if(rin == rch) {
    wset(rst, 0, rst[0] + 1);
    wset(rst, 1, rst[1] + 1);
  } else {
    rt_stop(rst, rin);
  }
} return void;
