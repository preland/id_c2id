// The allocator. These two lines are NOT compared against C: C's malloc is not
// this allocator and the addresses it hands back are unspecified. What is
// compared is the invariant, printed as 1 or 0 -- two live blocks of 64 bytes
// do not overlap, and a freed block of the same size comes straight back --
// which holds for crt by construction and for any sane malloc as well.

t_mem() {
  word p = kmalloc(64);
  word q = kmalloc(64);
  t_mem2(p, q);
} return void;
given prog_heap_fixture ():() then prints:("apart 1\nreused 1\n")
given prog_heap_fixture ():() then calls t_mem2:[1]

t_mem2(word p, word q) {
  word apart = q - p;
  t_ok("apart", apart);
  t_mem3(p, q);
} return void;
given t_mem2_fixture ((import tm_p), (import tm_q)):() then prints:("apart 1\nreused 1\n")
given t_mem2_fixture ((import tm_p), (import tm_q)):() then calls t_ok:[1] then calls t_mem3:[1]

t_mem3(word p, word q) {
  kfree(p);
  word r = kmalloc(64);
  t_same("reused", r, p);
} return void;
given t_mem2_fixture ((import tm_p), (import tm_q)):() then prints:("reused 1\n")
given t_mem2_fixture ((import tm_p), (import tm_q)):() then calls kfree:[1] then calls t_same:[1]
