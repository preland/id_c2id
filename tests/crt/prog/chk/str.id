t_str2(word a, word b) {
  word n = c_strlen(a);
  t_say("len", n);
  t_str3(a, b);
} return void;
given prog_heap_fixture given t_str2_fixture ((import ts_a), (import ts_b)):() then prints:("len 5\ncmp -1\nmemset 65\n")
given prog_heap_fixture given t_str2_fixture ((import ts_a), (import ts_b)):() then calls c_strlen:[2] then calls c_strcmp:[1]

// strcmp answers the difference of the first differing byte: 'o' - 'p'.
t_str3(word a, word b) {
  word c = c_strcmp(a, b);
  t_say("cmp", c);
  t_memset();
} return void;
given prog_heap_fixture given t_str2_fixture ((import ts_a), (import ts_b)):() then prints:("cmp -1\nmemset 65\n")
