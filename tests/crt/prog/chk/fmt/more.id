// The argument list of the width test, and the length modifiers.

t_fmt_b2(word ad, word ad2) {
  word[] args = [(import wzero) + 42, 42, 42, ad2, 65];
  c_printk(ad, args);
} return void;
given t_fmt_b2_fixture ((import fmtb_ad), (import fmtb_ad2)):() then prints:("[   42][42   ][00042][   hi][A]\n")
given t_fmt_b2_fixture given t_fmt_b2_alt_fixture ((import fmtb_ad), (import fmtb_ad2c)):() then prints:("[   42][42   ][00042][   yo][A]\n")

// hh and h truncate their argument; l does not, and a literal '%' comes
// through as one.
t_fmt_c() {
  word ad = t_cs("hh=%hhd h=%hd l=%ld pct=%%\n");
  word[] args = [(import wzero) + 300, 70000, 0 - 1];
  c_printk(ad, args);
} return void;
():() then prints:("hh=44 h=4464 l=-1 pct=%\n")
():() then calls c_printk:[1]

// A specifier crt does not implement is echoed rather than dropped, so it
// shows in the output as a visible gap. Not compared against C: what glibc
// does with an unknown conversion is unspecified, and this is crt's own
// promise rather than C's.
t_fmt_unk() {
  word ad = t_cs("unk=%q\n");
  word[] args = [(import wzero)];
  c_printk(ad, args);
} return void;
():() then prints:("unk=%q\n")
():() then calls c_printk:[1]
