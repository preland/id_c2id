disp_hi(word fp, word pc) {
  word nxt = 0 - 1;
  if(pc == 3) {
    nxt = blk3(fp);
  } else {
    nxt = blk4(fp);
  }
} return word nxt;

// the `for` step: i++
blk3(word fp) {
  word t0 = peek32(fp + 24);
  poke32(fp + 24, t0 + 1);
} return word 1;

// return t
blk4(word fp) {
  word t0 = peek32(fp + 16);
  poke64(fp, t0);
  word nxt = 0 - 1;
} return word nxt;
