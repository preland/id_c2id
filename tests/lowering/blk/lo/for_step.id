// the `for` condition: i <= n
blk1(word fp) {
  word nxt = 4;
  if(peek32(fp + 24) <= peek32(fp + 8)) {
    nxt = 2;
  }
} return word nxt;
given lo_frame_fixture ((import lfp)):(4)
given lo_after_blk0_fixture ((import lfp)):(2)

// t = t + i
blk2(word fp) {
  word t0 = peek32(fp + 16);
  word t1 = peek32(fp + 24);
  poke32(fp + 16, t0 + t1);
} return word 3;
given lo_frame_fixture ((import lfp)):(3) then lo_read_t:(18001)
given lo_after_blk0_fixture ((import lfp)):(3) then lo_read_t:(1)

// A read-back witness for lowering's block functions: the local `i` (fp+24)
// after whatever block just ran, since blk1's dispatch and blk3's own return
// value never surface it directly.
lo_read_i() {
  word x = peek32((import lfp) + 24);
} return word x;
given lo_frame_fixture ():(9001)
given lo_after_blk0_fixture ():(1)
