st_str(int id) {
  string s = "(" + k_of(id) + kids_str(id) + ")";
} return string s;

kids_str(int id) {
  string s = " " + s_of(id) + " a" + a_of(id);
  string txt = lists_str(id);
  s = s + txt;
} return string s;

print_tree(int n, int id) {
  string s = st_str(id);
  print("" + n + ": " + s);
} return void;
