// Stress: parse a whole sequence of statements, reporting how far it gets.
go() {
  string src = read_all();
  lex_all(src);
  drain([0], 0);
} return void;

drain(int[] pos, int n) {
  while(cur_kind(pos) != "eof") {
    n = one_more(pos, n);
  }
} return void;

one_more(int[] pos, int n) {
  int id = parse_stmt(pos);
  print_tree(n, id);
  n = n + 1;
} return int n;
