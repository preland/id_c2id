// Integration: the real lexer feeding the real statement parser. boot_a is the
// node store, the diagnostics and the type table the parser reads, exactly as
// c2id's own main sets them up; the lexer's tables are the harness's own.
main(int argc, string[] argv) {
  boot_a();
  boot_b();
  boot();
} return int 0;
stdin "5;\n" (0, []):(0) then prints:("0: (expr  a6)\n")
(1, ["x"]):(0) then calls boot_a:[1] then calls boot_b:[1] then calls boot:[1]

boot() {
  init_lex();
  go();
} return void;
given harn_setup_fixture stdin "5;\n" ():() then prints:("0: (expr  a6)\n")
():() then calls init_lex:[1] then calls go:[1]

init_lex() {
  init_tokens();
  init_lines();
} return void;
