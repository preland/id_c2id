given boot_a (4294967295):() then (import cunk)[0]:(0)
given boot_a (-2147483648):() then (import cunk)[0]:(0)

// Whether a constant is not zero, for `__builtin_choose_expr`: its condition may
// be any width, and cut to an int `1ULL << 40` would be false.
const_true(int e) {
  word ct_w = cw_eval(e);
  int ct_n = ct_w != 0;
} return int ct_n;
