// What const_eval hands its callers is an int, so a value outside what an int or
// an unsigned int holds would be cut to something else without a word. It is
// refused instead, as any constant the folder cannot evaluate is (cunk).
cw_wide(word wd_w) {
  if(wd_w < 0 - 2147483648 || wd_w > 4294967295) {
    lset((import cunk), 0, 1);
  }
} return void;
