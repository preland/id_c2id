given boot_a ("<=", 3, 9, 3, 9):(1)
given boot_a (">", 3, 9, 3, 9):(0)
given boot_a ("&&", 2, 9, 0, 9):(0)
given boot_a ("||", 2, 9, 0, 9):(1)

cw_less(word ls_a, word ls_b, int ls_t) {
