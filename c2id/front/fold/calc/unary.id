cv_un(int e) {
  int av = const_eval((import na)[e]);
  int v = cv_unop((import ns)[e], av);
} return int v;
given boot_a given exprfix stdin "!5;" ((import extop)):(0)
given boot_a given exprfix stdin "~0;" ((import extop)):(-1)

// `-x`, `~x`, `!x`; `+x` and anything else is x.
cv_unop(string op, int av) {
  int v = cv_not(op, av);
  if(op == "-") {
    v = 0 - av;
  } else if(op == "~") {
    v = ~av;
  }
} return int v;
("-", 5):(-5)
("~", 5):(-6)
("!", 0):(1)
("+", 7):(7)

cv_not(string op, int av) {
  int v = av;
  if(op == "!") {
    v = av == 0;
  }
} return int v;
("!", 0):(1)
("!", 9):(0)
("-", 9):(9)
