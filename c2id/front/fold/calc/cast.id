cw_cnv(word cn_a, int cn_c, int cn_n) {
  word cn_v = cw_norm(cn_a, cn_c);
  if((import ns)[cn_n] == "_Bool") {
    cn_v = cn_a != 0;
  }
} return word cn_v;
