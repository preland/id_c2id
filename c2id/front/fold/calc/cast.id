cw_ctype(int ct_n, int ct_t) {
  int ct_r = ct_t;
  if((import nk)[ct_n] == "prim") {
    ct_r = (import na)[ct_n] * 2 + (import nb)[ct_n];
  } else if((import nk)[ct_n] == "ptr") {
    ct_r = 16;
  }
} return int ct_r;
