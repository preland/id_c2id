// A cast converts to the size and signedness of a primitive type (a _Bool to
// whether it is nonzero) or to an unsigned 8-byte pointer; to any other type
// it leaves the value alone, and the type it had.
cw_cast(int e) {
  word cs_a = cw_eval((import na)[e]);
  int cs_t = (import cwty)[0];
  int cs_n = (import nb)[e];
} chain (int e) {
  int cs_c = cw_ctype(cs_n, cs_t);
  word cs_v = cw_cnv(cs_a, cs_c, cs_n);
  integer_list_set((import cwty), 0, cs_c);
} return word cs_v;
