cw_c2(string c2_o, word c2_a, word c2_b, int c2_t) {
  word c2_v = cw_c3(c2_o, c2_a, c2_b, c2_t);
  if(c2_o == "+") {
    c2_v = c2_a + c2_b;
  } else if(c2_o == "-") {
    c2_v = c2_a - c2_b;
  }
} return word c2_v;
