cw_cand(word cf_w, int cf_t, int cf_d, int cf_u, int cf_l) {
  int cf_bad = (cf_l == 1 && cf_t / 2 < 8) + (cf_u == 1 && cf_t % 2 == 1) + (cf_d == 1 && cf_u == 0 && cf_t == 8);
  int cf_ok = cw_fits(cf_w, cf_t);
  if(cf_bad > 0) {
    cf_ok = 0;
  }
} return int cf_ok;
