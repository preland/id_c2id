cw_fits(word ft_w, int ft_t) {
  word ft_n = cw_norm(ft_w, ft_t);
  int ft_ok = 0;
  if(ft_t == 16 || (ft_w >= 0 && ft_n == ft_w)) {
    ft_ok = 1;
  }
} return int ft_ok;
