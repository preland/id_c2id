cw_isint(string ii_s) {
  int ii_ok = 0;
  if(len(ii_s) > 0 && is_float_lit(ii_s) == 0 && charat(ii_s, 0) >= 48 && charat(ii_s, 0) <= 57) {
    ii_ok = 1;
  }
} return int ii_ok;
