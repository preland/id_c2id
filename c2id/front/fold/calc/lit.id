// An integer literal as the 64-bit word it spells, with the type C gives it.
// The parser's own cell is an int and has cut a wide literal, but the spelling is
// kept in ns, so it is decoded again here. A character constant or an enumerator
// is spelled `#` and its code (const_spell), an int; a floating literal is 0.
cw_num(int e) {
  string cn_s = (import ns)[e];
  word cn_v = (import na)[e];
  lset((import cwty), 0, 9);
} chain (int e) {
  if(cw_isint(cn_s) == 1) {
    cn_v = cw_lit(cn_s);
  }
} return word cn_v;
