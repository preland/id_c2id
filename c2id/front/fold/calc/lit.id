cw_lit(string lt_s) {
  int lt_r = cw_radix(lt_s);
  int lt_i = cw_start(lt_s, lt_r);
  word lt_v = cw_digits(lt_s, lt_i, lt_r);
} chain (string lt_s) {
  int lt_t = cw_lty(lt_v, lt_s, lt_r);
  lset((import cwty), 0, lt_t);
} return word lt_v;
