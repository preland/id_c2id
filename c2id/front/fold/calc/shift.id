given boot_a (">>", 256, 17, 4):(16) then (import cwty)[0]:(17)

cw_shop(string so_o, word so_l, word so_c, int so_t) {
  word so_v = so_l << so_c;
  if(so_o == ">>") {
    so_v = cw_shr(so_l, so_c, so_t);
  }
  so_v = cw_norm(so_v, so_t);
} return word so_v;
