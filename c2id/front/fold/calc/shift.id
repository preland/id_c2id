// A shift keeps the (promoted) type of its left operand and ignores the type of
// its count. A negative count is 0 (C leaves it undefined, id traps); a count
// past the width is id's own definition (0, or -1 for a negative signed value).
// Right shift fills with the sign for a signed type and with zeros for an
// unsigned one, which on the canonical form is ushr.
cw_shift(string sh_o, word sh_l, int sh_lt, word sh_r) {
  int sh_t = cw_prom(sh_lt);
  word sh_c = cw_cnt(sh_r);
  word sh_v = cw_shop(sh_o, sh_l, sh_c, sh_t);
} chain (string sh_o, word sh_l, int sh_lt, word sh_r) {
  lset((import cwty), 0, sh_t);
} return word sh_v;
