// Constant expressions -- array bounds, bitfield widths, enumerator values, case
// ranges -- are ordinary C expressions that happen to be constant. They are
// parsed by the expression parser (parse_cond) and folded here over the AST, so
// everything the parser accepts folds: casts, `!`, comparisons, `&&`, `?:`,
// sizeof. (They used to be evaluated as they were read by a grammar of two
// precedence levels, which looped without end on `1/(int)(!!(14 > 2))`.)
//
// The fold follows C's types, not id's int: every node is evaluated as a 64-bit
// word held in the canonical form of its C type (calc/norm.id), and the type
// of the value just computed is left in cwty[0] (calc/ty.id), so that `-1 < 0u`,
// `(unsigned char)300`, `~0UL >> 60` and `1ULL << 63` fold as the C compiler
// folds them. const_eval narrows the word to the int its callers store, and a
// value an int or unsigned int cannot hold is refused (cw_wide) rather than cut.
const_eval(int e) {
  word ce_w = cw_eval(e);
  int ce_n = ce_w;
  cw_wide(ce_w);
} return int ce_n;
given boot_a given exprfix stdin "7;" ((import extop)):(7)
given boot_a given exprfix stdin "1 + 2 * 3;" ((import extop)):(7)
given boot_a given exprfix stdin "1 | 1 << 3;" ((import extop)):(9)
given boot_a given exprfix stdin "(unsigned char)300;" ((import extop)):(44)
given boot_a given exprfix stdin "(short)70000;" ((import extop)):(4464)
given boot_a given exprfix stdin "-1 < 0u;" ((import extop)):(0)
given boot_a given exprfix stdin "(unsigned)-1 > 0;" ((import extop)):(1)
given boot_a given exprfix stdin "(char)200;" ((import extop)):(-56)
given boot_a given exprfix stdin "0x7fffffffffffffffLL / 3 > 0x7fffffff;" ((import extop)):(1)
given boot_a given exprfix stdin "1ULL << 40;" ((import extop)):(0) then (import cunk)[0]:(1)

cw_eval(int e) {
  word cw_v = 0;
  if((import nk)[e] == "num") {
    cw_v = cw_num(e);
  } else {
    cw_v = cw_ev2(e);
  }
} return word cw_v;
given boot_a given exprfix stdin "7;" ((import extop)):(7) then (import cwty)[0]:(9)
given boot_a given exprfix stdin "18446744073709551615ULL;" ((import extop)):(-1) then (import cwty)[0]:(16)
given boot_a given exprfix stdin "0x7fffffffffffffffLL / 3;" ((import extop)):(3074457345618258602) then (import cwty)[0]:(17)
given boot_a given exprfix stdin "(unsigned long long)-1 >> 1;" ((import extop)):(9223372036854775807) then (import cwty)[0]:(16)
given boot_a given exprfix stdin "1ULL << 63;" ((import extop)):(-9223372036854775808) then (import cwty)[0]:(16)
given boot_a given exprfix stdin "~0u;" ((import extop)):(4294967295) then (import cwty)[0]:(8)

cw_ev2(int e) {
  word e2_v = 0;
  if((import nk)[e] == "bin") {
    e2_v = cw_bin(e);
  } else {
    e2_v = cw_ev3(e);
  }
} return word e2_v;
