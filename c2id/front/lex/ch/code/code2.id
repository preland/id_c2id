// The two classes that make an exponent part.

// `e` `E` `p` `P` -- the letters that may introduce a signed exponent inside
// a preprocessing number (`p`/`P` for hexadecimal floats).
is_exp(int c) {
  int ok = 0;
  if(c == 101 || c == 69 || c == 112 || c == 80) {
    ok = 1;
  }
} return int ok;
(112):(1)
(113):(0)

// `+` and `-`.
is_expsign(int c) {
  int ok = 0;
  if(c == 43 || c == 45) {
    ok = 1;
  }
} return int ok;
(43):(1)
(44):(0)
