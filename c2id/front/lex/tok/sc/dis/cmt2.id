// `//` or `/*`. The default (a line comment, ending at the LF, which the
// whitespace path then counts) is the safe one and has no side effects, so
// the eager form is fine here.
scan_cmt(word base, int i) {
  int ni = eol_pos(base, i);
  if(peek8(base + i + 1) == 42) {
    ni = cmt_end(base, i + 2);
  }
} return int ni;
