// Kind `num`, text = the exact spelling: prefix, digits, dot, exponent and
// suffix, unconverted.
scan_num(word base, int i) {
  int ne = num_end(base, i);
  string s = slice(base, i, ne);
  add_tok("num", s);
} return int ne;
