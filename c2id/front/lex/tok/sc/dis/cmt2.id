// Comments (both forms) and numbers -- the two scanners that produce either
// nothing at all or exactly one token.

// The interior of a block comment: `i` is the index just past `/*`.
cmt_end(word base, int i) {
  while(peek8(base + i) != (import ch_eof) && cmt_more(base, i)) {
    i = adv_nl(base, i);
  }
  int r = cmt_stop(base, i);
} return int r;
