// `/` followed by `/` (47) or `*` (42).
scan_word(word base, int i) {
  int ni = 0;
  if(peek8(base + i) == 47 && (peek8(base + i + 1) == 47 || peek8(base + i + 1) == 42)) {
    ni = scan_cmt(base, i);
  } else {
    ni = scan_numop(base, i);
  }
} return int ni;
