// Identifiers -- and the one place where an identifier turns out not to be
// one, because it was the `L` / `u` / `U` / `u8` prefix of a literal.
//
// Keywords are NOT separated out: the parser decides by text, so `int` and
// `while` arrive as ordinary `id` tokens.

scan_ident(word base, int i) {
  int e = ident_end(base, i);
  int r = ident_pick(base, i, e);
} return int r;
