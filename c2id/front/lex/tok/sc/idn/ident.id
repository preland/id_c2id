// `__extension__` only silences a pedantic warning; it is dropped here so that
// no later stage sees it between a `typedef`, a declaration or an expression
// and what follows.
emit_ident(word base, int i, int e) {
  string s = slice(base, i, e);
  if(s != "__extension__") {
    add_tok("id", s);
  }
} return int e;
