// A bitfield is laid out (place_bf keeps the width) but every access reads and
// writes the whole declared type, so a program that uses one would run and be
// wrong; the declaration is refused at the width it names.
bit_refuse(int[] pos, string name, int w) {
  if(w >= 0) {
    diag_tok(pos[0] - 1, "bitfield member '" + name + "' (width " + w + ") is not supported: accesses would ignore the width");
  }
} return void;
given boot_a given lexfix stdin "# 4 \"s.c\"\nint x : 3 ;" ([3], "x", 3):() then (import dgmsg):(["s.c:4: error: bitfield member 'x' (width 3) is not supported: accesses would ignore the width"])
given boot_a given lexfix stdin "int x ;" ([3], "x", -1):() then len((import dgmsg)):(0)
given boot_a given lexfix stdin "int : 0 ;" ([3], "", 0):() then len((import dgmsg)):(1)
