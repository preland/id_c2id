// A bit-field is read and written through the shift and mask its position in the
// storage unit gives (back/emit/gen/txt/ex/a/bf/), so what is refused is what
// that cannot be right for: one wider than its own type. A bit-field of enum
// type is unsigned unless an enumerator is negative, as gcc has it, because the
// type of the enum is (parse/ty/dcl/e/more/). One of a 128-bit type is not
// refused where written: its unit is 16 bytes and the loads and stores read 8 at
// most, so it poisons the record that holds it (defer_tok, segment 1) and a reached function
// that uses the record is refused.
bit_check(int[] pos, string name, int w, int r) {
  if(w > 8 * type_size(r)) {
    diag_tok(pos[0] - 1, "bitfield member '" + name + "' has width " + w + ", wider than its type");
  }
  if(w >= 0 && type_size(r) == 16) {
    defer_tok(pos[0] - 1, "bitfield member '" + name + "' has a 128-bit integer type, which c2id cannot read or write through a bit-field unit of 8 bytes at most", 1);
  }
} return void;
given tynode_fix given ty_setup given lexfix stdin "# 4 \"s.c\"\nint x : 40 ;" ([3], "x", 40, 0):() then (import dgmsg):(["s.c:4: error: bitfield member 'x' has width 40, wider than its type"])
given tynode_fix given ty_setup given lexfix stdin "int x : 3 ;" ([3], "x", 3, 0):() then len((import dgmsg)):(0)
given txt_fixture given wd_make given lexfix stdin "__int128 x : 3 ;" ([3], "x", 3, 6):() then len((import pdsg)):(1)
given txt_fixture given wd_make given lexfix stdin "int x : 3 ;" ([3], "x", 3, 0):() then len((import pdsg)):(0)
given txt_fixture given wd_make given lexfix stdin "__int128 x ;" ([3], "x", -1, 6):() then len((import pdsg)):(0)
