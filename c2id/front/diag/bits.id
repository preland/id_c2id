// A bit-field is read and written through the shift and mask its position in the
// storage unit gives (back/emit/gen/txt/ex/a/bf/), so what is refused is what
// that cannot be right for: one wider than its own type, and one declared with an
// enum type, whose signedness gcc picks from the enumerators and the parser,
// which turns an enum into int, no longer knows.
bit_check(int[] pos, string name, int w, int r) {
  if(w > 8 * type_size(r)) {
    diag_tok(pos[0] - 1, "bitfield member '" + name + "' has width " + w + ", wider than its type");
  }
  if(w >= 0 && (import bfenum)[0] == 1) {
    diag_tok(pos[0] - 1, "bitfield member '" + name + "' has an enum type: gcc takes it as signed or unsigned by what its enumerators are, which c2id does not keep; declare it 'int' or 'unsigned int'");
  }
} return void;
given tynode_fix given ty_setup given lexfix stdin "# 4 \"s.c\"\nint x : 40 ;" ([3], "x", 40, 0):() then (import dgmsg):(["s.c:4: error: bitfield member 'x' has width 40, wider than its type"])
given tynode_fix given ty_setup given lexfix stdin "int x : 3 ;" ([3], "x", 3, 0):() then len((import dgmsg)):(0)
given tynode_fix given ty_setup given lexfix given lset((import bfenum), 0, 1) stdin "# 4 \"s.c\"\nint x : 3 ;" ([3], "x", 3, 0):() then len((import dgmsg)):(1)
