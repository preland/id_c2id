// A struct or union parameter, named by its position.
fn_par_refuse(int tk, string name, int r) {
  int[] ps = (import nl)[r];
  int i = 0;
  while((import nk)[r] == "fn" && i < len(ps)) {
    int pty = ps[i];
    fn_par_one(tk, name, pty, i);
    i = i + 1;
  }
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "struct P { int x; }; int f(int a, struct P p);" (0, "f", 10):() then len((import dgmsg)):(1)
given boot_a given boot_b given lexfix given tu_load stdin "int f(int a, int b);" (0, "f", 9):() then len((import dgmsg)):(0)
given boot_a given boot_b given lexfix given tu_load stdin "struct Q { int a; }; struct P { struct Q q; };" (0, "P", 8):() then len((import dgmsg)):(0)

fn_par_one(int tk, string name, int pty, int i) {
  if((import nk)[pty] == "rec") {
    diag_tok(tk, "function '" + name + "' takes parameter " + (i + 1) + " as a struct or union by value, which is not supported: the callee's writes would reach the caller's object; pass a pointer");
  }
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "# 2 \"q.c\"\nstruct P { int x; }; int f(int a, struct P p);" (0, "f", 6, 1):() then (import dgmsg):(["q.c:2: error: function 'f' takes parameter 2 as a struct or union by value, which is not supported: the callee's writes would reach the caller's object; pass a pointer"])
given boot_a given boot_b given lexfix given tu_load stdin "struct P { int x; }; int f(int a, struct P p);" (0, "f", 8, 0):() then len((import dgmsg)):(0)
