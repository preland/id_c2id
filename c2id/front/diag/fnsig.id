// What a function definition's type may not be. A variadic definition has no
// translation (va_start and va_arg need the caller's argument list, which a
// frame of fixed 8-byte slots does not keep), so it is refused (by the check
// pass, so only when the program reaches the function) at the end of its
// parameter list. A struct or union passed or returned by value is supported:
// docs/EMITTER.md, "Struct values".

// `int f(int n, ...)`: the fn node's nb is 1 when its parameter list ended in `...`.
fn_va_refuse(int tk, string name, int r) {
  if((import nk)[r] == "fn" && (import nb)[r] == 1) {
    diag_tok(tk, "function '" + name + "' is defined with '...': variadic definitions (va_start, va_arg) are not supported");
  }
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "# 5 \"v.c\"\nint f(int n, ...);" (0, "f", 8):() then (import dgmsg):(["v.c:5: error: function 'f' is defined with '...': variadic definitions (va_start, va_arg) are not supported"])
given boot_a given boot_b given lexfix given tu_load stdin "int f(int a, int b);" (0, "f", 9):() then len((import dgmsg)):(0)
