// Whether a call node may exit: it names a function on mxnames, or goes through
// a pointer, or names nothing the program declares. The closure over the program
// (mx_close) is made of this.
mx_call(int id) {
  int hit = call_listed(id, (import mxnames));
  if(hit == 0) {
    hit = call_ind(id);
  }
} return int hit;
