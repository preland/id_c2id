// A call through a pointer can reach any function, including one that exits, so
// it counts as a call that may exit. A call is direct when its callee is the
// name of a function the program declares or defines; any other callee -- a
// variable, a member, a table element, or a name never declared -- is not known
// to be one.
call_ind(int id) {
  int ind = 0;
  if((import nk)[id] == "call") {
    ind = callee_ind((import na)[id]);
  }
} return int ind;
given noret_init given boot_a given boot_b given lexfix given tu_load given mx_fixture stdin "void g(void); void f(void) { g(); }" ((import mxc)):(0)
given noret_init given boot_a given boot_b given lexfix given tu_load given mx_fixture stdin "void f(void) { p(); }" ((import mxc)):(1)

callee_ind(int a) {
  int ind = 1;
  if(a >= 0 && (import nk)[a] == "var") {
    int known = decl_fn((import ns)[a], 0);
    ind = 1 - known;
  }
} return int ind;
