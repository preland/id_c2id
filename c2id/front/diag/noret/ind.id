// A call through a pointer can reach any function, including one that exits, so
// it counts as a call that may exit. A call is direct when its callee is the
// name of a function the program declares or defines; any other callee -- a
// variable, a member, a table element, or a name never declared -- is not known
// to be one.
call_ind(int id) {
  int ind = 0;
  if((import nk)[id] == "call") {
    ind = callee_ind((import na)[id]);
  }
} return int ind;
