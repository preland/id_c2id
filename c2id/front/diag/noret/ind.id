// Whether a name is a declared function. A name never declared at all takes
// dflt: 0 for a callee that must be known, 1 for C's implicit declaration, which
// is how a call to an undeclared function means anything.
decl_fn(string name, int dflt) {
  int i = find_str((import dnames), name);
  int ok = dflt;
  if(i >= 0) {
    ok = (import nk)[(import dtys)[i]] == "fn";
  }
} return int ok;
