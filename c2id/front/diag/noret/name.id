noret_open_of(int tk) {
  int i = tk;
  int depth = 1;
  while(depth > 0 && i > 0) {
    i = i - 1;
    string nrt = (import ttext)[i];
    depth = depth - bracket_delta(nrt, "(", ")");
  }
} return int i;
