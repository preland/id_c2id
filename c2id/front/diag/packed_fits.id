// Whether a `packed` at token tk, in the attribute starting at ast, leaves the
// layout as it is. Only the word packed is asked about: any other attribute in
// the list (vector_size, mode) answers 0.
packed_fits(int tk, int ast) {
  int ok = 0;
  string pw = (import ttext)[tk];
  if(pw == "packed" || pw == "__packed__") {
    ok = packed_body(ast);
  }
} return int ok;
given boot_a given boot_b given lexfix stdin "union { int a; } __attribute__((packed)) u;" (9, 6):(1)
given boot_a given boot_b given lexfix stdin "struct { int a; char b; } __attribute__((packed)) u;" (12, 9):(0)
given boot_a given boot_b given lexfix stdin "struct { int a; } __attribute__((vector_size(8))) u;" (9, 6):(0)

// What the attribute at ast is attached to: the group just before it
// (`} __attribute__...`) or the one after the keyword (`struct __attribute__...`).
packed_body(int ast) {
  int ok = 0;
  if(tok_before(ast) == "}") {
    ok = packed_group(brace_open(ast - 1), ast - 1);
  } else if(find_str((import kw_su), tok_before(ast)) >= 0) {
    ok = packed_ahead(ast);
  }
} return int ok;
given boot_a given boot_b given lexfix stdin "union { int a; char b; } __attribute__((packed)) u;" (9):(1)
given boot_a given boot_b given lexfix stdin "struct { int a; char b; } __attribute__((packed)) u;" (9):(0)

// A union is never changed by it; a struct is when it has more than one member.
packed_group(int open, int close) {
  int ok = brace_semis(open, close) <= 1;
  if(brace_union(open) == 1) {
    ok = 1;
  }
} return int ok;
given boot_a given boot_b given lexfix stdin "union U { int a; char b; } x;" (2, 9):(1)
given boot_a given boot_b given lexfix stdin "struct S { int a; char b; } x;" (2, 9):(0)
