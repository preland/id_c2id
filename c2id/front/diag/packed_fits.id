// What the attribute at ast is attached to: the group just before it
// (`} __attribute__...`) or the one after the keyword (`struct __attribute__...`).
packed_body(int ast) {
  int ok = 0;
  if(tok_before(ast) == "}") {
    ok = brace_tag(brace_open(ast - 1));
  } else if(find_str((import kw_sue), tok_before(ast)) >= 0) {
    ok = packed_ahead(ast);
  }
} return int ok;
