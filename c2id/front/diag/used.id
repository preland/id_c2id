// An attribute list holding `used` keeps the function or variable it is on whatever
// its linkage, so a unit with no main starts from it as from an external one (a
// kernel initcall is `static ... __attribute__((used)) = fn`). usedk is cleared when
// each external declaration begins (item_reset); once set, statk stays 0.
used_scan(int[] pos, int ast) {
  int us_hit = attr_find(ast, pos[0], (import used_attr));
  if(us_hit >= 0) {
    lset((import usedk), 0, 1);
    lset((import statk), 0, 0);
  }
} return void;
