// The template is the strings before the first `:`; each later `:` opens the
// next section (outputs, inputs, clobbers, labels). A string opening with `=`
// in the outputs is a register or memory the asm fills.
asm_body(int[] asmst, string kind, string txt) {
  if(txt == ":") {
    asm_next(asmst);
  }
  if(kind == "str") {
    asm_str(asmst, txt);
  }
} return void;
([1, 0, 0], "op", ":"):([2, 0, 0])
([1, 0, 0], "str", "\"nop\""):([1, 1, 0])

asm_next(int[] asmst) {
  int zone = asmst[0] + 1;
  lset(asmst, 0, zone);
} return void;
([1, 0, 0]):([2, 0, 0])
([2, 1, 0]):([3, 1, 0])

asm_str(int[] asmst, string txt) {
  if(asmst[0] == 1 && txt != "\"\"") {
    lset(asmst, 1, 1);
  }
  if(asmst[0] == 2 && character_code_at(txt, 1) == 61 && asmst[2] == 0) {
    lset(asmst, 2, 2);
  }
} return void;
([1, 0, 0], "\"nop\""):([1, 1, 0])
([2, 0, 0], "\"=r\""):([2, 0, 2])
([2, 0, 0], "\"+r\""):([2, 0, 0])
([3, 0, 0], "\"=r\""):([3, 0, 0])
