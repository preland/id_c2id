
// Discarding a GCC attribute. `__attribute__((packed))` is four tokens of
// parentheses; `__attribute__((section(".text"), aligned(64)))` nests. Both
// are handled by consuming the first `(` and then skipping to its match.

skip_attrs(int[] pos) {
  while(attrs_more(pos)) {
    skip_attr(pos);
  }
} return void;
given lexfix stdin "x" ([0]):([0])
given boot_a given boot_b given lexfix stdin "__attribute__(x)" ([0]):([4])

skip_attr(int[] pos) {
  int ast = pos[0];
  skip_head(pos);
  skip_paren(pos);
} chain (int[] pos) {
  packed_scan(pos, ast);
  reg_scan(pos, ast);
  used_scan(pos, ast);
} return void;
given boot_a given boot_b given lexfix stdin "y z" ([0]):([1])
given boot_a given boot_b given lexfix stdin "y(x)" ([0]):([4])

skip_paren(int[] pos) {
  if(at_text(pos, "(")) {
    advance(pos);
    skip_bal(pos);
  }
} return void;
given lexfix stdin "x" ([0]):([0])
given lexfix stdin "(x)" ([0]):([3])
