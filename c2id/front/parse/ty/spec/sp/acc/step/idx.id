spec_basic_idx(int[] pos) {
  string kw = spec_norm(pos);
  int i = find_str((import spec_words), kw);
  if(i < 0) {
    i = wide_idx(kw);
  }
} return int i;
given lexfix stdin "int" ([0]):(3)
given lexfix stdin "__signed__" ([0]):(7)
given lexfix stdin "__int128" ([0]):(4)

spec_norm(int[] pos) {
  string txt = cur_text(pos);
  string kw = norm_kw(txt);
} return string kw;
given lexfix stdin "__signed__" ([0]):("signed")
given lexfix stdin "int" ([0]):("int")
