is_tof_kw(string s) {
  int ok = 0;
  if(s == "typeof" || s == "__typeof__" || s == "__typeof" || s == "typeof_unqual" || s == "__typeof_unqual__" || s == "__auto_type") {
    ok = 1;
  }
} return int ok;
