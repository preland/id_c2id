
// A lone `void` parameter means "no parameters" and is dropped. Array and
// function parameter types decay to pointers, as C says they do, so a
// caller comparing argument types never has to special-case them.

param_push(int[] ps, int inner) {
  int r = decay(inner);
  if(is_void(r) == 0) {
    push(ps, r);
    push((import pnq), (import dname)[0]);
  }
} return void;
