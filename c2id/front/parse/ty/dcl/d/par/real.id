
// One parameter, or the `...` of a variadic list (which contributes no type).

param_body(int[] pos, int[] ps) {
  int ok = param_dots(pos);
  if(ok == 0) {
    param_real(pos, ps);
  }
  skip_tok(pos, ",");
} return void;
given boot_a given ty_setup given lexfix stdin "int x ," ([0], []):([3], [0])
given boot_a given ty_setup given lexfix stdin "... ," ([0], []):([2], [])

param_dots(int[] pos) {
  int ok = take_tok(pos, "...");
  if(ok == 1) {
    lset((import dots), 0, 1);
  }
} return int ok;
given boot_a given lexfix stdin "..." ([0]):(1) then (import dots)[0]:(1)
given boot_a given lexfix stdin "x" ([0]):(0) then (import dots)[0]:(0)

param_real(int[] pos, int[] ps) {
  int inner = parse_specs(pos);
  int r = parse_declarator(pos, inner);
  param_push(ps, r);
} return void;
given boot_a given ty_setup given lexfix stdin "int x" ([0], []):([2], [0])
given boot_a given ty_setup given lexfix stdin "void" ([0], []):([1], [])
