pack_zero(int[] pz_pos, int pz_ty, int pz_w) {
  if(pz_w == 0 && (import nt)[pz_ty] == "packed") {
    diag_tok(pz_pos[0] - 1, "a zero-width bit-field in a packed record: where gcc puts the next member is not modelled");
  }
} return void;
