// What a packed record changes about where its members go: a member aligns to
// one byte, and a bit-field starts at the very next bit, even across the edge of
// the unit of its declared type (the access then reads the bytes it spans,
// back/emit/gen/txt/ex/a/bf/mark.id).
mem_align(int ma_ty, int ma_r) {
  int ma_al = 1;
  if((import nt)[ma_ty] != "packed") {
    ma_al = mem_pk_align(ma_r);
  }
} return int ma_al;
