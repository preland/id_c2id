// The record's alignment once its body is read: `aligned(N)` raises it to N, and
// a packed record has N, or 1 without one, whatever its members align to. The
// size then rounds up to it (rec_size_a).
rec_aln(int ry_ty, int[] ry_lay, int ry_cl) {
  int ry_open = brace_open(ry_cl);
  int ry_a = attr_pre_start(ry_open);
  int ry_z = attr_run_end(ry_cl + 1);
} chain (int ry_ty, int[] ry_lay, int ry_cl) {
  int ry_g = attr_pair(ry_a, ry_open, ry_cl + 1, ry_z, (import aligned_attr));
  int ry_n = attr_value(ry_g);
  rec_lay(ry_ty, ry_lay, ry_n, ry_open);
} return void;
given tynode_fix given ty_setup given lexfix stdin "{ int a ; } __attribute__ ( ( aligned ( 32 ) ) ) ;" (5, [32, 4, 4], 4):(5, [32, 4, 32])
given tynode_fix given ty_setup given lexfix stdin "{ int a ; } ;" (5, [32, 4, 4], 4):(5, [32, 4, 4])

rec_lay(int rl_ty, int[] rl_lay, int rl_n, int rl_tk) {
  if((import nt)[rl_ty] == "packed") {
    rec_lay_pk(rl_lay, rl_n, rl_tk);
  } else if(rl_n > rl_lay[2]) {
    lset(rl_lay, 2, rl_n);
  }
} return void;
