// A member declaration, or a `_Static_assert(...);` between members, which
// declares nothing.
member_one(int[] pos, int ty, int[] lay) {
  if(at_sassert(pos)) {
    skip_sassert(pos);
  } else {
    member_decl(pos, ty, lay);
  }
} return void;
given tynode_fix given ty_setup given lexfix stdin "_Static_assert ( 1 , \"m\" ) ;" ([0], 1, [0, 0, 1]):([7], 1, [0, 0, 1])
given tynode_fix given ty_setup given lexfix stdin "int x ;" ([0], 1, [0, 0, 1]):([3], 1, [32, 4, 4]) then calls member_decl:([3], 1, [32, 4, 4])
