// Whether the specifiers of the member declaration just read, the tokens from mst
// up to the cursor, name an enum: the parser makes an enum an int, so this is
// the only place that is known, and bit_check reads it.
enum_note(int[] pos, int mst) {
  int hit = 0;
  int i = mst;
  while(i < pos[0]) {
    hit = enum_tok(i, hit);
    i = i + 1;
  }
} chain (int[] pos, int mst) {
  lset((import bfenum), 0, hit);
} return void;
given boot_a given ty_setup given lexfix stdin "enum E { A } e ;" ([6], 0):() then (import bfenum):([1])
given boot_a given ty_setup given lexfix stdin "int e ;" ([2], 0):() then (import bfenum):([0])

enum_tok(int i, int hit) {
  int enh = hit;
  if((import ttext)[i] == "enum") {
    enh = 1;
  }
} return int enh;
given boot_a given lexfix stdin "enum E" (0, 0):(1)
given boot_a given lexfix stdin "enum E" (1, 0):(0)
