given boot_a given ty_setup given en_add("a", 3) given en_add("b", 5) (1):(5)

enum_max(int ex_n0) {
  int ex_hi = (import ecvals)[ex_n0];
  int ex_i = ex_n0;
  while(ex_i < len((import ecvals))) {
