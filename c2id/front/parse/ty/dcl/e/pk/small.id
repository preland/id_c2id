// The type of a packed enum whose enumerators are the ones after the first n0 in
// the constant table: the smallest of char, short, int and long that holds them
// all, unsigned when none is negative.
enum_small(int es_n0) {
  int es_lo = enum_min(es_n0);
  int es_hi = enum_max(es_n0);
  int es_w = enum_bytes(es_lo, es_hi);
} chain (int es_n0) {
  int es_ty = enum_prim(es_w, es_lo);
} return int es_ty;
given boot_a given ty_setup given en_add("a", 3) given en_add("b", 200) (0):(0) then calls enum_prim:(1, 3)
given boot_a given ty_setup given en_add("a", -3) given en_add("b", 200) (0):(0) then calls enum_prim:(2, -3)

enum_min(int em_n0) {
  int em_lo = (import ecvals)[em_n0];
  int em_i = em_n0;
  while(em_i < len((import ecvals))) {
    em_lo = fx_min(em_lo, (import ecvals)[em_i]);
    em_i = em_i + 1;
  }
} return int em_lo;
