
// Multiplicative folding, and unary minus.

ce_mstep(int[] pos, int v) {
  string s = cur_text(pos);
  advance(pos);
  int r = ce_mstep2(pos, s, v);
} return int r;
given lexfix stdin "* 3" ([0], 2):(6)
given lexfix stdin "/ 4" ([0], 20):(5)

ce_at_m(string s) {
  int ok = 0;
  if(s == "*" || s == "/" || s == "%") {
    ok = 1;
  }
} return int ok;
  ("*"):(1)
  ("+"):(0)

ce_un(int[] pos) {
  int v = 0;
  if(at_text(pos, "-")) {
    v = ce_neg(pos);
  } else {
    v = ce_prim(pos);
  }
} return int v;
given lexfix stdin "- 5" ([0]):(-5)
given lexfix stdin "5" ([0]):(5)
