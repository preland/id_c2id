
// Constant expressions: array bounds, bitfield widths, enumerator values.
// This is not the full C expression grammar -- that lives in parse/code/ex/ --
// only what a *type* can contain, evaluated to an integer as it is parsed.
//
// Two precedence levels: multiplicative binds tighter than everything else.
// `+ - << >> | & ^` share one left-associative level, so `1 << 3 | 1` is 9
// but `1 | 1 << 3` is 8 rather than C's 9. Mixing those two families in one
// unparenthesised array bound does not happen in practice.

ce_expr(int[] pos) {
  lset((import cunk), 0, 0);
  int e = parse_cond(pos);
  int r = const_eval(e);
} chain (int[] pos) {
  ce_chk(pos);
} return int r;
given boot_a given lexfix stdin "2 + 3" ([0]):(5)
given boot_a given lexfix stdin "2 * 3 + 1" ([0]):(7)
given boot_a given boot_b given lexfix stdin "n + 1" ([0]):(1) then len((import dgmsg)):(1)
given boot_a given boot_b given lexfix stdin "2 + 3" ([0]):(5) then len((import dgmsg)):(0)

ce_eloop(int[] pos, int v) {
  while(at_in(pos, (import ce_add_ops))) {
    v = ce_estep(pos, v);
  }
} return int v;
given boot_a given lexfix stdin "+ 3" ([0], 2):(5)
given boot_a given lexfix stdin ")" ([0], 7):(7)

