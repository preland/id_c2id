// The newest entry named `name`, or -1: a name declared in an inner block hides
// the same name outside it.
find_last(string[] names, string name) {
  int i = len(names) - 1;
  while(i >= 0 && names[i] != name) {
    i = i - 1;
  }
} return int i;
(["a", "b", "a"], "a"):(2)
(["a", "b"], "z"):(-1)
