
// The rest of the exports, and the one linear search every table uses.
// Three exports is a whole block's action budget, which is why the init
// chain is four functions long.

ty_init3() {
  export int[] sybit = [];
  export int[] sywid = [];
  ty_init4();
} return void;
given ty_setup given sy_col2(16, 2, 4) ():() then len((import sybit)):(0)
given ty_setup given sy_col2(19, 3, 8) ():() then len((import sywid)):(0)
():() then calls ty_init4:[1]
given ty_setup ():() then calls ty_init4:[1]

ty_init4() {
  export int[] syids = [];
  export string[] ecnames = [];
  export int[] ecvals = [];
} chain () {
  export string[] pnq = [];
  export int[] scmk = [];
  export string[] pnj = [""];
} return void;
given ty_setup given en_add("a", 3) ():() then len((import ecnames)):(0)
given ty_setup given sy_col1("x", 0, 16) ():() then len((import syids)):(0)
():() then prints:("")
given ty_setup ():() then prints:("")

// index of `name` in `names`, or -1. The `found < 0` guard is how a loop
// stops early in a language with no `break`.
find_str(string[] names, string name) {
  int i = 0;
  int found = 0 - 1;
  while(i < len(names) && found < 0) {
    found = str_hit(names, name, i);
    i = i + 1;
  }
} return int found;
(["a", "b", "c"], "b"):(1)
(["a", "b", "c"], "z"):(-1)
