
// _Alignof. An array aligns like its element; a record carries its own
// alignment in nm[0]; a scalar aligns to its width, which is true of every
// type on x86-64 that the kernel uses.

type_align(int ty) {
  int n = 1;
  if((import nk)[ty] == "arr") {
    int a = (import na)[ty];
    n = type_align(a);
  } else {
    n = talign2(ty);
  }
} return int n;
given tynode_fix (3):(4)
given tynode_fix (5):(24)

talign2(int ty) {
  int n = talign3(ty);
  if((import nk)[ty] == "rec") {
    n = (import nm)[ty][0];
  }
} return int n;
given tynode_fix (0):(4)
given tynode_fix (5):(24)

talign3(int ty) {
  int n = 8;
  if((import nk)[ty] == "prim") {
    int a = (import na)[ty];
    n = if_below(a, 1, 1);
  }
} return int n;
given tynode_fix (0):(4)
given tynode_fix (2):(8)
