// An identifier in an expression: a variable, unless it names an enumerator,
// which is a constant and is folded here -- there is nothing for the emitter to
// look up, and an enumerator has no storage to load it from.
var_or_enum(string name) {
  int id = 0;
  if(has_enum(name) == 1) {
    id = enum_num(name);
  } else {
    id = newleaf("var", 0, 0, name, "");
  }
} return int id;
given boot_a given boot_b given lexfix given tu_load stdin "enum E { A = 5, B };" ("A"):(8) then calls newleaf:("num", 5, 0, "#5", "")
given boot_a given boot_b given lexfix given tu_load stdin "enum E { A = 5, B };" ("zz"):(8) then calls newleaf:("var", 0, 0, "zz", "")

enum_num(string name) {
  int v = enum_val(name);
  int id = newleaf("num", v, 0, "#" + v, "");
} return int id;
given boot_a given boot_b given lexfix given tu_load stdin "enum E { A = 5, B };" ("B"):(8) then calls newleaf:("num", 6, 0, "#6", "")
given boot_a given boot_b given lexfix given tu_load stdin "enum E { A = 5, B };" ("A"):(8) then (import ns)[8]:("#5")
