// Decoding a constant's spelling, the parenthesised primary, and the error
// leaf.

const_val(string kind, string s) {
  int n = chr_val(unquote(s));
  if(kind == "num") {
    n = to_num(s);
  }
} return int n;
("num", "42"):(42)
("chr", "a"):(97)

prim_paren(int[] pos) {
  advance(pos);
  int node = paren_expr(pos);
} return int node;
given boot_a given lexfix stdin "(1);" ([0]):(0)
given boot_a given lexfix stdin "(0);" ([0]):(0)

// Nothing here can start an expression. Report it and stop reading the unit:
// the cursor moves to the end, so no caller can spin on it, and a zero comes
// back so the callers above still return.
prim_bad(int[] pos) {
  string msg = "expression expected, found '" + cur_text(pos) + "'";
  diag_halt(pos, msg);
  int id = bad_advance(pos);
} return int id;
given boot_a given lexfix stdin "# 4 \"e.c\"\n;" ([0]):(0) then (import dgmsg):(["e.c:4: error: expression expected, found ';'"])
given boot_a given lexfix stdin "+" ([0]):(0) then len((import dgmsg)):(1)
