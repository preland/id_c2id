// Whether two type nodes are the same type: one node, or the same kind of type
// built the same way. Two records are the same only when they are one node, which
// a struct tag always is.
types_same(int a, int b) {
  int ok = 0;
  if(a == b) {
    ok = 1;
  } else if((import nk)[a] == (import nk)[b]) {
    ok = types_kind(a, b);
  }
} return int ok;
given tynode_fix (0, 0):(1)
given tynode_fix (0, 2):(0)

types_kind(int a, int b) {
  string kn = (import nk)[a];
  int ok = types_deep(a, b, kn);
  if(kn == "prim") {
    ok = (import ns)[a] == (import ns)[b];
  }
} return int ok;
given tynode_fix (0, 0):(1)
given tynode_fix (2, 2):(1)

types_deep(int a, int b, string kn) {
  int ok = 0;
  if(kn == "ptr" || kn == "arr") {
    ok = types_elem(a, b);
  } else if(kn == "fn") {
    ok = types_fn(a, b);
  }
} return int ok;
given tynode_fix (2, 2, "ptr"):(1)
given tynode_fix (4, 4, "fn"):(1)
