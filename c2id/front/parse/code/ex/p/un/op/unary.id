// unary-expression:
//     postfix-expression
//   | ('!' | '~' | '+' | '-' | '*' | '&') cast-expression
//   | ('++' | '--') unary-expression
//   | 'sizeof' unary-expression
//   | 'sizeof' '(' type-name ')'
//
// Three lazy dispatch links, one decision each: prefix operator, prefix
// increment, sizeof, else postfix.

parse_unary(int[] pos) {
  int node = 0;
  if(at_in(pos, (import unops))) {
    node = unary_op(pos);
  } else {
    node = parse_unary2(pos);
  }
} return int node;
given boot_a given lexfix stdin "!x;" ([0]):(1) then calls unary_op:[1]
given boot_a given lexfix stdin "x;" ([0]):(0) then calls parse_unary2:[1]

// Operand is a cast-expression, so `-(int)x` and `*(char *)p` parse.
unary_op(int[] pos) {
  string op = cur_text(pos);
  advance(pos);
  int id = unary_node(pos, op);
} return int id;
given boot_a given lexfix stdin "!x;" ([0]):(1)
given boot_a given lexfix stdin "-y;" ([0]):(1)
