// Conditionals, sizeof, and how a type node is referred to.

cond_str(int id) {
  int[] l = (import nl)[id];
  int a = (import na)[id];
  string s = cond_str2(id, a, l);
} return string s;
given boot_a given exprfix stdin "1 ? 2 : 3;" ((import extop)):("(1 ? 2 : 3)")
given boot_a given exprfix stdin "a ? b : c;" ((import extop)):("(a ? b : c)")

// `nb` is the type node for `sizeof(T)` and 0 for `sizeof expr`.
sizeof_str(int id) {
  int a = (import na)[id];
  string s = "sizeof(" + expr_str(a) + ")";
  if((import nb)[id] != 0) {
    int b = (import nb)[id];
    s = "sizeof(" + "t" + b + ")";
  }
} return string s;
given boot_a given exprfix stdin "sizeof x;" ((import extop)):("sizeof(x)")
given boot_a given ty_setup given exprfix stdin "sizeof(int);" ((import extop)):("sizeof(?prim)")
