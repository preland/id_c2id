// expr_str -- a fully parenthesised printer for an expression tree. It is how
// the parser is tested (parenthesisation *is* the parse) and what the emitter
// prints in diagnostics.
//
// The dispatch is an eager chain: each link asks the next one first and then
// overrides if the kind is its own. That costs two kinds per three-action
// block instead of one, and is safe here because printing a node has no side
// effects -- a parser could not be written this way.

expr_str(int id) {
  string s = es2(id);
  if((import nk)[id] == "num") {
    s = num_str(id);
  }
  if((import nk)[id] == "bin" || (import nk)[id] == "assign") {
    s = bin_str(id);
  }
} return string s;
given boot_a given exprfix stdin "42;" ((import extop)):("42") then calls num_str:[1]
given boot_a given exprfix stdin "x;" ((import extop)):("x") then calls es2:[1]

es2(int id) {
  string s = es3(id);
  if((import nk)[id] == "var") {
    s = (import ns)[id];
  }
  if((import nk)[id] == "str") {
    s = "\"" + (import ns)[id] + "\"";
  }
} return string s;
given boot_a given exprfix stdin "x;" ((import extop)):("x")
given boot_a given exprfix stdin "y;" ((import extop)):("y")

es3(int id) {
  string s = es4(id);
  if((import nk)[id] == "un") {
    int a = (import na)[id];
    s = "(" + (import ns)[id] + expr_str(a) + ")";
  }
  if((import nk)[id] == "post") {
    int b = (import na)[id];
    s = "(" + expr_str(b) + (import ns)[id] + ")";
  }
} return string s;
given boot_a given exprfix stdin "-x;" ((import extop)):("(-x)")
given boot_a given exprfix stdin "x++;" ((import extop)):("(x++)")
