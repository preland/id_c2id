// An `asm` statement is not an expression or a declaration: asm_why says
// whether skipping it is sound, and the statement becomes an empty block.
parse_stmt_asm(int[] pos) {
  int id = 0;
  if(list_string_index((import asm_words), cur_text(pos)) >= 0) {
    id = parse_asm(pos);
  } else {
    id = parse_stmt_sa(pos);
  }
} return int id;
given boot_a given boot_b given lexfix stdin "asm(\"\");" ([0]):(6) then calls parse_asm:[1]
given boot_a given ty_setup given lexfix stdin "42;" ([0]):(1) then calls parse_expr_stmt:[1]

parse_asm(int[] pos) {
  int tk = pos[0];
  skip_attr(pos);
  string why = asm_why(tk, pos[0]);
} chain (int[] pos) {
  skip_tok(pos, ";");
  int id = asm_node(why, tk);
} return int id;
given boot_a given boot_b given lexfix stdin "asm(\"\");" ([0]):(6) then len((import dgmsg)):(0)
given boot_a given boot_b given lexfix stdin "asm(\"nop\");" ([0]):(6) then (import ns)[6]:("inline asm has an instruction c2id cannot translate: the program would run and be wrong")

parse_stmt_sa(int[] pos) {
  int id = 0;
  if(at_sassert(pos)) {
    id = parse_sassert(pos);
  } else {
    id = parse_stmt15(pos);
  }
} return int id;
given boot_a given lexfix stdin "_Static_assert ( 1 , \"m\" ) ;" ([0]):(0) then calls parse_sassert:[1]
