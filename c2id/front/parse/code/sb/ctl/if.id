// `if (cond) stmt [else stmt]`. Split across three functions because reading
// it takes six steps and a block gets three: the accumulated state is threaded
// forward and the last link's return clause builds the node, which is free.

parse_if(int[] pos) {
  int a = read_paren_cond(pos);
  int id = if_then(pos, a);
} return int id;
given boot_a given ty_setup given lexfix stdin "if (1) ;" ([0]):(2)
given boot_a given ty_setup given lexfix stdin "if (1) ; else ;" ([0]):(3)

if_then(int[] pos, int a) {
  advance(pos);
  int[] l = [parse_stmt(pos)];
  int id = if_else(pos, a, l);
} return int id;
given boot_a given ty_setup given lexfix stdin ");" ([0], 0):(1) then calls parse_stmt:[1]
given boot_a given ty_setup given lexfix stdin ")x;" ([0], 0):(2) then calls parse_stmt:[1]

if_else(int[] pos, int a, int[] l) {
  int[] m = [];
  if(at_text(pos, "else")) {
    fill_else(pos, m);
  }
  int id = newnode("if", a, 0, "", "", l, m);
} return int id;
given boot_a given lexfix stdin "" ([0], 0, [0]):(0)
given boot_a given lexfix stdin "else ;" ([0], 0, [0]):(1)
