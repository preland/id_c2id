// The else arm is filled through a helper because `id` lists are
// reference-semantic: pushing into `m` here is visible to if_else's caller.
fill_else(int[] pos, int[] m) {
  advance(pos);
  int id = parse_stmt(pos);
  push(m, id);
} return void;
given boot_a given ty_setup given lexfix stdin "else ;" ([0], []):([2])
given boot_a given ty_setup given lexfix stdin "else x;" ([0], []):([3])

parse_paren_kw(int[] pos, string kw) {
  int a = read_paren_cond(pos);
  int id = kw_body(pos, a, kw);
} return int id;
given boot_a given ty_setup given lexfix stdin "while (1) ;" ([0], "while"):(2)
given boot_a given ty_setup given lexfix stdin "while (1) x;" ([0], "while"):(3)
given boot_a given ty_setup given lexfix stdin "switch (1) {;}" ([0], "switch"):(3) then calls read_paren_cond:[1]
given boot_a given ty_setup given lexfix stdin "switch (x) {;}" ([0], "switch"):(3) then calls read_paren_cond:[1]

// A while or a switch keeps its body as one statement; the cases inside a switch
// are ordinary statements in it. Turning that into jump edges is the CFG
// builder's job, not the parser's -- which is why `switch` needs no special
// shape here. kw is the node kind.
kw_body(int[] pos, int a, string kw) {
  advance(pos);
  int[] l = [parse_stmt(pos)];
  int id = newlist(kw, a, 0, "", l);
} return int id;
given boot_a given ty_setup given lexfix stdin ");" ([0], 0, "while"):(1) then calls parse_stmt:[1]
given boot_a given ty_setup given lexfix stdin ")x;" ([0], 0, "while"):(2) then calls parse_stmt:[1]
given boot_a given ty_setup given lexfix stdin "){;}" ([0], 0, "switch"):(2) then calls parse_stmt:[2]
given boot_a given ty_setup given lexfix stdin "){x;}" ([0], 0, "switch"):(3) then calls parse_stmt:[2]
