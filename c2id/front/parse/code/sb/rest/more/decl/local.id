// The specifiers of a local declaration, the one place `typeof(expr)` and
// `__auto_type` are translated: tofok says so while they are read.
parse_specs_local(int[] pos) {
  lset((import tofok), 0, 1);
  int t = parse_specs(pos);
  lset((import tofok), 0, 0);
} return int t;
