// A statement has just been read in a block. If it declared variables with a cleanup
// the rest of the block is their scope (cl_block); a cleanup that came from anywhere
// else, a `for` initialiser, is not translated.
cl_after(int[] ca_pos, int[] ca_l, int ca_id) {
  if(len((import clpn)) > 0 && (import nk)[ca_id] == "block") {
    cl_block(ca_pos, ca_l);
  } else if(len((import clpn)) > 0) {
    cl_stray(ca_id);
  }
} return void;
