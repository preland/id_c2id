// One pointer variable for each name, declared at the end of l; their names.
cl_ptrs(int[] cp_l, string[] cp_names) {
  string[] cp_out = [];
  int cp_i = 0;
  while(cp_i < len(cp_names)) {
    cl_ptr1(cp_l, cp_names[cp_i], cp_out);
    cp_i = cp_i + 1;
  }
} return string[] cp_out;
