// A copy of the strings of a list, emptying the list.
cl_drain(string[] cd_src) {
  string[] cd_out = [];
  while(len(cd_src) > 0) {
    push(cd_out, cd_src[0]);
    list_string_delete(cd_src, 0);
  }
} return string[] cd_out;
