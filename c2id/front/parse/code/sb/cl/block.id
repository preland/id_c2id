// The variables of the declaration just read have cleanups; the rest of the block is
// read here as their scope. For each variable a pointer to it is declared first,
// under a name no other can take, so that a shadowing declaration below cannot
// capture the call. The rest then becomes one block (cl_wrap_all) that the block
// being read ends with.
cl_block(int[] cb_pos, int[] cb_l) {
  string[] cb_n = cl_drain((import clpn));
  string[] cb_f = cl_drain((import clpf));
  string[] cb_p = cl_ptrs(cb_l, cb_n);
} chain (int[] cb_pos, int[] cb_l) {
  int[] cb_rest = fill_stmts(cb_pos);
  int cb_w = cl_wrap_all(cb_rest, cb_f, cb_p);
  push(cb_l, cb_w);
} return void;
