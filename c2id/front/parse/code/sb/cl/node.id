// `fn(ptr);` as a statement, naming the function and the pointer variable of the
// scope being wrapped (clcur). Every use makes nodes of its own: the passes
// below rename names in place, so a node must not be shared between two places.
cl_callstmt() {
  int cs_f = newleaf("var", 0, 0, (import clcur)[1], "");
  int cs_p = newleaf("var", 0, 0, (import clcur)[0], "");
  int cs_c = newlist("call", cs_f, 0, "", [cs_p]);
} chain () {
  int cs_s = newleaf("expr", cs_c, 0, "", "");
} return int cs_s;
