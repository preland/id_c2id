// `__auto_type name = <expr>;` as a declaration statement: the type is taken from
// the initializer by the frame pass.
cl_decl(string cd_name, int cd_init) {
  int cd_t = newleaf("auto", 0, 0, "", "");
  int cd_d = newleaf("decl", cd_init, cd_t, cd_name, "");
  int cd_b = newlist("block", 0, 0, "", [cd_d]);
} return int cd_b;
