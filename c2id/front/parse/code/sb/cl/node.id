// `__auto_type name = &var;`
cl_addr(string ca_name, string ca_var) {
  int ca_v = newleaf("var", 0, 0, ca_var, "");
  int ca_a = newleaf("un", ca_v, 0, "&", "");
  int ca_b = cl_decl(ca_name, ca_a);
} return int ca_b;
