// `__auto_type __cl_pN = &name;` for one cleanup variable, in the block being read.
cl_ptr1(int[] cq_l, string cq_name, string[] cq_out) {
  string cq_p = cl_fresh("__cl_p");
  int cq_d = cl_addr(cq_p, cq_name);
  push(cq_l, cq_d);
} chain (int[] cq_l, string cq_name, string[] cq_out) {
  push(cq_out, cq_p);
} return void;
