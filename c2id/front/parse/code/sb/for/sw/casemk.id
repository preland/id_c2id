given boot_a given boot_b given lexfix stdin ":" ([0], [], 3, 1):([0], [])

case_one(int v) {
  int num = newleaf("num", v, 0, "" + v, "");
  int cnode = newleaf("case", num, 0, "", "");
} return int cnode;
