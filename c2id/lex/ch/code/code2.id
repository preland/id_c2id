// End-of-input, and the two classes that make an exponent part.

// Reading past the end of the source yields byte 0 (the NUL that mem_of_str
// copies, then the zeroed pad block lex_mem allocates behind it), so 0 is
// this lexer's end-of-input marker.
ch_eof() {
} return int 0;

// `e` `E` `p` `P` -- the letters that may introduce a signed exponent inside
// a preprocessing number (`p`/`P` for hexadecimal floats).
is_exp(int c) {
  int ok = 0;
  if(c == 101 || c == 69 || c == 112 || c == 80) {
    ok = 1;
  }
} return int ok;

// `+` and `-`.
is_expsign(int c) {
  int ok = 0;
  if(c == 43 || c == 45) {
    ok = 1;
  }
} return int ok;
