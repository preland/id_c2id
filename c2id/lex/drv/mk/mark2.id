// The rest of a line marker: the line number, then the file name, then the
// flags, which are skipped along with the marker's newline.

// `e` is at the first character after `#`. The digits (possibly none) set
// the line, and whatever follows the horizontal whitespace after them is
// where the filename would be.
mark_num(word base, int e) {
  int j = digit_end(base, e);
  set_line(base, e, j);
  int r = mark_after_digits(base, j);
} return int r;

// Split out of mark_num: naming skip_h's result and mark_file's result are
// both required (a call may not be an argument to a call, nor a return
// clause), and mark_num has no third action to spare for either.
mark_after_digits(word base, int j) {
  int e = skip_h(base, j);
  int c = ch_dq();
  int r = mark_file(base, e, c);
} return int r;

// `e` is at the opening quote of the filename, if there is one, and `c` is
// the quote byte. eol_end swallows the marker's own newline without counting
// it, which is what makes the stored number apply to the line that follows.
mark_file(word base, int e, int c) {
  int qe = quote_end(base, e + 1, c);
  set_file(base, e, qe);
  int r = eol_end(base, e);
} return int r;
