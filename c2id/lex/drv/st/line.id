// Maintaining the current position: `curline` and `curfile` are one-element
// lists rather than scalars because only the declaring function may assign an
// exported scalar (NOTES.md section 6).

bump_line() {
  lset((import curline), 0, (import curline)[0] + 1);
} return void;
given init_lines ():() then curline_now:(2)
given lex_tok_fixture ():() then curline_now:(2)

// The number in a `# 42 "lib/sort.c" 3 4` marker names the line the *next*
// source line has, and mark_file consumes the marker's own newline without
// counting it, so the number is stored as-is. A `#` line with no number at
// all (a stray directive that survived preprocessing) is still a real line,
// so it is counted like any other.
set_line(word base, int a, int b) {
  if(b > a) {
    string s = slice(base, a, b);
    int n = to_int(s);
    lset((import curline), 0, n);
  } else {
    bump_line();
  }
} return void;
given init_lines given lex_src_fixture ((import gb), 24, 25):() then curline_now:(5)
given init_lines given lex_src_fixture ((import gb), 4, 4):() then curline_now:(2)

// `a` is where the filename should start and `b` is just past its closing
// quote. Markers without a filename leave curfile alone.
set_file(word base, int a, int b) {
  if(peek8(base + a) == (import ch_dq)) {
    string s = slice(base, a + 1, b - 1);
    sset((import curfile), 0, s);
  }
} return void;
