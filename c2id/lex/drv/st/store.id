// The token-store append. The two imported-list store helpers (`lset` and
// `sset`) come from the standard library.
//
// The append keeps the three lists parallel because it is the only thing
// that pushes to them.

add_tok(string kind, string txt) {
  push((import tkind), kind);
  push((import ttext), txt);
  push((import tline), (import curline)[0]);
} return void;
