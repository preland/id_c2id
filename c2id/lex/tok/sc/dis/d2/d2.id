// The dispatch chain, part 2: the tail of the per-character decision tree.

// Identifier or literal prefix -- scan_ident tells the two apart.
scan_numop(word base, int i) {
  int ni = 0;
  if(is_alpha_at(base, i)) {
    ni = scan_ident(base, i);
  } else {
    ni = scan_strop(base, i);
  }
} return int ni;

// A number starts with a digit, or with `.` (46) immediately followed by
// one; a `.` on its own is the member operator.
scan_strop(word base, int i) {
  int ni = 0;
  if(is_digit_at(base, i) || is_num_dot_at(base, i)) {
    ni = scan_num(base, i);
  } else {
    ni = scan_quop(base, i);
  }
} return int ni;

// An unprefixed string or character literal (token start and quote index
// coincide), else operator or punctuation.
scan_quop(word base, int i) {
  int ni = 0;
  if(peek8(base + i) == (import ch_dq) || peek8(base + i) == (import ch_sq)) {
    ni = scan_quoted(base, i, i);
  } else {
    ni = scan_op(base, i);
  }
} return int ni;
