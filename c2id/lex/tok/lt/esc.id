// `i` is the index just past the opening quote and `c` is the quote byte.
// Returns the index just past the closing quote. A newline also stops the
// scan: an unterminated literal then costs one bad token instead of eating
// the rest of the file.
quote_end(word base, int i, int c) {
  while(peek8(base + i) != c && peek8(base + i) != (import ch_eof) && peek8(base + i) != (import ch_nl)) {
    i = adv_esc(base, i);
  }
  int r = quote_stop(base, i);
} return int r;
