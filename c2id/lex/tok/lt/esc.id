// Finding the end of a quoted run, honouring backslash escapes so that a
// `\"` inside a string and a `'\''` character constant do not terminate
// early.

// Advance one byte, or two when this byte is a backslash (92) -- the escaped
// character is then skipped without ever being examined.
adv_esc(word base, int i) {
  int ni = i + 1;
  if(peek8(base + i) == 92) {
    ni = i + 2;
  }
} return int ni;
