// One node: a call is read for what it names and passes; a name for the function
// it may stand for.
chk_here(int id) {
  string kn = (import nk)[id];
  if(kn == "call") {
    chk_call(id);
  } else if(kn == "var") {
    chk_fnval(id);
  }
} return void;
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int main(void) { return nosuch(1); }" (11):() then (import unres):(["nosuch"])
