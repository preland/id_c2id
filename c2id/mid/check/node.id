given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int nosuch(int); int main(void) { return nosuch(1); }" (13):() then len((import unres)):(0)

chk_call(int id) {
  string name = call_name(id);
  chk_ext(name, id);
  chk_refuse(name, id);
} chain (int id) {
  chk_args(id);
  chk_fmt(name, id);
  chk_open(name, id);
} chain (int id) {
  chk_mark(id);
} return void;
