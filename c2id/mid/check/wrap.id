given boot_a given boot_b given lexfix given tu_load given reach_init(2) stdin "int g(void) { return 0; }" ("malloc", 0, "w", -1):() then (import ns)[0]:("int") then len((import dgmsg)):(1)

// The node takes the wrapper's name, and the wrapper is marked reached.
chk_swap(int id, string wn, int i) {
  string_list_set((import ns), id, wn);
  integer_list_set((import reach), i, 1);
} return void;
