chk_fty(int id, int ty) {
  int bt = ty_base(ty);
  string fname = (import ns)[bt];
  int fl = find_str((import float_names), fname);
} chain (int id, int ty) {
  if(fl >= 0 && (import nk)[bt] == "prim" && (import chk_flt)[0] == 0) {
    lset((import chk_flt), 0, 1);
    diag_node(id, "floating-point value of type '" + fname + "' is not supported: c2id has no float model yet");
  }
} return void;
