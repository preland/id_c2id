// Floating point has no model: a double would be read and written as an
// integer, so every use is refused where it appears, once per function.
chk_float(int id, string kn) {
  int ty = chk_ty(id, kn);
  chk_fty(id, ty);
} return void;
given boot_a given boot_b given lexfix given tu_load given reach_all given chk_bind(8, 15) stdin "int main(void) { double d = 1; return d; }" (13, "var"):() then (import dgmsg):([":1: error: floating-point value of type 'double' is not supported: c2id has no float model yet"])
