// A node that is refused for what it is: a "refuse" node the parser left for a
// construct it could not tell was reached (front/diag/refuse.id), and a use of a
// variable the program bound to a machine register with asm("name"), and a node
// that holds a 128-bit integer (chk_wide).
chk_extra(int id) {
  string kn = (import nk)[id];
  if(kn == "refuse") {
    diag_node(id, (import ns)[id]);
  } else if(kn == "var") {
    chk_regvar(id);
  }
} chain (int id) {
  chk_wide(id);
  chk_seg(id);
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "int f(void) { return _Generic(1, int: 2); }" (9):() then len((import dgmsg)):(1)
given boot_a given boot_b given lexfix given tu_load stdin "int f(void) { return 1; }" (9):() then len((import dgmsg)):(0)

chk_regvar(int id) {
  if(find_str((import regnames), (import ns)[id]) >= 0) {
    diag_node(id, "'" + (import ns)[id] + "' is a variable bound to a machine register with asm(\"name\"), which c2id does not model: reading it would get a value of its own, not the register's");
  }
} return void;
given boot_a given boot_b given exprfix given lst_str_insert((import regnames), 0, "sp") stdin "sp;" ((import extop)):() then len((import dgmsg)):(1)
given boot_a given boot_b given exprfix given lst_str_insert((import regnames), 0, "sp") stdin "x;" ((import extop)):() then len((import dgmsg)):(0)
