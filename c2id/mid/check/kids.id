// The children of a node, by kind, read the way reach_kids reads them:
// conf.id's scan_a / scan_b hold the kinds whose na / nb is a node, scan_l and
// scan_m those whose nl / nm is a list of nodes.
chk_kids(int id, string kn) {
  if(find_str((import scan_a), kn) >= 0) {
    chk_scan((import na)[id]);
  }
  if(find_str((import scan_b), kn) >= 0) {
    chk_scan((import nb)[id]);
  }
  if(find_str((import scan_l), kn) >= 0) {
    chk_list((import nl)[id]);
  }
} chain (int id, string kn) {
  if(find_str((import scan_m), kn) >= 0) {
    chk_list((import nm)[id]);
  }
} return void;
