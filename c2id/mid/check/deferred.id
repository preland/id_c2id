// now that the function is known to be reached.
chk_deferred(int cd_fi) {
  int cd_i = 0;
  while(cd_i < len((import qfn))) {
    chk_defer_one(cd_fi, cd_i);
    cd_i = cd_i + 1;
  }
} return void;
