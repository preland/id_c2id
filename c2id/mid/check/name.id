// Whether something provides the function: the program defines it, or the
// runtime does (conf.id's rt_names), or it is an allocator call mapped onto crt.
fn_known(string name) {
  int ok = 0;
  if(find_str((import fnames), name) >= 0 || find_str((import rt_names), name) >= 0 || find_str((import libc_names), name) >= 0) {
    ok = 1;
  }
} return int ok;
