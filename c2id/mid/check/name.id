// The name a call goes to by name, or "" for a call through a pointer.
call_name(int id) {
  int a = (import na)[id];
  string name = "";
  if(a >= 0 && (import nk)[a] == "var" && direct_call(a) == 1) {
    name = (import ns)[a];
  }
} return string name;
