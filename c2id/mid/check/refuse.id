// A struct or union is passed by value to every function the program defines
// (the wrapper copies it); the arguments after the fixed ones of a variadic
// function are a list of words, which has no room for one.
chk_arg(int id, int a, int i) {
  int ty = ex_ty(a);
  int k = va_any((import ns)[(import na)[id]]);
  if((import nk)[ty] == "rec" && k >= 0 && i >= k) {
    diag_node(id, "argument " + (i + 1) + " is a struct or union passed by value through '...', which is not supported: pass a pointer");
  }
} return void;
