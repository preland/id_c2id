// A call to something c2id has a reason not to translate (conf.id's
// refuse_names, refuse_why).
chk_refuse(string name, int id) {
  int k = find_str((import refuse_names), name);
  if(k >= 0) {
    diag_node(id, "call to '" + name + "' is not supported: " + (import refuse_why)[k]);
  }
} return void;
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int main(void) { setjmp(0); return 0; }" ("setjmp", 11):() then (import dgmsg):([":1: error: call to 'setjmp' is not supported: non-local jumps cannot unwind the block-function frames"])
