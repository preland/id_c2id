given boot_a given boot_b given lexfix given tu_load given reach_all given chk_bind(13, 21) stdin "struct P { int x; }; int g(int a, struct P p); int main(void) { struct P q; return g(1, q); }" (19):() then (import dgmsg):([":1: error: argument 2 is a struct or union passed by value, which is not supported: the callee's writes would reach the caller's object; pass a pointer"])

// A struct or union argument is passed by value, which has no translation.
chk_arg(int id, int a, int i) {
  int ty = ex_ty(a);
  if((import nk)[ty] == "rec") {
    diag_node(id, "argument " + (i + 1) + " is a struct or union passed by value, which is not supported: the callee's writes would reach the caller's object; pass a pointer");
  }
} return void;
