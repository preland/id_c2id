// The refusal for a format whose conversion at `at` is not implemented.
chk_fmtbad(int id, string name, string lit, int bad) {
  if(bad >= 0) {
    int j = fmt_end(lit, bad);
    string spec = str_slice(lit, bad, j - bad);
    diag_node(id, "'" + name + "' format has the conversion '" + spec + "', which the c2id runtime does not implement (hexadecimal floating point and %n for printf; hexadecimal floating point and the set '[' for sscanf)");
  }
} return void;
