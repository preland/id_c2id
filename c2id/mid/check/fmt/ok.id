// Whether every character in [from, to) is a flag, width or length the runtime
// implements.
mid_ok(string lit, int from, int to, int scan) {
  int ok = 1;
  int k = from;
  while(k < to && ok == 1) {
    int cch = charat(lit, k);
    ok = mid_char(cch, scan);
    k = k + 1;
  }
} return int ok;
("%-5ld", 1, 4, 0):(1)
("%.5d", 1, 3, 0):(1)
("%a", 1, 2, 0):(0)
("%*d", 1, 2, 1):(1)

// Digits and the lengths l, h and z are implemented by both families; the flags,
// the precision, `*` (an argument) and the length L (a long double) by printf,
// and `*` (a value read but not stored), j and t by sscanf.
mid_char(int c, int scan) {
  int ok = 0;
  if(c >= 48 && c <= 57 || c == 108 || c == 104 || c == 122) {
    ok = 1;
  }
  if(scan == 0 && (c == 45 || c == 46 || c == 43 || c == 32 || c == 35 || c == 42 || c == 76) || scan == 1 && (c == 42 || c == 106 || c == 116)) {
    ok = 1;
  }
} return int ok;
(76, 0):(1)
(76, 1):(0)
(45, 0):(1)
(45, 1):(0)
(42, 1):(1)
(42, 0):(1)
(46, 0):(1)
(46, 1):(0)
(100, 0):(0)

// The conversion letters: d i u x X o c s e E f F g G and % for both, p for printf, n for sscanf.
conv_ok(int c, int scan) {
  int ok = 0;
  if(c == 100 || c == 105 || c == 117 || c == 120 || c == 88 || c == 111 || c == 99 || c == 115 || c == 37 || c == 101 || c == 69 || c == 102 || c == 70 || c == 103 || c == 71) {
    ok = 1;
  }
  if(scan == 0 && c == 112 || scan == 1 && c == 110) {
    ok = 1;
  }
} return int ok;
(100, 0):(1)
(112, 0):(1)
(112, 1):(0)
(110, 1):(1)
(102, 0):(1)
(97, 0):(0)
