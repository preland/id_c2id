// Whether every character in [from, to) is a flag, width or length the runtime
// implements.
mid_ok(string lit, int from, int to, int scan) {
  int ok = 1;
  int k = from;
  while(k < to && ok == 1) {
    int cch = charat(lit, k);
    ok = mid_char(cch, scan);
    k = k + 1;
  }
} return int ok;
("%-5ld", 1, 4, 0):(1)
("%.5d", 1, 3, 0):(0)
("%*d", 1, 2, 1):(1)

// Digits and the lengths l, h and z are implemented by both families; `-` by
// printf only, and `*` (a value read but not stored), j and t by sscanf only.
mid_char(int c, int scan) {
  int ok = 0;
  if(c >= 48 && c <= 57 || c == 108 || c == 104 || c == 122) {
    ok = 1;
  }
  if(scan == 0 && c == 45 || scan == 1 && (c == 42 || c == 106 || c == 116)) {
    ok = 1;
  }
} return int ok;
(45, 0):(1)
(45, 1):(0)
(42, 1):(1)
(42, 0):(0)
(100, 0):(0)

// The conversion letters: d i u x X o c s and % for both, p for printf, n for sscanf.
conv_ok(int c, int scan) {
  int ok = 0;
  if(c == 100 || c == 105 || c == 117 || c == 120 || c == 88 || c == 111 || c == 99 || c == 115 || c == 37) {
    ok = 1;
  }
  if(scan == 0 && c == 112 || scan == 1 && c == 110) {
    ok = 1;
  }
} return int ok;
(100, 0):(1)
(112, 0):(1)
(112, 1):(0)
(110, 1):(1)
(102, 0):(0)
