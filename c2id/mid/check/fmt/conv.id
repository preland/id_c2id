// The offset i when the span [i, j) is a conversion the runtime does not
// implement, else -1.
fmt_isbad(string lit, int i, int j, int scan) {
  int bad = 0 - 1;
  if(charat(lit, i) == 37 && fmt_ok(lit, i, j, scan) == 0) {
    bad = i;
  }
} return int bad;
("%a", 0, 2, 0):(0)
("%f", 0, 2, 0):(-1)
("%d", 0, 2, 0):(-1)
("%%", 0, 2, 0):(-1)
("%.3s", 0, 4, 0):(-1)

// 1 when the conversion in [i, j) is one the runtime implements: its letter is
// known and everything between the `%` and the letter is a flag, width or length
// that is.
fmt_ok(string lit, int i, int j, int scan) {
  int cch = charat(lit, j - 1);
  int ok = conv_ok(cch, scan);
  if(ok == 1) {
    ok = mid_ok(lit, i + 1, j - 1, scan);
  }
} return int ok;
("%d", 0, 2, 0):(1)
("%-5ld", 0, 5, 0):(1)
("%+d", 0, 3, 0):(1)
("%a", 0, 2, 0):(0)
("%f", 0, 2, 0):(1)

// The characters that sit between `%` and the conversion letter: flags, width,
// precision (`.`, `*`), and the length modifiers.
is_fmtmod(int c) {
  int ok = 0;
  if(c >= 48 && c <= 57 || c == 46 || c == 45 || c == 43 || c == 35 || c == 32 || c == 42 || c == 39 || c == 108 || c == 104 || c == 76 || c == 122 || c == 106 || c == 116 || c == 113) {
    ok = 1;
  }
} return int ok;
(46):(1)
(100):(0)
(108):(1)
