// A brace initializer is not an expression; its elements are lowered where
// they are stored (back/link/data/boot/init).
lower_init(int id) {
  int a = (import na)[id];
  if((import nk)[a] != "init") {
    int r = lower_val(a);
    lset((import na), id, r);
  }
} return void;
