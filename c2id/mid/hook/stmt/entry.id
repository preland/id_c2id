given low_fix given sset((import nk), 12, "decl") given lset((import na), 12, 9) (12):() then (import na)[12]:(19)

lower_expr_stmt(int id) {
  int e = (import na)[id];
  int r = lower_top(e);
  lset((import na), id, r);
} return void;
