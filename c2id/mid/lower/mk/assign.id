// The type of the temporary a conditional's value is kept in: an array decays
// to a pointer, and void (a conditional used as a statement) to int.
tern_ty(int ty) {
  int r = ty;
  if((import nk)[ty] == "arr") {
    r = newleaf("ptr", (import na)[ty], 0, "", "");
  }
  if((import nk)[ty] == "prim" && (import ns)[ty] == "void") {
    r = (import stdty)[0];
  }
} return int r;
