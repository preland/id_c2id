jmp_split(int cn, int rb) {
  effect_stmt(cn);
  int c = cur_blk();
  term_jmp(c, rb);
} chain (int cn, int rb) {
  set_cur(rb);
  integer_list_set((import sjf), 0, 1);
} return void;
