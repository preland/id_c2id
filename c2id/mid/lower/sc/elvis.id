// `c ?: y` has the same node as its condition and its middle arm. The condition
// is lowered once and kept in a temporary, which both the test and the middle
// arm then read, so that what the condition computes is computed once.
tern_once(int e, int c0) {
  int c = c0;
  if((import na)[e] == (import nb)[e]) {
    c = tern_hoist(e, c0);
  }
} return int c;
