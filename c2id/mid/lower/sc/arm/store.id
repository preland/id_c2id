// An arm of a conditional that has a value is stored in the temporary; one of
// type void (`c ? f() : (void)0`, which is what assert expands to) has none, and
// is only run.
tern_store(int t, int v) {
  int vt = ex_ty(v);
  if(is_void(vt) == 1) {
    effect_stmt(v);
  } else {
    assign_stmt(t, v);
  }
} return void;
