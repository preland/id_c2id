// The arm the left operand alone decides, after which filling continues in the
// join block.
sc_const(int t, int k, int cb, int jb) {
  set_cur(cb);
  int kv = k - 1;
  int n = mk_num(kv);
} chain (int t, int k, int cb, int jb) {
  assign_stmt(t, n);
  term_jmp(cb, jb);
  set_cur(jb);
} return void;
