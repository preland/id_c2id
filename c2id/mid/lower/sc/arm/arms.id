// The arm that evaluates the right operand.
sc_right(int e, int t, int rb, int jb) {
  set_cur(rb);
  int r = lower_val((import nb)[e]);
  int ne = mk_ne(r);
} chain (int e, int t, int rb, int jb) {
  assign_stmt(t, ne);
  int cc = cur_blk();
  term_jmp(cc, jb);
} return void;
