sc_make(int e, int t, int lv, int k) {
  int rb = new_block();
  int cb = new_block();
  int jb = new_block();
} chain (int e, int t, int lv, int k) {
  int c = cur_blk();
  if(k == 1) {
    term_cond(c, lv, rb, cb);
  } else {
    term_cond(c, lv, cb, rb);
  }
} chain (int e, int t, int lv, int k) {
  sc_arms(e, t, k, rb, cb, jb);
} return void;
