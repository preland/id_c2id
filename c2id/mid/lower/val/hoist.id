hoist_ind(int id) {
  int hit = call_ind(id);
  if(hit == 1) {
    int ft = ex_ty((import na)[id]);
    hit = (import nk)[ft] == "ptr" || (import nk)[ft] == "fn";
  }
} return int hit;
