lower_v4(int e) {
  int r = e;
  if(e >= 0 && un_incdec(e) == 1) {
    r = lower_pre_val(e);
  } else {
    r = lower_v5(e);
  }
} return int r;

// The kinds with one child (unary, cast, member access) are one function;
// indexing has two.
lower_v5(int e) {
  int r = e;
  if(e >= 0 && one_kid(e) == 1) {
    r = lower_kid1(e);
  } else {
    r = lower_v6(e);
  }
} return int r;

lower_v6(int e) {
  int r = e;
  if(e >= 0 && (import nk)[e] == "idx") {
    r = lower_kid2(e);
  } else {
    r = lower_v7(e);
  }
} return int r;
