// A call with a value goes into a temporary that stands for it; a void one has
// none, so it is just the statement, and what stands for it is a zero nothing
// reads.
hoist_store(int e, int et) {
  int r = 0;
  if((import nk)[et] == "prim" && (import ns)[et] == "void") {
    effect_stmt(e);
    r = mk_num(0);
  } else {
    r = hoist_temp(e, et);
  }
} return int r;
