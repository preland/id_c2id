// Which functions the program can reach. C compiles a function nobody calls to
// nothing, and a translation unit full of `static inline` wrappers around
// functions it never defines (a header's compatibility names) is legal for that
// reason alone; emitting every function would emit calls to functions that do not
// exist. So emission starts from main -- or from every function, for a unit
// that has none -- and follows every function a reachable body names, as a
// callee or as a value, and every one a global's initializer names.
reach_all() {
  int n = len((import fnames));
  reach_init(n);
  int mi = find_str((import fnames), "main");
} chain () {
  reach_roots(mi, n);
  reach_drain();
} return void;

// A flag per function, all 0.
reach_init(int n) {
  while(len((import reach)) < n) {
    push((import reach), 0);
  }
} return void;

// main and the functions the global initializers name; with no main, every
// function.
reach_roots(int mi, int n) {
  if(mi >= 0) {
    reach_mark(mi);
    reach_inits(0);
  } else {
    reach_every(0, n);
  }
} return void;
