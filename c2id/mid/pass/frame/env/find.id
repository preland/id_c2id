// The newest renaming of `dn`, or "".
env_find(string dn) {
  int i = len((import envo)) - 1;
  string nn = "";
  while(i >= 0 && nn == "") {
    nn = env_at(dn, i);
    i = i - 1;
  }
} return string nn;
