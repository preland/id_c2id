// The children of a node by kind (conf.id scan_a/b/l/m, as in the reachability
// pass), in the order the fields come, each list its own scope; a for loop has
// its own order (bind_for).
bind_kids(int id, string kn) {
  if(kn == "for") {
    bind_for(id);
  } else {
    bind_kids2(id, kn);
  }
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "void f(void) { for (int i = 0; i < 2; i++) { } for (int i = 0; i < 2; i++) { } }" (19, "for"):() then (import lvnames):(["i"]) then calls bind_for:(19)
given boot_a given boot_b given lexfix given tu_load stdin "void f(void) { for (int i = 0; i < 2; i++) { } for (int i = 0; i < 2; i++) { } }" (31, "block"):() then (import lvnames):(["i", "i__0"]) then calls bind_kids2:(31, "block")

bind_kids2(int id, string kn) {
  if(find_str((import scan_a), kn) >= 0) {
    bind_decls((import na)[id]);
  }
  if(find_str((import scan_b), kn) >= 0) {
    bind_decls((import nb)[id]);
  }
  if(find_str((import scan_l), kn) >= 0) {
    bind_list((import nl)[id]);
  }
} chain (int id, string kn) {
  if(find_str((import scan_m), kn) >= 0) {
    bind_list((import nm)[id]);
  }
  bind_sret(id, kn);
} return void;
