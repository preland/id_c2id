given boot_a given boot_b given lexfix given tu_load stdin "int f(int a) { int b = a; return b; }" (14, "return"):() then calls bind_var:(13) then len((import lvnames)):(0)

bind_list(int[] l) {
  int h = len((import envo));
  int i = 0;
  while(i < len(l)) {
    bind_decls(l[i]);
    i = i + 1;
  }
} chain (int[] l) {
  if(decls_only(l) == 0) {
    env_trunc(h);
  }
} return void;
