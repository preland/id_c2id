// A list that is only declarations (`int a, b;` is one such, a block of decls)
// is no scope of its own: what it declares is in scope after it.
decls_only(int[] l) {
  int other = 0;
  int i = 0;
  while(i < len(l)) {
    other = other + (decl_like(l[i]) == 0);
    i = i + 1;
  }
} chain (int[] l) {
  int only = other == 0;
} return int only;
