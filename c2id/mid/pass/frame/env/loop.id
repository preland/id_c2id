// A for loop in source order -- init, condition, step, body -- because the init
// is what declares the loop variable the condition and step are about, and a
// declaration's renaming only reaches what is walked after it. The loop variable
// is in scope for the whole loop and no longer.
bind_for(int id) {
  int h = len((import envo));
  bind_list((import nl)[id]);
  bind_decls((import na)[id]);
} chain (int id) {
  bind_decls((import nb)[id]);
  bind_list((import nm)[id]);
  env_trunc(h);
} return void;
