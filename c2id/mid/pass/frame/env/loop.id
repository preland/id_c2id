// A declaration, or a block that holds nothing but declarations (the parser
// wraps `int a, b;` in one).
decl_like(int id) {
  int ok = 0;
  if((import nk)[id] == "decl") {
    ok = 1;
  } else if((import nk)[id] == "block") {
    ok = decls_only((import nl)[id]);
  }
} return int ok;
