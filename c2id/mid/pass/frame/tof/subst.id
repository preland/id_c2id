// The declaration's type with the stand-in replaced by the type found, through
// the pointers and arrays declarators put around it (`typeof(x) *p[3]`).
// Anything else around the stand-in (a function type) is left, and refused.
tof_store(int id, int ty, int rty) {
  int nty = tof_subst(ty, rty);
  lset((import nb), id, nty);
  tof_left(id, nty);
} return void;
