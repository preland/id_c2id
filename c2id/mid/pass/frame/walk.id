env_fresh(string dn) {
  int n = (import lcnt)[0];
  lset((import lcnt), 0, n + 1);
  string fresh = dn + "__" + n;
} chain (string dn) {
  push((import envo), dn);
  push((import envn), fresh);
} return string fresh;
