// The name a declaration of `dn` takes: itself when no local has that name yet,
// else a fresh one, noted in the renamings.
bind_name(string dn) {
  string fresh = dn;
  if(frame_off(dn) >= 0) {
    fresh = env_fresh(dn);
  }
} return string fresh;
given gl_setup given init_frame given init_frame2 given add_slot("x", 8, 4) ("x"):("x__0")
