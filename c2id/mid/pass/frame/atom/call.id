// A call of a GCC atomic or __sync builtin is rewritten here, once the frame pass
// has bound its arguments, because the size and the type of the object it works
// on come from the type of its first argument (conf.id, atom_names). The program
// has one thread, so the call becomes a call of the plain operation in
// rt/ext/builtin, with the object's size added; a fence or a lock-free test
// becomes a constant.
atom_call(int id) {
  int c = (import na)[id];
  int k = atom_index(c);
  if(k >= 0) {
    atom_arg(id, k);
  }
} return void;
