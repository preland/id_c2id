// A declaration of a local. The name keeps its own slot if it is new; otherwise it gets a
// fresh name, a slot under that name, and a renaming for the rest of its scope.
bind_auto(int id) {
  string dn = (import ns)[id];
  int ty = (import nb)[id];
  string fresh = bind_name(dn);
} chain (int id) {
  sset((import ns), id, fresh);
  int off = decl_slot(fresh, ty);
  bind_decls((import na)[id]);
} return void;
