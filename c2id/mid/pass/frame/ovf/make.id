// The types the three arguments have, as infos: the size in bytes times two, plus
// one for a signed type. The result's is that of the object the third argument
// points at, -1 when it points at nothing.
ovf_make(int id, int k, int[] args) {
  int ai = ovf_of(k, args[0]);
  int bi = ovf_of(k, args[1]);
  int ri = ovf_res(k, args[2]);
} chain (int id, int k, int[] args) {
  ovf_go(id, k, args, ai, bi, ri);
} return void;
