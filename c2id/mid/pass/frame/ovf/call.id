// A call of a GCC overflow builtin is rewritten here, once the frame pass has
// bound its arguments, because the types of the operands and of the object the
// result goes in come from their expressions (conf.id, ovf_names). It becomes a
// call of c___c2id_ovf (rt/ext/builtin/ovf.id) with the operation and the three
// types as extra arguments.
ovf_call(int id) {
  int c = (import na)[id];
  int k = ovf_index(c);
  if(k >= 0) {
    ovf_arg(id, k);
  }
} return void;
