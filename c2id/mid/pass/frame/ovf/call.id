// A call with other than three arguments is refused.
ovf_arg(int id, int k) {
  int[] args = (import nl)[id];
  if(len(args) != 3) {
    diag_node(id, (import ovf_names)[k] + " takes 3 arguments: the two operands and a pointer to the result");
  } else {
    ovf_make(id, k, args);
  }
} return void;
