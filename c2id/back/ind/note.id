// The dispatch for an argument count some call through a pointer has and no function
// the program defines matches: the pointer can only be to code the program does not
// have, so reaching it ends the program the way abort does.
ind_stub(int is_n) {
  string is_p = ind_params(is_n);
  emit_mark();
  emit_head(is_p, "crt_call" + is_n + "(" + is_p + ") {");
} chain (int is_n) {
  emit_out("  word r = 0;");
  emit_out("  c_abort();");
  emit_cut("} return word r;");
} return void;
