// A call through a pointer with n arguments has been written, so crt_callN has to
// exist even if the program defines no function with n parameters (a library whose
// callbacks come from outside; then it is a stub, ind_stub). An argument count past
// the dispatch's 6 is left alone.
ind_note(int in_id) {
  int in_a = (import na)[in_id];
  int in_n = len((import nl)[in_id]);
  if(direct_call(in_a) == 0 && in_n < 7) {
    lset((import indn), in_n, 1);
  }
} return void;
