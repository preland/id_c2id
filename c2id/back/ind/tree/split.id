ind_split(int n, int[] fs, int lo, int hi, int top) {
  int mid = (lo + hi) / 2;
  string lc = ind_node(n, fs, lo, mid, 0);
  string rc = ind_node(n, fs, mid, hi, 0);
} chain (int n, int[] fs, int lo, int hi, int top) {
  string fname = ind_name(n, lo, hi, top);
  int cut = fs[mid] + 1;
  ind_print(n, fname, cut, lc, rc);
} return void;
