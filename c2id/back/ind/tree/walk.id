// The tree over fs[lo..hi): a node splits on the function's number, a leaf is
// the one function. The entry is named crt_callN; a single function needs no
// tree, only an entry that calls it.
emit_ind_tree(int n, int[] fs) {
  int k = len(fs);
  string root = ind_node(n, fs, 0, k, 1);
  if(k == 1) {
    ind_print(n, "crt_call" + n, 0, root, root);
  }
} return void;
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int f(int a) { return a; }" (1, [0]):() then prints:("==== FILE b/ax/bx/cx/dx/ex/fx/gx/hx/fa.id\ncrt_call1(word f, word a0) {\n  word k0 = 0;\n  word r = 0;\n  word k1 = 1;\n} chain (word f, word a0) {\n  if(f < 0) { r = c_f(a0); } else { r = c_f(a0); }\n} return word r;\n")
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int f(int a) { return a; } int g(int a) { return a; }" (1, [0, 1]):() then prints:("==== FILE b/ax/bx/cx/dx/ex/fx/gx/hx/fa.id\ncrt_call1(word f, word a0) {\n  word k0 = 0;\n  word r = 0;\n  word k1 = 1;\n} chain (word f, word a0) {\n  if(f < 2) { r = c_f(a0); } else { r = c_g(a0); }\n} return word r;\n")

// The call text for fs[lo..hi), printing the function of an interior node first.
ind_node(int n, int[] fs, int lo, int hi, int top) {
  string call = ind_call(n, fs, lo, hi);
  if(hi - lo > 1) {
    ind_split(n, fs, lo, hi, top);
  }
} return string call;
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int f(int a) { return a; } int g(int a) { return a; }" (1, [0, 1], 0, 2, 1):("ind1_0_2(f, a0)") then prints:("==== FILE b/ax/bx/cx/dx/ex/fx/gx/hx/fa.id\ncrt_call1(word f, word a0) {\n  word k0 = 0;\n  word r = 0;\n  word k1 = 1;\n} chain (word f, word a0) {\n  if(f < 2) { r = c_f(a0); } else { r = c_g(a0); }\n} return word r;\n")
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int f(int a) { return a; } int g(int a) { return a; }" (1, [0, 1], 1, 2, 0):("c_g(a0)") then prints:("")

// A leaf is `c_NAME(a0, a1)`; an interior node `indN_lo_hi(f, a0, a1)`.
ind_call(int n, int[] fs, int lo, int hi) {
  string ar = ind_rest(n, "");
  string call = "ind" + n + "_" + lo + "_" + hi + "(f" + arg_sep(n) + ar + ")";
  if(hi - lo == 1) {
    call = "c_" + (import fnames)[fs[lo]] + "(" + ar + ")";
  }
} return string call;
given boot_a given boot_b given lexfix given tu_load given reach_all stdin "int f(int a) { return a; } int g(int a) { return a; }" (1, [0, 1], 0, 1):("c_f(a0)")
