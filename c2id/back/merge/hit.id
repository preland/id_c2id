// Replacing one call: the head's name, then `fp`, then the values this
// function had where the head took a parameter.

mg_call_edit(string mgline, int mgp, int mgq, string mgname, int[] mgst, string[] mgacc) {
  int mgf = hash_map_get((import mgznk), (import mgznv), (import mgznu), mgname, 0);
  int mgh = (import mgzfg)[mgf];
  string mgextra = mg_extra((import mgzfm)[mgh], (import mgzfl)[mgf]);
} chain (string mgline, int mgp, int mgq, string mgname, int[] mgst, string[] mgacc) {
  string mgcall = (import mgzfn)[mgh] + "(fp" + mgextra + ")";
  string mgjoined = mgacc[0] + str_sub(mgline, mgst[0], mgp - mgst[0]) + mgcall;
  string_list_set(mgacc, 0, mgjoined);
} chain (string mgline, int mgp, int mgq, string mgname, int[] mgst, string[] mgacc) {
  integer_list_set(mgst, 0, mgq + 4);
  integer_list_set(mgst, 1, mgq + 4);
} return string[] mgacc;
given mg_fixture ("  nxt = blk1_1(fp);", 8, 14, "blk1_1", [0, 0], [""]):(["  nxt = blk1_0(fp, 9, 5)"])
given mg_fixture ("  nxt = blk1_1(fp);", 8, 14, "blk1_1", [3, 0], ["A"]):(["Axt = blk1_0(fp, 9, 5)"])

mg_keep(string[] mgout, int mgi) {
  int mgres = 1;
  if(string_starts_with(mgout[mgi], "==== FILE ") == 1) {
    mgres = mg_has_body(mgout, mgi);
  }
} return int mgres;
(["==== FILE a", "x"], 0):(1)
(["==== FILE a", "==== FILE b"], 0):(0)
(["x"], 0):(1)

mg_has_body(string[] mgout, int mgi) {
  int mgres = 0;
  if(mgi + 1 < len(mgout) && string_starts_with(mgout[mgi + 1], "==== FILE ") == 0 && mgout[mgi + 1] != "") {
    mgres = 1;
  }
} return int mgres;
(["==== FILE a", "x"], 0):(1)
(["==== FILE a"], 0):(0)
(["==== FILE a", ""], 0):(0)
