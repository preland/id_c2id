// Replacing one call: the head's name, then `fp`, then the values this
// function had where the head took a parameter.

mg_call_edit(string[] mgpcs, int mgi, int mgend, string[] mgacc) {
  string mgnm = mg_raw(mgpcs, mgi, mgi + 1);
  int mgf = hash_map_get((import mgznk), (import mgznv), (import mgznu), mgnm, 0);
  int mgh = (import mgzfg)[mgf];
} chain (string[] mgpcs, int mgi, int mgend, string[] mgacc) {
  string mgextra = mg_extra((import mgzfm)[mgh], (import mgzfl)[mgf]);
  string mgargs = mg_raw(mgpcs, mgi + 2, mgend);
  string mgcall = (import mgzfn)[mgh] + "(" + mgargs + mgextra + ")";
} chain (string[] mgpcs, int mgi, int mgend, string[] mgacc) {
  string_list_set(mgacc, 0, mgacc[0] + mgcall);
} return string[] mgacc;
given mg_fixture (["tblk1_1", "t(", "tfp", "t)"], 0, 3, [""]):(["blk1_0(fp, 9, 5)"])
given mg_fixture (["tblk1_1", "t(", "tfp", "t,", "t ", "n2", "t)"], 0, 6, ["A"]):(["Ablk1_0(fp, 2, 9, 5)"])

mg_keep(string[] mgout, int mgi) {
  int mgres = 1;
  if(string_starts_with(mgout[mgi], "==== FILE ") == 1) {
    mgres = mg_has_body(mgout, mgi);
  }
} return int mgres;
(["==== FILE a", "x"], 0):(1)
(["==== FILE a", "==== FILE b"], 0):(0)
(["x"], 0):(1)

mg_has_body(string[] mgout, int mgi) {
  int mgres = 0;
  if(mgi + 1 < len(mgout) && string_starts_with(mgout[mgi + 1], "==== FILE ") == 0 && mgout[mgi + 1] != "") {
    mgres = 1;
  }
} return int mgres;
(["==== FILE a", "x"], 0):(1)
(["==== FILE a"], 0):(0)
(["==== FILE a", ""], 0):(0)
