// One merge pass over the text, for the one family of generated functions named
// by mgfam. The families are merged in the order they call each other (a `dsp`
// function calls `blk`s, a `run` calls `dsp`s), so that by the time a family's
// turn comes its callers' calls already name the survivors and functions that
// differed only in whom they called now differ only in literals.

mg_pass(string mgtext, string mgfam, string mgpfx) {
  mg_setup();
  mg_setup_c();
  mg_set_family(mgfam, mgpfx);
} chain (string mgtext, string mgfam, string mgpfx) {
  string[] mglines = string_split(mgtext, "\n");
  mg_refs(mglines);
  mg_collect(mglines);
} chain (string mgtext, string mgfam, string mgpfx) {
  mg_masks();
  string[] mgout = mg_emit_all(mglines);
  string[] mgkept = mg_trim(mgout);
} chain (string mgtext, string mgfam, string mgpfx) {
  string mgr = string_join(mgkept, "\n");
} return string mgr;
("==== FILE a.id\ndsp1_0(word fp, word pc) {\n  word nxt = 0 - 1;\n  if(pc < 1) { nxt = blk1_0(fp); } else { nxt = blk1_1(fp); }\n} return word nxt;\ndsp2_0(word fp, word pc) {\n  word nxt = 0 - 1;\n  if(pc < 3) { nxt = blk1_0(fp); } else { nxt = blk1_1(fp); }\n} return word nxt;\nrun1(word fp) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp1_0(fp, pc); }\n} return word pc;\nrun2(word fp) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp2_0(fp, pc); }\n} return word pc;\n", "dsp", "lv"):("==== FILE a.id\ndsp1_0(word fp, word pc, word lv2) {\n  word nxt = 0 - 1;\n  if(pc < lv2) { nxt = blk1_0(fp); } else { nxt = blk1_1(fp); }\n} return word nxt;\nrun1(word fp) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp1_0(fp, pc, 1); }\n} return word pc;\nrun2(word fp) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp1_0(fp, pc, 3); }\n} return word pc;\n")
("==== FILE a.id\nrun1(word fp) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp1_0(fp, pc); }\n  word r = peek64(fp + 8);\n} return word r;\nrun2(word fp) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp1_0(fp, pc); }\n  word r = peek64(fp + 16);\n} return word r;\nc_a(word a0) {\n  word r = run1(fp);\n} return word r;\nc_b(word a0) {\n  word r = run2(fp);\n} return word r;\n", "run", "lv"):("==== FILE a.id\nrun1(word fp, word lv2) {\n  word pc = 0;\n  while(pc >= 0) { pc = dsp1_0(fp, pc); }\n  word r = peek64(fp + lv2);\n} return word r;\nc_a(word a0) {\n  word r = run1(fp, 8);\n} return word r;\nc_b(word a0) {\n  word r = run1(fp, 16);\n} return word r;\n")
("==== FILE a.id\nblk1_0(word fp) {\n  word k0 = 0;\n  poke64(fp, 0x4000000000000000);\n} return word 3;\nblk1_1(word fp) {\n  word k1 = 1;\n  poke64(fp, 1);\n} return word 3;\n", "blk", "lv"):("==== FILE a.id\nblk1_0(word fp, word lv0) {\n  word k0 = 0;\n  poke64(fp, lv0);\n} return word 3;\n")
("==== FILE a.id\nc_die(word a0) {\n  word r = run62(fp, 288, 2);\n} return word r;\nc_quit(word a0) {\n  word r = run62(fp, 296, 5);\n} return word r;\nc_zero() {\n  word r = c_die(1);\n  word q = c_quit(2);\n} return word r;\n", "c_", "lv"):("==== FILE a.id\nc_die(word a0, word lv0, word lv1) {\n  word r = run62(fp, lv0, lv1);\n} return word r;\nc_zero() {\n  word r = c_die(1, 288, 2);\n  word q = c_die(2, 296, 5);\n} return word r;\n")
("==== FILE a.id\nc_a() {\n  word r = run1(fp, 8);\n} return word r;\nc_b() {\n  word r = run1(fp, 16);\n} return word r;\nc_c() {\n  word r = c_b();\n} return word r;\n", "c_", "lv"):("==== FILE a.id\nc_a(word lv0) {\n  word r = run1(fp, lv0);\n} return word r;\nc_c() {\n  word r = c_a(16);\n} return word r;\n")
