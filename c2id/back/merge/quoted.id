// The rest of the tokenizer: the end of a string literal, and whether a token
// is a plain whole number or a hex number (the only things the merge pass turns
// into a parameter; a float or a string must match exactly to merge).

mg_str_end(string mgtx, int mgi) {
  int mgc = character_code_at(mgtx, mgi);
  while(mgc >= 0 && mgc != 34) {
    if(mgc == 92) {
      mgi = mgi + 1;
    }
    mgi = mgi + 1;
    mgc = character_code_at(mgtx, mgi);
  }
  int mgres = mgi;
} chain (string mgtx, int mgi) {
  if(mgc == 34) {
    mgres = mgi + 1;
  }
} return int mgres;
("\"ab\" x", 1):(4)
("ab", 0):(2)
("a\\\"b\"", 0):(5)


mg_all_digits(string mgtk) {
  int mgi = 0;
  int mgok = 0;
  while(character_is_digit(character_code_at(mgtk, mgi)) == 1) {
    mgi = mgi + 1;
    mgok = 1;
  }
} chain (string mgtk) {
  if(character_code_at(mgtk, mgi) >= 0) {
    mgok = 0;
  }
} return int mgok;
("15"):(1)
("k25"):(0)
("1.5"):(0)
("0x1f"):(0)

mg_all_hex(string mgtk) {
  int mgi = 2;
  int mgok = 0;
  while(url_hex_value(character_code_at(mgtk, mgi)) >= 0) {
    mgi = mgi + 1;
    mgok = 1;
  }
} chain (string mgtk) {
  if(string_starts_with(mgtk, "0x") == 0 || character_code_at(mgtk, mgi) >= 0) {
    mgok = 0;
  }
} return int mgok;
("0x4000"):(1)
("0xFFFFFFFFFFFFFFFE"):(1)
("0x"):(0)
("0xzz"):(0)
("15"):(0)
