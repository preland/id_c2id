// Recording one block function: where it starts and ends, its name, the list of
// its numbers, and which earlier function (or itself) it has the same shape as.
// The shape-to-first-function table is the hash map mgk/mgv/mgu/mgc.

mg_func_end(string[] mglines, int mgi) {
  mgi = mgi + 1;
  while(mgi < len(mglines) && string_starts_with(mglines[mgi], "} return") == 0) {
    mgi = mgi + 1;
  }
} return int mgi;
