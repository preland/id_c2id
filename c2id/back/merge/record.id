mg_record(string[] mglines, int mgs, int mge) {
  string mgkey = mg_key(mglines, mgs, mge);
  string mglit = mg_func_text(mglines, mgs, mge, 1);
  string mgname = string_before(mglines[mgs], "(");
} chain (string[] mglines, int mgs, int mge) {
  int mgf = len((import mgzfs));
  mg_store(mgs, mge, mgname, mglit);
  mg_group(mgkey, mgname, mgf);
} return void;
