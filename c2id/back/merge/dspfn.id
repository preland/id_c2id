// Deciding one dispatch function: new (kept, its key remembered) or a repeat
// of an earlier one (dropped, its name mapped to the earlier name).

mg_dsp_fn(string[] mgdin, string[] mgdout, int mgi, string[] mgdrf, string[] mgdrt, string[] mgdks, string[] mgdns) {
  string mgdname = string_before(mgdin[mgi], "(");
  string mgdkey = mg_dsp_key(mgdin, mgi, mgdname, mgdrf, mgdrt);
  int mgdx = mg_dsp_find(mgdks, mgdkey);
} chain (string[] mgdin, string[] mgdout, int mgi, string[] mgdrf, string[] mgdrt, string[] mgdks, string[] mgdns) {
  if(mgdx >= 0) {
    push(mgdrf, mgdname);
    push(mgdrt, mgdns[mgdx]);
  } else {
    mgdout = mg_dsp_keep(mgdin, mgdout, mgi, mgdrf, mgdrt, mgdks, mgdns, mgdkey, mgdname);
  }
  int mgdnext = mgi + 4;
} return int mgdnext;
(["dsp1(word fp, word pc) {", "a", "b", "} return word nxt;"], [], 0, [], [], [], []):(4)
(["dsp2(word fp, word pc) {", "a", "b", "} return word nxt;"], [], 0, [], [], ["(word fp, word pc) {\na\nb"], ["dsp1"]):(4)

mg_dsp_key(string[] mgdin, int mgi, string mgdname, string[] mgdrf, string[] mgdrt) {
  string mgdh = string_replace(mgdin[mgi], mgdname, "");
  string mgdb = mg_dsp_fix(mgdin[mgi + 1], mgdrf, mgdrt);
  string mgdc = mg_dsp_fix(mgdin[mgi + 2], mgdrf, mgdrt);
} chain (string[] mgdin, int mgi, string mgdname, string[] mgdrf, string[] mgdrt) {
  string mgdkey = mgdh + "\n" + mgdb + "\n" + mgdc;
} return string mgdkey;
(["dsp1(a) {", "b", "c", "} return word nxt;"], 0, "dsp1", [], []):("(a) {\nb\nc")
(["dsp1(a) {", "k(dsp0(", "c", "} return word nxt;"], 0, "dsp1", ["dsp0"], ["dsp9"]):("(a) {\nk(dsp9(\nc")

mg_dsp_keep(string[] mgdin, string[] mgdout, int mgi, string[] mgdrf, string[] mgdrt, string[] mgdks, string[] mgdns, string mgdkey, string mgdname) {
  push(mgdks, mgdkey);
  push(mgdns, mgdname);
  mg_dsp_copy(mgdin, mgdout, mgi, mgdrf, mgdrt);
} return string[] mgdout;
(["h", "a", "b", "t"], [], 0, [], [], [], [], "k", "n"):(["h", "a", "b", "t"])
(["h", "a", "b", "t", "z"], ["q"], 0, [], [], [], [], "k", "n"):(["q", "h", "a", "b", "t"])
