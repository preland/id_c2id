// call_txt's two halves -- the callee name and the parenthesised argument
// list -- split out because id forbids nesting args_txt(l_of(id)) inside
// the concatenation that names the whole call.

call_head(int id) {
  string s = "crt_call" + len((import nl)[id]);
  int a = (import na)[id];
  if(direct_call(a) == 1) {
    s = callee_name((import ns)[a]);
  }
} chain (int id) {
  ind_note(id);
} return string s;
given txt_fixture (0):("crt_call0")
given txt_fixture (5):("crt_call0")

call_wrap(string s, int id) {
  int[] ids = (import nl)[id];
  string txt = call_args(ids, id);
  string out = name_val(s + "(" + txt + ")");
} return string out;
given txt_fixture given boot_b given pend_setup ("crt_call", 0):("t0")
given txt_fixture given boot_b given pend_setup ("c_foo", 5):("t0")

// s_of(id), read once and turned into the C operator it stands for.
assign_head(int id) {
  string op = (import ns)[id];
  string head = op_head(op);
} return string head;
given txt_fixture (0):("in")
given txt_fixture (5):("")
