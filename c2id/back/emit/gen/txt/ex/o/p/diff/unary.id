// The difference of two pointers, and the rest of the unary chain.

// p - q is a count of elements, so the byte difference is divided by the
// element size. Signed division, because ptrdiff_t is signed and q may be the
// later pointer.
ptr_diff(int id) {
  int sz = a_elem_sz(id);
  string s = diff_txt(kid_ex((import na), id), kid_ex((import nb), id));
  string out = scale_txt(s, sz, "/");
} return string out;
