given txt_fixture (1):("((NEEDS_CFG_prim - NEEDS_CFG_prim) / 4)")

un4(int id) {
  string s = "";
  if((import ns)[id] == "-" || (import ns)[id] == "~") {
    string op = (import ns)[id];
    string pre = pick_op(op, "0 - ", "~");
    s = neg_pick(id, pre);
  } else {
    s = incdec_txt(id);
  }
} return string s;
