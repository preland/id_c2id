// ucmp_txt's two pieces, split out because the operand order it decides
// and the final negation it hands off to ucmp_neg each nest calls that
// ucmp_txt has no room left to name.

ucmp_body(int id) {
  string s = "";
  if((import ns)[id] == ">" || (import ns)[id] == "<=") {
    string exb = kid_ex((import nb), id);
    string exa = kid_ex((import na), id);
    s = ult_txt(exb, exa);
  } else {
    string exa2 = kid_ex((import na), id);
    string exb2 = kid_ex((import nb), id);
    s = ult_txt(exa2, exb2);
  }
} return string s;
given txt_fixture given pend_setup (0):("t0")
given txt_fixture given pend_setup (5):("t0")

ucmp_final(string s, int id) {
  string op = (import ns)[id];
  string out = ucmp_neg(s, op);
} return string out;
given txt_fixture ("X", 0):("X")
given txt_fixture ("X", 5):("X")
