// A signed field is sign-extended from its own top bit: shifted up to the top of
// the word and arithmetically back down.
bfx_sign(string[] bfp, string bfw) {
  string bfz = bfw;
  if(bfp[5] == "s") {
    int up = 64 - to_int(bfp[4]);
    bfz = name_val("(" + bfw + " << " + up + ") >> " + up);
  }
} return string bfz;
