// A call that returns a struct or union is its result's address, the hidden
// argument's temporary, so `f().x` reads its member through it. Nothing else
// that is not an lvalue has one.
ad5(int id) {
  string s = "NOT_AN_LVALUE_" + (import nk)[id];
  int ty = ex_ty(id);
  if((import nk)[id] == "call" && ty_agg(ty) == 1) {
    s = ex_txt(id);
  }
} return string s;
