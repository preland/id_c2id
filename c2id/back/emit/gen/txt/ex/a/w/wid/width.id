// Widths. The store's primitives are named by bit count and C's types are
// measured in bytes, so every one of these is that one multiplication -- once,
// here, rather than in four spelled-out chains of peek8/peek16/peek32/peek64.

wid_bits(int w) {
  string s = "" + (w * 8);
} return string s;
(1):("8")
(8):("64")

// The access width for a C type. A struct or an array is never loaded whole
// -- lval_txt yields its address instead -- so anything that is not 1, 2 or 4
// bytes is treated as a machine word, which is right for every pointer, long
// and long long and harmless for the rest.
load_wid(int ty) {
  int w = type_size(ty);
  if(w != 1 && w != 2 && w != 4) {
    w = 8;
  }
} return int w;
given txt_fixture (4):(1)
given txt_fixture (2):(8)

// sx_bits for a signed type, zx_bits for an unsigned one, called with the width.
// This is the single most likely source of a silently wrong answer in the
// whole emitter: a missing sx_bits(v, 32) gives 4294967295 where C gives -1, and every
// small test still passes.
cvt_name(int ty) {
  string s = "zx_bits";
  if(ty_signed(ty) == 1) {
    s = "sx_bits";
  }
} return string s;
given txt_fixture (0):("sx_bits")
given txt_fixture (1):("zx_bits")
