// A 128-bit value (the text s) converted to the integer type `to`: "is not zero" for
// _Bool, otherwise its low word narrowed to the type.
wd_to(int to, string s) {
  string wout = "";
  if((import ns)[to] == "_Bool") {
    wout = wd_nz_txt(s);
  } else {
    wout = wd_low(to, s);
  }
} return string wout;
