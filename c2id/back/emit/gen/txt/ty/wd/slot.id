// The count of a shift: an integer of whatever type, or the low word of a 128-bit one.
wd_count(int wc) {
  int wk = wd_kind(ex_ty(wc));
  string wtx = ex_txt(wc);
  if(wk > 0) {
    wtx = name_val("peek64(" + wtx + ")");
  }
} return string wtx;
