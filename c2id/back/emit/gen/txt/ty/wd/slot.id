// The address of a 16-byte frame temporary of kind wk for a result (its slot grown
// into the frame now, the frame being final only once the function's blocks are
// printed), as ld_tmp makes one for a long double.
wd_tmp(int wk) {
  int wt = wd_ty(wk);
  int wp = new_temp(wt);
  int wa = newleaf("un", wp, 0, "&", "");
} chain (int wk) {
  string wst = ex_txt(wa);
} return string wst;
