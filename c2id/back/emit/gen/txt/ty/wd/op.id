wd_bin_txt(int id) {
  int wt = wd_opty(id);
  int wa = fl_coerce(wt, (import na)[id]);
  string wop = (import ns)[id];
} chain (int id) {
  string wsa = ex_txt(wa);
  string wsb = wd_right(id, wt);
  string wout = wd_op_txt(wt, wop, wsa, wsb);
} return string wout;
given txt_fixture given fl_fixture given wd_fixture given pend_setup given init_frame given init_frame2 given txt_reset (14):("t2")
