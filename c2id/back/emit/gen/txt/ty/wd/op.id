// The right operand's text: converted to the common type, or for a shift left alone
// as a count.
wd_right(int id, int wt) {
  string wsb = "";
  if((import ns)[id] == "<<" || (import ns)[id] == ">>") {
    wsb = wd_count((import nb)[id]);
  } else {
    wsb = wd_conv_right(id, wt);
  }
} return string wsb;
given txt_fixture given fl_fixture given wd_fixture given pend_setup given init_frame given init_frame2 given txt_reset (17, 10):("5")
