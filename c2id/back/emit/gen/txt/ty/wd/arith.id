wd_cmp_txt(int wt, int wk, string wsa, string wsb) {
  string wfn = "ci128_cmpu";
  if(ty_signed(wt) == 1) {
    wfn = "ci128_cmps";
  }
  string wout = name_val(wfn + "(" + wsa + ", " + wsb + ", " + wk + ")");
} return string wout;
