wd_arith(int wt, string wop, string wsa, string wsb) {
  string wfn = wd_fn(wt, wop);
  string wdst = wd_tmp(wd_kind(wt));
  string wout = name_val(wfn + "(" + wdst + ", " + wsa + ", " + wsb + ")");
} return string wout;
