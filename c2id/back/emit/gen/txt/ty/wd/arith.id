wd_op_txt(int wt, string wop, string wsa, string wsb) {
  int wk = find_str((import wd_cmp_ops), wop);
  string wout = "";
  if(wk >= 0) {
    wout = wd_cmp_txt(wt, wk, wsa, wsb);
  }
} chain (int wt, string wop, string wsa, string wsb) {
  if(wk < 0) {
    wout = wd_arith(wt, wop, wsa, wsb);
  }
} return string wout;
