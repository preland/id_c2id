// `-e` and `~e` on a 128-bit operand: crt/i128 negates or complements it into a
// temporary of its own. `!e` and a branch's condition ask whether it is zero.
wd_un_txt(int id) {
  string wsa = ex_txt((import na)[id]);
  string wfn = wd_unfn((import ns)[id]);
  int wk = wd_kind(ex_ty(id));
} chain (int id) {
  string wdst = wd_tmp(wk);
  string wout = name_val(wfn + "(" + wdst + ", " + wsa + ")");
} return string wout;
