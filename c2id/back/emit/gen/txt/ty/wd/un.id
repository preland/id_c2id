// `-e` or `~e`: a 128-bit operand is crt/i128's, any other the plain operator.
wd_pre_txt(int id, string pre) {
  string wout = "";
  if(wd_kind(ex_ty(id)) > 0) {
    wout = wd_un_txt(id);
  } else {
    wout = pre_txt(id, pre);
  }
} return string wout;
