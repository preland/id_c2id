// The type of a unary expression.
//
// `*p` is the pointee, `&x` is a pointer to whatever x is, `!e` is int
// whatever e is, and `- + ~ ++ --` all have their operand's promoted type --
// which is why `-c` on a char is an int, and why `-x` on an unsigned int
// wraps at 32 bits rather than becoming negative.

un_ty(int id) {
  int aty = kid_ty((import na), id);
  int ty = elem_ty(aty);
  if((import ns)[id] != "*") {
    ty = un_ty2(id);
  }
} return int ty;
given txt_fixture (0):(0) then calls un_ty2:(0)
given txt_fixture (5):(0) then calls un_ty2:(5)

// The `&` case builds a fresh ptr node. Lazily -- an eager arm here would
// allocate one on every unary operator in the program.
un_ty2(int id) {
  int ty = 0;
  if((import ns)[id] == "&") {
    int a = (import na)[id];
    int aty = ex_ty(a);
    ty = newleaf("ptr", aty, 0, "", "");
  } else {
    ty = un_ty3(id);
  }
} return int ty;
given txt_fixture (0):(0) then calls un_ty3:(0)
given txt_fixture (5):(0) then calls un_ty3:(5)

un_ty3(int id) {
  int aty = kid_ty((import na), id);
  int ty = promote_ty(aty);
  if((import ns)[id] == "!") {
    ty = (import stdty)[0];
  }
} return int ty;
