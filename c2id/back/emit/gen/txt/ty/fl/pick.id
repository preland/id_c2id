// The binary operators' first question after short-circuit: is a floating-point
// operand involved. If so the whole operator is crt's (fl_bin_txt); otherwise
// the integer and pointer rules decide (bin1).
bin_pick(int id) {
  string s = "";
  if(fl_is_bin(id) == 1) {
    s = fl_bin_txt(id);
  } else {
    s = bin1(id);
  }
} return string s;
