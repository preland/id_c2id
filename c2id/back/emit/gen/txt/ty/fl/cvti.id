fl_to_i(int to, string s) {
  string flv = "";
  if((import ns)[to] == "_Bool") {
    flv = name_val("cfl_ne(" + s + ", 0)");
  } else {
    flv = fl_to_i2(to, s);
  }
} return string flv;
