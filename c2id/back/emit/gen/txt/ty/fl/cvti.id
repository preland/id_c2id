fl_to_i2(int to, string s) {
  string fnm = "cfl_to_int(";
  if(type_size(to) == 8 && ty_signed(to) == 0) {
    fnm = "cfl_to_uint(";
  }
  string raw = name_val(fnm + s + ")");
} chain (int to, string s) {
  string flv = conv_txt(to, raw);
} return string flv;
