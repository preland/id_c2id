// The type two operands meet at when either is floating point: long double if
// either is, else double if either is, else float; -1 when neither is, and C's
// integer rules apply.
fl_join(int ka, int kb) {
  int r = 0 - 1;
  if(ka + kb > 0) {
    r = ty_float();
  }
  if(ka == 2 || kb == 2) {
    r = ty_double();
  }
} chain (int ka, int kb) {
  if(ka == 3 || kb == 3) {
    r = ty_ldbl();
  }
} return int r;
