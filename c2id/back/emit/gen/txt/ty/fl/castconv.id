// A cast from type `from` to type `to`: the width conversion unless a
// floating-point type is on either side, then fl_cvt's. A cast to void throws
// the value away and converts nothing.
cast_conv(int to, int from, string exa) {
  int kk = ty_fkind(to) + ty_fkind(from);
  string s = cast_pick(to, from, exa, kk);
} return string s;
given txt_fixture given pend_setup (0, 1, "t5"):("t0") then (import pend)[0]:("word t0 = sx32(t5);")
given txt_fixture given pend_setup given fl_types (0, 6, "t5"):("t1") then (import pend)[0]:("word t0 = cfl_to_int(t5);")

cast_pick(int to, int from, string exa, int kk) {
  string s = "";
  if(kk == 0) {
    s = conv_txt(to, exa);
  } else {
    s = cast_fl(to, from, exa);
  }
} return string s;
given txt_fixture given pend_setup (0, 1, "t5", 0):("t0")
given txt_fixture given pend_setup given fl_types (6, 0, "t5", 2):("t0")

cast_fl(int to, int from, string exa) {
  string s = exa;
  if(fl_skip(to) == 0) {
    s = fl_cvt(to, from, exa);
  }
} return string s;
