// A struct or union is returned by copying it through the hidden first
// parameter, which is at fp + 8; c_memcpy answers its destination, so the text
// of the result is the pointer, and that is what the end block stores at fp + 0.
ret_conv(int rt, string txt) {
  string out = conv_txt(rt, txt);
  if(ty_agg(rt) == 1) {
    out = ret_copy(rt, txt);
  }
} return string out;
