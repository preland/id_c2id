fl_make() {
  int d = newleaf("prim", 8, 1, "double", "");
  int f = newleaf("prim", 4, 1, "float", "");
  lset((import fltys), 1, d);
} chain () {
  lset((import fltys), 2, f);
  lset((import fltys), 0, 1);
} return void;
