given txt_fixture given pend_setup given fl_types given ldt_types (6, 8, "t5", 2, 3):("t0") then (import pend)[0]:("word t0 = ld_nar(t5, 53, 0 - 1022);")
given txt_fixture given pend_setup given ldt_types (6, 6, "t5", 3, 3):("t5")

ld_ofname(int from, int kf) {
  string fnm = "cld_of_int";
  if(kf > 0) {
    fnm = "cld_of_dbl";
  }
  if(kf == 0 && type_size(from) == 8 && ty_signed(from) == 0) {
    fnm = "cld_of_uint";
  }
} return string fnm;
given txt_fixture (0, 0):("cld_of_int")
given txt_fixture (3, 0):("cld_of_uint")
given txt_fixture (0, 2):("cld_of_dbl")
