fl_bin_txt(int id) {
  int ta = kid_ty((import na), id);
  int tb = kid_ty((import nb), id);
  int rt = fl_pair(ta, tb);
} chain (int id) {
  int ca = fl_coerce(rt, (import na)[id]);
  int cb = fl_coerce(rt, (import nb)[id]);
  string fnm = fl_opname((import ns)[id]);
} chain (int id) {
  string sa = ex_txt(ca);
  string sb = ex_txt(cb);
  string s = name_val(fnm + "(" + sa + ", " + sb + ")");
} chain (int id) {
  string out = fl_round(id, s);
} return string out;
