fl_bin_txt(int id) {
  int ta = kid_ty((import na), id);
  int tb = kid_ty((import nb), id);
  int rt = fl_pair(ta, tb);
} chain (int id) {
  string out = fl_bin_pick(id, rt);
} return string out;
