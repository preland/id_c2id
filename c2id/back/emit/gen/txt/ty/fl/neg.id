// -x: cfl_neg flips a double's sign bit; a long double's is flipped into a
// temporary of its own (cld_neg).
fl_neg_pick(int ty, string flex) {
  string s = "";
  if(ty_fkind(ty) == 3) {
    s = ld_neg_txt(flex);
  } else {
    s = name_val("cfl_neg(" + flex + ")");
  }
} return string s;
