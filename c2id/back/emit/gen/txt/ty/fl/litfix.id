fl_norm(string raw) {
  int n = fl_blen(raw);
  string flbody = str_sub(raw, 0, n);
  string out = fl_fix(flbody);
} return string out;
("1.5f"):("1.5")
(".5"):("0.5")

fl_fix(string flbody) {
  string out = flbody;
  if(character_code_at(flbody, 0) == 46) {
    out = "0" + flbody;
  }
  int fldot = string_find(out, ".");
} chain (string flbody) {
  if(fldot >= 0 && fl_digit_at(out, fldot + 1) == 0) {
    out = fl_ins0(out, fldot);
  }
} return string out;
("5."):("5.0")
("1.e5"):("1.0e5")
("2.5e3"):("2.5e3")

fl_ins0(string flbody, int fldot) {
  int n = len(flbody) - fldot - 1;
  string flhead = str_sub(flbody, 0, fldot + 1);
  string flrest = str_sub(flbody, fldot + 1, n);
} chain (string flbody, int fldot) {
  string out = flhead + "0" + flrest;
} return string out;
("5.", 1):("5.0")
("1.e5", 1):("1.0e5")

