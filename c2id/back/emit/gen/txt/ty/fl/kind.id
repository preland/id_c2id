// Floating point, as the emitter sees it. A C `double` is an 8-byte slot and a
// `float` a 4-byte one, but in an expression both are the same thing: a `word`
// holding the bits of an IEEE binary64 (a float's value is rounded to binary32
// first, so it is always one a binary32 holds). Arithmetic on those words is
// done by crt/flt, which turns them into id floats and back; loading and
// storing a `float` converts between the 4-byte slot and that word.
//
// ty_fkind: 0 for a type that is not floating point, 1 for float, 2 for double.
// 3 for long double, which is not a word: its value in an expression is the
// address of its 16 bytes, as a struct's is (ty_agg), and crt/ldbl does its
// arithmetic on those addresses.
fk_of(string fkn) {
  int k = 0;
  if(fkn == "float") {
    k = 1;
  }
  if(fkn == "double") {
    k = 2;
  }
} chain (string fkn) {
  if(fkn == "long double") {
    k = 3;
  }
} return int k;
("float"):(1)
("double"):(2)
("long double"):(3)
("int"):(0)

ty_fkind(int ty) {
  int k = 0;
  if((import nk)[ty] == "prim") {
    string fkn = (import ns)[ty];
    k = fk_of(fkn);
  }
} return int k;
given txt_fixture given fl_types (6):(2)
given txt_fixture given fl_types (7):(1)
