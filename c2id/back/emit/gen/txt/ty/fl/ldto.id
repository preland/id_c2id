ld_to(int to, int kt, string s) {
  string out = "";
  if(kt == 0) {
    out = ld_toi(to, s);
  } else {
    out = name_val(pick_when(kt, 2, "cld_to_dbl", "cld_to_flt") + "(" + s + ")");
  }
} return string out;
