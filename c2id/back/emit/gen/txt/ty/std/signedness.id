// The rest of stdty, and the signedness question every operator asks.

// Cell ty_k of stdty. Its call sites name the cell with std_long, std_ulong or std_charp (conf.id); the cases
// read the cells back by number.
ty_std(int ty_k) {
  int ty = (import stdty)[ty_k];
} return int ty;
given txt_fixture (3):(3) then ty_std(4):(5)
given txt_fixture (4):(5) then ty_std(2):(2)
given txt_fixture (2):(2) then ty_std(3):(3)

// 1 when C's signed operators are the right ones for `ty`. A pointer, an
// array and a record are all "not signed": nothing divides or shifts them,
// and comparing two pointers is an unsigned comparison, which is what
// falling through to 0 here gives.
ty_signed(int ty) {
  int ok = 0;
  if((import nk)[ty] == "prim") {
    ok = (import nb)[ty];
  }
} return int ok;
given txt_fixture (0):(1)
given txt_fixture (1):(0)
