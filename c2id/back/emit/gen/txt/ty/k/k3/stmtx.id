// A statement expression has the type of its last statement's expression, and
// is plain `int` (node 0, as for any node nothing claims) when that is not an
// expression statement.
sx_ty(int id) {
  int[] sl = (import nl)[id];
  int ty = 0;
  if(len(sl) > 0) {
    ty = sx_last(sl[len(sl) - 1]);
  }
} return int ty;
