// The true edge and the close, split out because assigning it is three actions
// once the successor has been named.

emit_cond3(int b, string txt) {
  int dest = (import bsa)[b];
  int blk = thread_blk(dest);
  emit_out("  if(" + txt + ") { nxt = " + blk + "; }");
} chain (int b, string txt) {
  emit_cut("} return word nxt;");
} return void;
