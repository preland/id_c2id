// The check pass runs only on a program the parser accepted, and emission only
// on one nothing was refused in: a refused program writes nothing.
settle() {
  if(diag_status() == 0) {
    chk_all();
  }
  if(diag_status() == 0) {
    emit_all();
  }
} return void;
