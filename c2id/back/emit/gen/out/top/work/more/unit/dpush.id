// Recording a declaration's row: name, type node, initializer node or -1, and
// the storage offset of a variable or -1.
tu_dpush(string name, int r, int a) {
  push((import dnames), name);
  push((import dtys), r);
  push((import dinit), a);
} chain (string name, int r, int a) {
  int off = gl_alloc(r);
  push((import goff), off);
} return void;
given init_tu given tynode_fix ("x", 0, -1):() then len((import dnames)):(1)
given init_tu given tynode_fix ("y", 0, 3):() then (import dinit)[0]:(3)

tu_drealloc(int k, int r) {
  int off = gl_alloc(r);
  lset((import goff), k, off);
} return void;
given init_tu given tynode_fix given tu_dadd("x", 0, -1) (0, 3):() then (import goff)[0]:(4)
