// The order the whole run happens in: parse every external declaration, then
// check what was reached, and emit only what nothing refused.
drive() {
  tu_load();
  reach_all();
  settle();
} return void;
given boot_a given boot_b given lexfix stdin "int x;" ():() then calls parse_one:[1]
given boot_a given boot_b given lexfix stdin "" ():() then calls parse_one:[0]

tu_decl2(int[] pos, int t, int bare) {
  if(bare > 0) {
    advance(pos);
  } else {
    tu_list(pos, t);
  }
} return void;
given boot_a given boot_b given lexfix stdin ";" ([0], 0, 1):([1])
given boot_a given boot_b given lexfix stdin "x;" ([0], 0, 0):() then calls tu_list:[1]

// The declarators of one declaration: `int a, *b, f(void);`.
tu_list(int[] pos, int t) {
  int more = 1;
  while(more == 1) {
    more = tu_one(pos, t);
  }
} return void;
given boot_a given boot_b given lexfix stdin "x;" ([0], 0):() then calls tu_one:[1]
given boot_a given boot_b given lexfix stdin "x, y;" ([0], 0):() then calls tu_one:[2]
