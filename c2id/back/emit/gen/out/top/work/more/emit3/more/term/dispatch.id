// How a block ends. Three terminators, and each has one shape (cfg/README.md).
// A condition that is a literal -- `while (1)` -- always takes one edge, so it
// is emitted as the jump it is; `if(1)` would make a block whose result is a
// constant.

emit_term(int b) {
  if(jump_like(b) == 1) {
    emit_jump(b);
  } else {
    emit_term2(b);
  }
} return void;
given init_gfn given cfg_body_fixture (0):() then calls emit_term2:(0)
given init_gfn given cfg_body_fixture (1):() then calls emit_term2:(1)

emit_term2(int b) {
  if((import bkind)[b] == "end") {
    emit_end(b);
  } else {
    emit_cond(b);
  }
} return void;
given init_gfn given cfg_body_fixture (0):() then calls emit_end:(0)
given init_gfn given cfg_body_fixture (1):() then calls emit_end:(1)

emit_end(int b) {
  int e = (import bex)[b];
  emit_ret(e);
  emit_out("  word nxt = 0 - " + ((import gfn)[0] + 1) + ";");
} chain (int b) {
  emit_cut("} return word nxt;");
} return void;
given init_gfn given cfg_body_fixture (0):() then prints:("  poke64(fp, 0);\n  word nxt = 0 - 1;\n} return word nxt;\n")
given init_gfn given cfg_body_fixture (1):() then calls emit_ret:(-1)
