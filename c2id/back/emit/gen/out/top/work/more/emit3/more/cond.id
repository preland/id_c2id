// A two-way branch, written as the false edge assigned first and the true edge
// assigned over it, so the block stays straight-line and one level deep.

// A return with no value still stores 0, the same store a bare `return;`
// statement emits, so an end block always does something.
emit_ret(int e) {
  string txt = ret_text(e);
  flush_pend();
  emit_out("  poke64(fp, " + txt + ");");
} return void;
given txt_fixture given pend_setup (0):() then prints:("  word t0 = sx32(NEEDS_CFG_prim);\n  poke64(fp, t0);\n")
given txt_fixture given pend_setup (-1):() then prints:("  poke64(fp, 0);\n")

emit_cond(int b) {
  int e = (import bex)[b];
  string txt = cond_val(e);
  emit_cond2(b, txt);
} return void;
given txt_fixture given pend_setup given cond_body_fixture (0):() then prints:("  word nxt = 3;\n  if(1) { nxt = 3; }\n} return word nxt;\n")
given txt_fixture given pend_setup given cond_body_fixture (0):() then calls emit_cond2:(0, "1")

emit_cond2(int b, string txt) {
  flush_pend();
  int alt = (import bsb)[b];
  emit_cond_alt(b, txt, alt);
} return void;
given pend_setup given cond_body_fixture (0, "1"):() then calls emit_cond_alt:(0, "1", 2)
given pend_setup given cond_body_fixture (0, "x"):() then prints:("  word nxt = 3;\n  if(x) { nxt = 3; }\n} return word nxt;\n")
