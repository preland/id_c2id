// A block that always goes to one place: a "jmp", or a "cond" on a literal.

jump_like(int b) {
  int ok = 0;
  if((import bkind)[b] == "jmp") {
    ok = 1;
  } else {
    ok = num_cond(b);
  }
} return int ok;
