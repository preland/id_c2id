// Recording a declaration of any kind (a definition counts too). A variable
// already declared keeps its row, which the later declaration updates.
tu_dadd(string name, int r, int a) {
  int k = find_str((import dnames), name);
  int dup = tu_dmerge(k, r, a);
  if(dup == 0) {
    tu_dpush(name, r, a);
  }
} return void;
