// The subject of a switch is evaluated once. The dispatch chain tests it against
// each case in a block of its own, and a subject that is more than a name or a
// number (`switch (next())`, `switch (i++)`, `switch (setjmp(env))`) would be
// evaluated again for every test, so it is lowered once here, in the block the
// switch is entered from, into a frame temporary the tests read.
sw_subject(int id) {
  int a = (import na)[id];
  if(kind_either(a, "var", "num") == 0) {
    sw_once(id, a);
  }
} return void;
