// The rest of the globals. curb is a one-element list rather than a scalar
// because only the declaring function may assign an exported scalar, and the
// current block is moved by half the walker.

init_cfg2() {
  export int[] bsb = [];
  export int[] bex = [];
  export int[] curb = [0];
} return void export curb;
():() then cur_blk:(0)
():() then len((import bsb)):(0)
():() then eprints:("")

init_cfg3() {
  export int[] btgt = [];
  export int[] ctgt = [];
  export string[] lbls = [];
} return void;
():() then len((import btgt)):(0)
():() then len((import lbls)):(0)
():() then prints:("")
():() then eprints:("")

init_cfg4() {
  export int[] labb = [];
  export string[] fixs = [];
  export int[] fixb = [];
} return void;
():() then len((import labb)):(0)
():() then len((import fixs)):(0)
():() then prints:("")
():() then eprints:("")
