// Where a global variable lives. Globals share one region of the flat store,
// `gbase`, allocated once at start-up; a global is `gbase + off`, and off is
// laid out here as each declaration is read, the way a struct's members are:
// each aligned to its own type, in declaration order. A function has no
// storage, so its offset is -1.
gl_alloc(int r) {
  int off = 0 - 1;
  if((import nk)[r] != "fn") {
    off = gl_take(r);
  }
} return int off;
