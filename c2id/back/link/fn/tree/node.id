// One interior node of the dispatch tree.
emit_dsp(string tnm, int cut, string lnm, string rnm) {
  emit_mark();
  print(tnm + "(word fp, word pc) {");
  print("  word nxt = 0 - 1;");
} chain (string tnm, int cut, string lnm, string rnm) {
  print("  if(pc < " + cut + ") { nxt = " + lnm + "; } else { nxt = " + rnm + "; }");
  print("} return word nxt;");
} return void;
