// The runner: start at the first live block and follow the answers until one
// says -1. Blocks return here rather than tail-calling each other, so a loop of
// any length runs in constant stack. `chk` is 1 for a function that may exit,
// whose runner looks at the exit status before each block; the runner of any
// other function cannot be stopped by one, and does not look.
emit_run(int fn, string root, int first, int chk) {
  emit_mark();
  print("run" + fn + "(word fp) {");
  print("  word pc = " + first + ";");
} chain (int fn, string root, int first, int chk) {
  string cond = run_cond(chk);
  print("  while(" + cond + ") { pc = " + root + "; }");
  print("  word r = peek64(fp);");
} chain (int fn, string root, int first, int chk) {
  print("} return word r;");
} return void;
