// `word a0, word a1`
wrap_params(int np) {
  string out = "";
  int i = 0;
  while(i < np) {
    out = out + sep_before(i, ", ") + "word a" + i;
    i = i + 1;
  }
} return string out;
(0):("")
(2):("word a0, word a1")

wrap_args(int np, int fn) {
  int i = 0;
  while(i < np) {
    int wk = wrap_kind(fn, i);
    wrap_arg(fn, i, wk);
    i = i + 1;
  }
  wrap_sret(fn);
} return void;
