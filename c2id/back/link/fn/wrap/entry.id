// The wrapper other code calls: `c_NAME(a0, a1, ...)` takes a frame off the
// stack, stores the arguments in the parameter slots (8 bytes each, from fp +
// 8), runs the function, gives the frame back and answers fp + 0.
emit_wrap(int fn, string name, int np, int sz) {
  string plist = wrap_params(np);
  emit_mark();
  emit_head(plist, "c_" + name + "(" + plist + ") {");
} chain (int fn, string name, int np, int sz) {
  emit_out("  word fp = rt_enter(" + sz + ");");
  wrap_args(np);
  emit_out("  word r = run" + fn + "(fp);");
} chain (int fn, string name, int np, int sz) {
  emit_out("  rt_leave(" + sz + ");");
  emit_cut("} return word r;");
} return void;
given init_gfn (0, "f", 0, 8):() then prints:("==== FILE b/ax/bx/cx/dx/ex/fx/gx/hx/fa.id\nc_f() {\n  word k0 = 0;\n  word fp = rt_enter(8);\n  word r = run0(fp);\n} chain () {\n  word k1 = 1;\n  rt_leave(8);\n} return word r;\n")
given init_gfn (2, "g", 2, 24):() then prints:("==== FILE b/ax/bx/cx/dx/ex/fx/gx/hx/fa.id\nc_g(word a0, word a1) {\n  word k0 = 0;\n  word fp = rt_enter(24);\n  poke64(fp + 8, a0);\n} chain (word a0, word a1) {\n  word k1 = 1;\n  poke64(fp + 16, a1);\n  word r = run2(fp);\n} chain (word a0, word a1) {\n  word k2 = 2;\n  rt_leave(24);\n} return word r;\n")

// `word a0, word a1`
wrap_params(int np) {
  string out = "";
  int i = 0;
  while(i < np) {
    out = out + arg_sep(i) + "word a" + i;
    i = i + 1;
  }
} return string out;
(0):("")
(2):("word a0, word a1")

wrap_args(int np) {
  int i = 0;
  while(i < np) {
    emit_out("  poke64(fp + " + (8 + 8 * i) + ", a" + i + ");");
    i = i + 1;
  }
} return void;
