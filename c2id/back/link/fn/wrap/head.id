// The first line of every segment of a generated function: a local holding a
// number no other segment in the program holds. id rejects two functions with
// the same logic, and weighs each segment of a chain on its own, so a segment
// that happens to repeat another's (two blocks that load the same locals) would
// fail the build; this is the literal that tells them apart. It costs one of the
// segment's three actions.
emit_tag() {
  int t = (import tagn)[0];
  print("  word k" + t + " = " + t + ";");
  integer_list_set((import tagn), 0, t + 1);
} chain () {
  integer_list_set((import obn), 0, 1);
} return void;
