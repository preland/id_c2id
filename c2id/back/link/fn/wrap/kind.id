// How a parameter is passed: its floating-point kind (ty_fkind), or 3 for a
// struct or union, whose argument is the address of the caller's object.
wrap_ty_kind(int ty) {
  int k = ty_fkind(ty);
  if((import nk)[ty] == "rec") {
    k = 3;
  }
} return int k;
given tynode_fix (5):(3)
given tynode_fix (0):(0)

// The size of the struct or union that parameter i of function fn is.
wrap_rsz(int fn, int i) {
  int[] tys = (import nl)[(import ftys)[fn]];
  int rsz = type_size(tys[i]);
} return int rsz;
