// The end of a wrapper: the extra arguments of a variadic function are given
// back first, because they were taken from the stack after its frame, then the
// frame itself.
wrap_end(int fn, int sz) {
  if(fn_variadic(fn) == 1) {
    emit_out("  rt_va_drop(va);");
  }
  emit_out("  rt_leave(" + sz + ");");
} return void;
given boot_a given boot_b given lexfix given tu_load given init_gfn stdin "int f(int a, ...) { return a; }" (0, 24):() then prints:("  rt_va_drop(va);\n  rt_leave(24);\n")
given boot_a given boot_b given lexfix given tu_load given init_gfn stdin "int f(int a) { return a; }" (0, 24):() then prints:("  rt_leave(24);\n")

// The hidden last parameter of a function defined with `...`: `char *__va`, in
// the slot after the named ones. stdarg.h's va_start reads it.
bind_va(int ft) {
  if((import nb)[ft] == 1) {
    bind_param("__va", ty_charp());
  }
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "int f(int a, ...) { return a; }" (8):() then (import lvnames):(["__va"]) then (import lvtys)[0]:(5)
given boot_a given boot_b given lexfix given tu_load stdin "int f(int a) { return a; }" (9):() then len((import lvnames)):(0)
