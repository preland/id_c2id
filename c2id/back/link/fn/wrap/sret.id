// A function that returns a struct or union answers its hidden first argument,
// stored at fp + 0 as the frame is made: a callee that exits before it returns
// leaves the caller a pointer to its own temporary rather than 0.
wrap_sret(int fn) {
  int rets = sret_fn(fn);
  if(rets == 1) {
    emit_out("  poke64(fp, a0);");
  }
} return void;
given boot_a given boot_b given lexfix given tu_load given init_gfn stdin "struct Q { int c; }; struct Q f(int a) { struct Q q; return q; }" (0):() then prints:("  poke64(fp, a0);\n")
given boot_a given boot_b given lexfix given tu_load given init_gfn stdin "long double f(int a) { long double q = a; return q; }" (0):() then prints:("  poke64(fp, a0);\n")
given boot_a given boot_b given lexfix given tu_load given init_gfn stdin "int f(int a) { return a; }" (0):() then prints:("")

sret_fn(int fn) {
  int rets = 0;
  if(fn < len((import ftys))) {
    int rt = fn_ret((import ftys)[fn]);
    rets = ty_agg(rt);
  }
} return int rets;
