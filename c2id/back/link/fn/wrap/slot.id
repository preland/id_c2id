// Where each parameter lives in the callee's frame. A scalar takes a whole
// 8-byte slot from fp + 8; a struct or union passed by value takes its own size
// rounded up to 8 bytes, the wrapper copying the caller's object into it.

par_slot(int ty) {
  int sz = 8;
  if(ty_agg(ty) == 1) {
    sz = align_up(type_size(ty), 8);
  }
} return int sz;
