// The offset of parameter i of function fn; a function with no type on record
// (a fixture's) has only 8-byte slots.
wrap_off(int fn, int i) {
  int off = 8 + 8 * i;
  if(fn < len((import ftys))) {
    off = par_off((import ftys)[fn], i);
  }
} return int off;
