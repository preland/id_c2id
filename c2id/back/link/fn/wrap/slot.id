par_off(int ft, int i) {
  int[] tys = (import nl)[ft];
  int off = 8;
  int j = 0;
} chain (int ft, int i) {
  while(j < i) {
    off = off + par_slot(tys[j]);
    j = j + 1;
  }
} return int off;
