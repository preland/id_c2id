// `argc, rv, 0` for as many parameters as main declares: argc and argv are the
// process's own, the rest null.
main_args(int np) {
  string out = "";
  if(np == 1) {
    out = "argc";
  }
  if(np > 1) {
    out = "argc, rv" + str_repeat(", 0", np - 2);
  }
} return string out;
