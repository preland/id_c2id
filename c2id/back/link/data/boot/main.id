// How many parameters the C program's main declares, 0 when it has none, -1 when the
// unit has no main.
main_np() {
  int i = find_str((import dnames), "main");
  int np = 0 - 1;
  if(i >= 0) {
    np = len((import nl)[(import dtys)[i]]);
  }
} return int np;
