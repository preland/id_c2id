// The generated program's entry point. id calls `main`; this runs the runtime's
// start-up, the global initializers, and the C program's own `main` through its
// wrapper, then answers the exit status.
emit_main(int gtot, int np) {
  emit_mark();
  emit_head("int argc, string[] argv", "main(int argc, string[] argv) {");
  emit_out("  rt_boot(" + gtot + ");");
} chain (int gtot, int np) {
  emit_out("  c_globals();");
  emit_out("  word rv = rt_args(argc, argv);");
  emit_out("  word r = " + main_call(np) + ";");
} chain (int gtot, int np) {
  emit_atexit();
  emit_out("  int rc = rt_status(r);");
  emit_out("  flush();");
} chain (int gtot, int np) {
  emit_cut("} return int rc;");
} return void;
