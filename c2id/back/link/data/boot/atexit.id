// Functions registered with atexit run after main returns and after exit() has
// been called. stdlib.h keeps the table and the loop that runs it
// (__c2id_atexit_run); a program that reaches atexit reaches the loop too. The
// runners stop at once while an exit status is held, so the status is set aside
// while the handlers run and put back after, unless a handler exited itself.
emit_atexit() {
  if(atexit_hooked() == 1) {
    emit_out("  word rxs = rt_atexit_begin();");
    emit_out("  c___c2id_atexit_run();");
    emit_out("  rt_atexit_end(rxs);");
  }
} return void;
