// The initializer of each global variable, as statements queued for c_globals:
// every global starts zeroed (the region came from alloc), so only an explicit
// initializer, or one of the three standard streams, has anything to store.
emit_ginits() {
  int i = 0;
  while(i < len((import dnames))) {
    emit_ginit(i);
    i = i + 1;
  }
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "int x = 5; int y = 6;" ():() then (import pend):(["poke32((import gbase) + 0, 5);", "poke32((import gbase) + 4, 6);"])
given boot_a given boot_b given lexfix given tu_load stdin "int stdout; int y;" ():() then (import pend):(["poke64((import gbase) + 0, 1);"])

emit_ginit(int i) {
  int off = (import goff)[i];
  if(off >= 0 && g_reached(i) == 1) {
    init_global(i, off);
  }
} return void;
