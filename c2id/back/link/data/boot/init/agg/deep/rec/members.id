init_rec(int ty, string addr, int ex, int zf) {
  zero_fill(ty, addr, zf);
  int[] items = (import nl)[ex];
  init_members(ty, addr, items);
} return void;
given boot_a given boot_b given lexfix given tu_load stdin "struct P { int a; int b; }; struct P p = { 3, 4 };" (6, "A", 11, 0):() then (import pend):(["poke32(A, 3);", "poke32(A + 4, 4);"])
