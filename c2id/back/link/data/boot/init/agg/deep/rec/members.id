// Member k of the record, or the one a `.name =` designator names.
init_member(int ty, string addr, int[] items, int j, int k) {
  int kk = skip_unnamed(ty, k);
  int it = items[j];
  int row = member_row(ty, it, kk);
} chain (int ty, string addr, int[] items, int j, int k) {
  int val = item_val(it);
  init_stmts((import syids)[row], member_at(row, addr), val, 0);
  int nxt = kk + 1;
} return int nxt;
