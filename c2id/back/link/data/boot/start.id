// The last thing emitted: c_globals (the string literals and the initializers
// of the global variables) and main. Both need the final size of the global
// region, which is only known once every function has been emitted and every
// literal interned, so they come after all of them.
emit_boot() {
  txt_reset();
  emit_ginits();
  int gtot = align_up((import gsz)[0], 8);
} chain () {
  emit_globals(gtot);
  int np = main_np();
  emit_main(gtot, np);
} return void;
