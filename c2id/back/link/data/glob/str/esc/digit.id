// The index after up to `most` digits of `radix` starting at raw[i].
scan_run(string raw, int i, int radix, int most) {
  int j = i;
  while(j < len(raw) && j - i < most && digit_at(raw, j, radix) == 1) {
    j = j + 1;
  }
} return int j;

digit_at(string raw, int j, int radix) {
  int dc = charat(raw, j);
  int d = dig_val(dc);
  int ok = d >= 0 && d < radix;
} return int ok;
