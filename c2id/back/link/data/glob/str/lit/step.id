// One step of the scan: a plain character is copied, an escape is decoded.
// Answers the index to continue from.
lit_step(string raw, string[] acc, int i) {
  int c = character_code_at(raw, i);
  int j = lit_next(raw, acc, i, c);
} return int j;
("\"ab\"", ["\""], 1):(2) then calls lit_put:(["\"a"], 97)
("\"a\\nb\"", ["\"a"], 2):(4) then calls lit_esc:("\"a\\nb\"", ["\"a\" + chr(10) + \""], 2)

lit_next(string raw, string[] acc, int i, int c) {
  int j = i + 1;
  if(c == 92) {
    j = lit_esc(raw, acc, i);
  } else {
    lit_put(acc, c);
  }
} return int j;
("\"ab\"", ["\""], 1, 97):(2) then calls lit_put:(["\"a"], 97)
("\"a\\nb\"", ["\"a"], 2, 92):(4) then calls lit_esc:("\"a\\nb\"", ["\"a\" + chr(10) + \""], 2)

lit_put(string[] acc, int c) {
  string piece = acc[0] + chr(c);
  if(c != 34) {
    string_list_set(acc, 0, piece);
  }
} return void;
(["\""], 97):(["\"a"], 97)
(["\"a"], 98):(["\"ab"], 98)
(["\"a"], 34):(["\"a"], 34)
