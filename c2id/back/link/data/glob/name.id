// How the emitter sees a name that is not a local: a global variable (its
// address is `gbase` plus the offset gl_alloc gave it) or, failing that, `g_NAME`,
// a name no generated project defines, so an undeclared name fails the build
// rather than computing something.
glob_addr(string name) {
  int i = find_str((import dnames), name);
  string s = "g_" + name;
  if(i >= 0) {
    s = "(import gbase) + " + (import goff)[i];
  }
} chain (string name) {
  if(i >= 0 && (import goff)[i] < 0) {
    s = "" + (find_str((import fnames), name) + 1);
  }
} return string s;

// Its type: what the declaration said, and `int` for a name never declared,
// which is what C itself assumes.
glob_ty(string name) {
  int i = find_str((import dnames), name);
  int ty = (import stdty)[0];
  if(i >= 0) {
    ty = (import dtys)[i];
  }
} return int ty;

// The tables of everything declared at file scope and of the string literals:
// dnames/dtys/dinit hold each declaration's name, type node and initializer
// node (or -1), goff its storage offset in the global region (-1 for a
// function), gsz the region's size so far; slits/soff the interned literals and
// the offset of each one's pointer slot.
gl_setup() {
  export string[] dnames = [];
  export int[] dtys = [];
  export int[] dinit = [];
} chain () {
  export int[] goff = [];
  export int[] gsz = [0];
  export string[] slits = [];
} chain () {
  export int[] soff = [];
  export int[] lcnt = [0];
  export int[] reach = [];
} chain () {
  export int[] rwork = [];
  export string[] envo = [];
  export string[] envn = [];
} return void export dnames;
