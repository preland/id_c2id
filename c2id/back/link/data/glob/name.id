// The tables of everything declared at file scope and of the string literals:
// dnames/dtys/dinit hold each declaration's name, type node and initializer
// node (or -1), goff its storage offset in the global region (-1 for a
// function), gsz the region's size so far; slits/soff the interned literals and
// the offset of each one's pointer slot; fstat holds 1 for each function defined
// `static` (parallel to fnames), fsk the flag of the definition being read; gst
// holds 1 for each row of dnames declared `static`, and greach 1 for each global
// the program can reach (mid/pass/reach): a static one nothing names is dropped;
// indn[n] is 1 once a call through a pointer with n arguments has been written.
gl_setup() {
  export string[] dnames = [];
  export int[] dtys = [];
  export int[] dinit = [];
} chain () {
  export int[] goff = [];
  export int[] gsz = [0];
  export string[] slits = [];
} chain () {
  export int[] soff = [];
  export int[] lcnt = [0];
  export int[] reach = [];
} chain () {
  export int[] rwork = [];
  export string[] envo = [];
  export string[] envn = [];
} chain () {
  export int[] fstat = [];
  export int[] fsk = [0];
  export int[] gst = [];
} chain () {
  export int[] greach = [];
  export int[] indn = [0, 0, 0, 0, 0, 0, 0];
} return void export dnames;
