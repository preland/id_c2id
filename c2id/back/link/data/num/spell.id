// Integer literals wider than the parser's 32-bit field. The parser decodes a
// literal's value into an int cell, so 0x0123456789abcdefULL arrives truncated;
// but the spelling is kept beside it, and a hex or decimal spelling with its
// u/l suffixes cut off is itself a valid `id` literal that is a word when it
// does not fit an int. Octal ("010") and anything with a point are left to the
// decoded value.
num_spell(string raw) {
  string out = "";
  if(num_plain(raw) == 1) {
    int e = spell_end(raw);
    out = str_sub(raw, 0, e);
  }
} return string out;
("0x1fUL"):("0x1f")
("010"):("")
("4000000000u"):("4000000000")

// 1 for a hex literal or a decimal one that does not start with 0.
num_plain(string raw) {
  int c0 = charat(raw, 0);
  int c1 = charat(raw, 1);
  int hex = c0 == 48 && (c1 == 120 || c1 == 88);
} chain (string raw) {
  int dec = c0 > 48 && c0 <= 57;
  int ok = hex + dec;
} return int ok;
("0x1f"):(1)
("12"):(1)
("010"):(0)

// The index where the u/U/l/L suffixes begin.
spell_end(string raw) {
  int e = len(raw);
  while(e > 0 && suffix_at(raw, e - 1) == 1) {
    e = e - 1;
  }
} return int e;
("0x1fUL"):(4)
("123"):(3)
("ULL"):(0)
