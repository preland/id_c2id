// A function type's return type; `int` for anything else, which is what C
// assumes of a call to a function it has not seen.
fn_ret2(int f) {
  int r = (import stdty)[0];
  if((import nk)[f] == "fn") {
    r = (import na)[f];
  }
} return int r;
