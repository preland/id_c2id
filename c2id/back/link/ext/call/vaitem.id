// One extra argument of a variadic call, named (see va_args). A long double is
// two words, its significand and its sign and exponent, which is what the
// callee's va_arg(ap, long double) reads back from two slots in a row.
va_item(int id, string etxt) {
  string out = name_val(etxt);
  if(ty_fkind(ex_ty(id)) == 3) {
    string vlo = name_val("peek64(" + out + ")");
    string vhi = name_val("peek64(" + out + " + 8)");
    out = vlo + ", " + vhi;
  }
} return string out;
