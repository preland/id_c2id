string[] atom_fns = ["__c2id_load", "__c2id_store", "__c2id_rmw", "__c2id_cas", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_tas", "__c2id_clear", "", "", "", "", "memcpy", "memcpy", "__c2id_gxchg", "__c2id_gcas", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_rmw", "__c2id_bcas", "__c2id_vcas", "__c2id_rmw", "__c2id_clear", ""];
