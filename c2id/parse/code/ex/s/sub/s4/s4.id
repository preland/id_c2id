// Conditionals, sizeof, and how a type node is referred to.

cond_str(int id) {
  int[] l = l_of(id);
  int a = a_of(id);
  string s = cond_str2(id, a, l);
} return string s;

// `nb` is the type node for `sizeof(T)` and 0 for `sizeof expr`.
sizeof_str(int id) {
  int a = a_of(id);
  string s = "sizeof(" + expr_str(a) + ")";
  if(b_of(id) != 0) {
    int b = b_of(id);
    s = "sizeof(" + type_ref(b) + ")";
  }
} return string s;

// Types are parse/ty/'s to print; here a type is just its node id.
type_ref(int ty) {
  string s = "t" + ty;
} return string s;
