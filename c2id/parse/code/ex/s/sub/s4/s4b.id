// cond_str's tail: naming l_of, a_of and the final string would be four
// actions, one over s4.id's budget. sub/ has no room for a sibling file,
// so s4.id was promoted into this directory to make room.

cond_str2(int id, int a, int[] l) {
  int b = b_of(id);
  string s = "(" + expr_str(a) + " ? " + expr_str(b) + " : " + expr_str(l[0]) + ")";
} return string s;
