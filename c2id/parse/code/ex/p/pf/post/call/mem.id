// s.field and p->field. `ns` is the field name, `nt` is which operator was
// used -- the type pass needs to know, because `->` dereferences first.

parse_member(int[] pos, int a) {
  string op = cur_text(pos);
  advance(pos);
  string name = cur_text(pos);
} return int member_node(pos, a, op, name);

member_node(int[] pos, int a, string op, string name) {
  advance(pos);
} return int newleaf("mem", a, 0, name, op);
