// Decoding a constant's spelling, the parenthesised primary, and the error
// leaf.

const_val(string kind, string s) {
  int n = chr_val(s);
  if(kind == "num") {
    n = to_num(s);
  }
} return int n;
("num", "42"):(42)
("chr", "a"):(97)

prim_paren(int[] pos) {
  advance(pos);
  int node = paren_expr(pos);
} return int node;
given boot_a given lexfix stdin "(1);" ([0]):(0)
given boot_a given lexfix stdin "(0);" ([0]):(0)

// Nothing here can start an expression. Report it, consume the token so the
// caller cannot spin forever, and hand back a zero so the rest of the
// translation unit still parses.
prim_bad(int[] pos) {
  string msg = "c2id: expression expected, found '" + cur_text(pos) + "'";
  print(msg);
  int id = bad_advance(pos);
} return int id;
given boot_a given lexfix stdin ";" ([0]):(0)
given boot_a given lexfix stdin "+" ([0]):(0)
