// `sizeof x`. The operand is a unary-expression, so `sizeof x + 1` is
// `(sizeof x) + 1` -- the additive fold happens back up in the ladder.

sizeof_expr(int[] pos) {
  int a = parse_unary(pos);
  int id = newleaf("sizeof", a, 0, "", "");
} return int id;

// ../cast/lit.id's compound_lit: it already spends its 3-action budget on
// scanning the initialisers, leaving no room to name the newlist()+newleaf()
// pair it must return. un/cast/ has no room for a sibling file; sz/ does.
lit_node(int ty, int[] ids) {
  int a = newlist("call", 0 - 1, 0, "", ids);
  int id = newleaf("cast", a, ty, "", "");
} return int id;
