// sizeof. Two forms, and the same '(' ambiguity as a cast:
//
//   sizeof(int)   -- a type name; the node carries `nb` = type node, `na` = 0
//   sizeof x      -- a unary-expression; `na` = operand, `nb` = 0
//   sizeof (x)    -- also an expression: the '(' is already eaten when we find
//                    out, so the rest is parsed as a parenthesised expression

parse_sizeof(int[] pos) {
  advance(pos);
  int node = sizeof_arg(pos);
} return int node;
given boot_a given ty_setup given lexfix stdin "sizeof(int);" ([0]):(1) then calls sizeof_paren:[1]
given boot_a given lexfix stdin "sizeof x;" ([0]):(1) then calls sizeof_expr:[1]

sizeof_arg(int[] pos) {
  int node = 0;
  if(at_text(pos, "(")) {
    node = sizeof_paren(pos);
  } else {
    node = sizeof_expr(pos);
  }
} return int node;
given boot_a given ty_setup given lexfix stdin "(int);" ([0]):(1)
given boot_a given lexfix stdin "x;" ([0]):(1)

sizeof_paren(int[] pos) {
  advance(pos);
  int node = sizeof_body(pos);
} return int node;
given boot_a given ty_setup given lexfix stdin "sizeof(int);" ([0]):(3)
given boot_a given ty_setup given lexfix stdin "sizeof(x);" ([0]):(1)
