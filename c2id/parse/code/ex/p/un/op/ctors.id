// The last unary link: `sizeof`, else fall through to postfix.
//
// `sizeof` arrives from the lexer as an ordinary identifier token, so the test
// is on the text. That is safe: C reserves the word, so no object can be
// called `sizeof`.

parse_unary3(int[] pos) {
  int node = 0;
  if(cur_text(pos) == "sizeof") {
    node = parse_sizeof(pos);
  } else {
    node = parse_postfix(pos);
  }
} return int node;
given boot_a given lexfix stdin "sizeof x;" ([0]):(1) then calls parse_sizeof:[1]
given boot_a given lexfix stdin "x;" ([0]):(0) then calls parse_postfix:[1]

// unary_op's and pre_incdec's constructors: unary.id and prefix.id each already
// spend their 3-action budget on reading the operator token and advancing,
// leaving no room to name the newleaf() call they must return.
unary_node(int[] pos, string op) {
  int a = parse_cast(pos);
  int id = newleaf("un", a, 0, op, "");
} return int id;
given boot_a given lexfix stdin "x;" ([0], "!"):(1)
given boot_a given lexfix stdin "y;" ([0], "-"):(1)

incdec_node(int[] pos, string op) {
  int a = parse_unary(pos);
  int id = newleaf("un", a, 0, op, "");
} return int id;
given boot_a given lexfix stdin "x;" ([0], "++"):(1)
given boot_a given lexfix stdin "y;" ([0], "--"):(1)
