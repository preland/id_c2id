// parse_return's and parse_goto's tails: each already spends its 3-action
// budget reading the keyword's payload, leaving no room to name the call it
// must return. rest/ has no room for a sibling file, so jump_stmt.id was
// promoted into this directory to make room.

return_close(int[] pos, int a) {
  skip_semi(pos);
  int id = newleaf("return", a, 0, "", "");
} return int id;
given boot_a given lexfix stdin ";" ([0], 0):(0)
given boot_a given lexfix stdin " ;" ([0], 0):(0)

goto_tail(int[] pos, string name) {
  advance(pos);
  int id = goto_done(pos, name);
} return int id;
given boot_a given lexfix stdin ";" ([0], "x"):(0)
given boot_a given lexfix stdin ";" ([0], "y"):(0)
