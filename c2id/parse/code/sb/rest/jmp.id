// return / goto. A `goto`'s target is kept as a name here; resolving it to a
// block number can only happen once the whole function has been read, so the
// CFG builder does that.
parse_return(int[] pos) {
  advance(pos);
  int a = ret_val(pos);
  skip_semi(pos);
} return int newleaf("return", a, 0, "", "");

ret_val(int[] pos) {
  int a = 0 - 1;
  if(at_text(pos, ";") == 0) {
    a = parse_expr(pos);
  }
} return int a;

parse_goto(int[] pos) {
  advance(pos);
  string name = cur_text(pos);
  advance(pos);
} return int goto_done(pos, name);
