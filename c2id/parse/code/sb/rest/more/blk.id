parse_block(int[] pos) {
  advance(pos);
  int[] l = fill_block(pos);
  int id = newlist("block", 0, 0, "", l);
} return int id;
given boot_a given lexfix stdin "{;}" ([0]):(1)
given boot_a given lexfix stdin "{}" ([0]):(0)

// The eof guard matters: without it a source file with unbalanced braces
// spins here forever instead of ending.
fill_block(int[] pos) {
  int[] l = [];
  while(at_text(pos, "}") == 0 && cur_kind(pos) != "eof") {
    int id = parse_stmt(pos);
    push(l, id);
  }
  advance(pos);
} return int[] l;
given boot_a given lexfix stdin ";}" ([0]):([0])
given boot_a given lexfix stdin "}" ([0]):([])

skip_semi(int[] pos) {
  if(at_text(pos, ";")) {
    advance(pos);
  }
} return void;
given boot_a given lexfix stdin ";" ([0]):() then calls advance:[1]
given boot_a given lexfix stdin "x;" ([0]):() then calls advance:[0]
