// A declaration statement. `int a = 1, *b, c[3];` is one C declaration with
// three declarators sharing one specifier list, so it becomes a block of decl
// nodes -- which means nothing downstream needs a multi-declarator case.
//
// INTEGRATION CONTRACT with c2id/parse/ty/:
//   parse_specs(int[] pos)        -> int   base type node from the specifiers
//   parse_declarator(int[] pos, int t) -> int full type node
//   decl_name()                      -> string  name from the last declarator
parse_decl_stmt(int[] pos) {
  int t = parse_specs(pos);
  int[] l = fill_decls(pos, t);
  int id = newlist("block", 0, 0, "", l);
} return int id;
given boot_a given ty_setup given lexfix stdin "int x;" ([0]):(2) then calls one_decl:[1]
given boot_a given ty_setup given lexfix stdin "int x, y;" ([0]):(3) then calls one_decl:[2]

fill_decls(int[] pos, int t) {
  int[] l = [];
  while(at_text(pos, ";") == 0 && cur_kind(pos) != "eof") {
    int id = one_decl(pos, t);
    push(l, id);
    skip_comma(pos);
  }
  skip_semi(pos);
} return int[] l;
given boot_a given ty_setup given lexfix stdin "x;" ([0], 0):([0]) then calls one_decl:[1]
given boot_a given ty_setup given lexfix stdin "x, y;" ([0], 0):([0, 1]) then calls one_decl:[2]

one_decl(int[] pos, int t) {
  int b = parse_declarator(pos, t);
  string name = decl_name();
  int id = decl_leaf(pos, b, name);
} return int id;
given boot_a given ty_setup given lexfix stdin "x;" ([0], 0):(0) then calls init_val:[0]
given boot_a given ty_setup given lexfix stdin "x = 1;" ([0], 0):(1) then calls init_val:[1]
