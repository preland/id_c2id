// `for (init; cond; step) body`. Each of the three clauses may be empty, and
// the init clause may be a declaration -- so it is read as a statement, which
// already knows how to be either and consumes its own semicolon.
parse_for(int[] pos) {
  advance(pos);
  advance(pos);
  int id = for_head(pos);
} return int id;
given boot_a given ty_setup given lexfix stdin "for (i = 0; i < 1; i++) ;" ([0]):(10)
given boot_a given ty_setup given lexfix stdin "for (;;) ;" ([0]):(1)

for_init(int[] pos) {
  int[] l = [];
  if(at_text(pos, ";")) {
    advance(pos);
  } else {
    int id = parse_stmt(pos);
    push(l, id);
  }
} return int[] l;
given boot_a given ty_setup given lexfix stdin ";" ([0]):([])
given boot_a given ty_setup given lexfix stdin "i = 0;" ([0]):([3])

for_cond(int[] pos, int[] l) {
  int a = opt_expr(pos, ";");
  int id = for_step(pos, a, l);
} return int id;
given boot_a given ty_setup given lexfix stdin ";;;" ([0], []):(3) then calls opt_expr:[2]
given boot_a given ty_setup given lexfix stdin "1;;;" ([0], []):(4) then calls opt_expr:[2]
