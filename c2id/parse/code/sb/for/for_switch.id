for_step(int[] pos, int a, int[] l) {
  int b = opt_expr(pos, ")");
  int id = for_body(pos, a, b, l);
} return int id;
given boot_a given ty_setup given lexfix stdin ");" ([0], 0, []):(1)
given boot_a given ty_setup given lexfix stdin "1);" ([0], 0, []):(2)

for_body(int[] pos, int a, int b, int[] l) {
  int[] m = [parse_stmt(pos)];
  int id = newnode("for", a, b, "", "", l, m);
} return int id;
given boot_a given ty_setup given lexfix stdin ";" ([0], 0, 0, []):(1)
given boot_a given ty_setup given lexfix stdin "x;" ([0], 0, 0, []):(2)

parse_switch(int[] pos) {
  int a = read_paren_cond(pos);
  int id = switch_body(pos, a);
} return int id;
given boot_a given ty_setup given lexfix stdin "switch (1) {;}" ([0]):(3) then calls read_paren_cond:[1]
given boot_a given ty_setup given lexfix stdin "switch (x) {;}" ([0]):(3) then calls read_paren_cond:[1]
