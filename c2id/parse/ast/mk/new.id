// newnode and the two shorthands most constructors use. Keeping the "no
// children" and "no strings" cases as their own functions stops every call
// site from having to conjure an empty list, which `id` cannot spell inline
// (a bare [] needs a known list type).

newnode(string kind, int a, int b, string s, string tstr, int[] l, int[] m) {
  push_kab(kind, a, b);
  push_st(s, tstr);
  push_lm(l, m);
} return int len((import nk)) - 1;

// A node with no child lists.
newleaf(string kind, int a, int b, string s, string tstr) {
  int[] none = [];
} return int newnode(kind, a, b, s, tstr, none, none);

// A node with one child list.
newlist(string kind, int a, int b, string s, int[] l) {
  int[] none = [];
} return int newnode(kind, a, b, s, "", l, none);
