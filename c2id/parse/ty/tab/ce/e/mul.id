
// The additive/bitwise operator set, and the multiplicative level below it.

ce_at_e(string s) {
  int ok = 0;
  if(s == "+" || s == "-" || s == "<<" || s == ">>" || s == "|" || s == "&" || s == "^") {
    ok = 1;
  }
} return int ok;

ce_mul(int[] pos) {
  int v = ce_un(pos);
} return int ce_mloop(pos, v);

ce_mloop(int[] pos, int v) {
  while(ce_at_m(cur_text(pos))) {
    v = ce_mstep(pos, v);
  }
} return int v;
