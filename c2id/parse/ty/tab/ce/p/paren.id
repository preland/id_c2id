
// Parentheses and the sizeof/identifier split.

ce_prim2(int[] pos) {
  int v = 0;
  if(at_text(pos, "(")) {
    v = ce_paren(pos);
  } else {
    v = ce_name(pos);
  }
} return int v;
given lexfix stdin "( 5 )" ([0]):(5)
given lexfix stdin ")" ([0]):(0)

ce_paren(int[] pos) {
  advance(pos);
  int v = ce_expr(pos);
  skip_tok(pos, ")");
} return int v;
given lexfix stdin "( 2 + 3 )" ([0]):(5)
given lexfix stdin "( 7 )" ([0]):(7)

ce_name(int[] pos) {
  int v = 0;
  if(at_text(pos, "sizeof")) {
    v = ce_sizeof(pos);
  } else {
    v = ce_name2(pos);
  }
} return int v;
given boot_a given ty_setup given lexfix stdin "sizeof ( int )" ([0]):(4)
given lexfix stdin ")" ([0]):(0)
