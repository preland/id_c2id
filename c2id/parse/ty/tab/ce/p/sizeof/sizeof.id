
// sizeof(T) -- the parenthesised, type-argument form, which is the only one
// that can appear in an array bound. `sizeof expr` is not evaluated here; it
// yields a machine word, which is what it is for every pointer and most
// integers the kernel takes the size of.

ce_sizeof(int[] pos) {
  advance(pos);
  int v = ce_szarg(pos);
} return int v;
given boot_a given ty_setup given lexfix stdin "sizeof ( int )" ([0]):(4)
given lexfix stdin "sizeof x" ([0]):(8)

ce_szarg(int[] pos) {
  int v = 8;
  if(at_text(pos, "(")) {
    v = ce_szparen(pos);
  }
} return int v;
given boot_a given ty_setup given lexfix stdin "( int )" ([0]):(4)
given lexfix stdin "x" ([0]):(8)

ce_szparen(int[] pos) {
  advance(pos);
  int v = ce_szparen_sz(pos);
  skip_tok(pos, ")");
} return int v;
given boot_a given ty_setup given lexfix stdin "( int )" ([0]):(4)
given boot_a given ty_setup given lexfix stdin "( char )" ([0]):(1)
