
// sizeof(T) -- the parenthesised, type-argument form, which is the only one
// that can appear in an array bound. `sizeof expr` is not evaluated here; it
// yields a machine word, which is what it is for every pointer and most
// integers the kernel takes the size of.

ce_sizeof(int[] pos) {
  advance(pos);
} return int ce_szarg(pos);

ce_szarg(int[] pos) {
  int v = 8;
  if(at_text(pos, "(")) {
    v = ce_szparen(pos);
  }
} return int v;

ce_szparen(int[] pos) {
  advance(pos);
  int v = type_size(parse_typename(pos));
  skip_tok(pos, ")");
} return int v;
