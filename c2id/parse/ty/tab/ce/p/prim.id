
// Primaries: a numeric literal, a parenthesised expression, sizeof, or an
// identifier (which can only be an enumerator by the time the preprocessor
// has run).

ce_neg(int[] pos) {
  advance(pos);
  int v = ce_un(pos);
  int r = 0 - v;
} return int r;

ce_prim(int[] pos) {
  int v = 0;
  if(cur_kind(pos) == "num") {
    v = ce_num(pos);
  } else {
    v = ce_prim2(pos);
  }
} return int v;

ce_num(int[] pos) {
  string s = cur_text(pos);
  int v = num_val(s);
  advance(pos);
} return int v;
