
// Where the digits start, and the digit fold itself.

hex_start(string s) {
  int i = 0;
  if(hex_pfx(s)) {
    i = 2;
  }
} return int i;

is_xch(int c) {
  int ok = 0;
  if(c == 120 || c == 88) {
    ok = 1;
  }
} return int ok;

radix_val(string s, int i, int n) {
  int v = 0;
  while(radix_more(s, i, n)) {
    v = radix_step(s, i, n, v);
    i = i + 1;
  }
} return int v;
