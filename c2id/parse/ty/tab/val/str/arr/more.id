ts_arr_cnt(int ty) {
  int b = b_of(ty);
  string txt = ts_cnt(b);
} return string txt;

// type_str of ty's `a` field: the array element, or (in fn/fn.id) the
// function result. Shared so ts_arr and ts_fn are not identical-logic
// duplicates.
ts_a(int ty) {
  int a = a_of(ty);
  string s = type_str(a);
} return string s;
