
// Arrays print their bound, or nothing at all for the unspecified `[]`.

ts_arr(int ty) {
  string txt = ts_arr_cnt(ty);
  string s = ts_a(ty);
  string out = "[" + txt + "]" + s;
} return string out;
given tynode_fix (3):("[3]int")
given tynode_fix (2):("[0]int")

ts_cnt(int n) {
  string s = "";
  if(n >= 0) {
    s = "" + n;
  }
} return string s;
(5):("5")
(-1):("")

ts4(int ty) {
  string s = "";
  if(k_of(ty) == "fn") {
    s = ts_fn(ty);
  } else {
    s = ts_rec(ty);
  }
} return string s;
given tynode_fix (4):("(int)->int")
given tynode_fix (5):("struct point{99}")
