// The last entry of node 1's m-list, a zero-argument witness of what
// sy_row_m actually appended (m_of is mutated by reference; nothing else
// reads it back for an arbitrary node).
check_node1_mlast() {
  int[] m = m_of(1);
  int r = 0 - 1;
  if(len(m) > 0) {
    r = m[len(m) - 1];
  }
} return int r;
