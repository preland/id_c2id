
// Functions print as (params)->result.

ts_fn(int ty) {
  string txt = ts_fn_params(ty);
  string s = ts_a(ty);
  string out = "(" + txt + ")->" + s;
} return string out;
given tynode_fix (4):("(int)->int")
given tynode_fix (2):("()->int")

ts_params(int[] ids) {
  string out = "";
  int i = 0;
  while(i < len(ids)) {
    out = out + ts_sep(i) + type_str(ids[i]);
    i = i + 1;
  }
} return string out;
given tynode_fix ([0]):("int")
given tynode_fix ([0, 0]):("int,int")

ts_sep(int i) {
  string s = "";
  if(i > 0) {
    s = ",";
  }
} return string s;
(0):("")
(1):(",")
