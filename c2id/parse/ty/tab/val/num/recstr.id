
// The tail of the type printer: records.

ts_rec(int ty) {
  string s = "?";
  if(k_of(ty) == "rec") {
    s = ts_su(ty);
  }
} return string s;
given tynode_fix (5):("struct point{99}")
given tynode_fix (0):("?")

ts_su(int ty) {
  string s = "union ";
  if(b_of(ty) == 0) {
    s = "struct ";
  }
  string out = s + s_of(ty) + "{" + a_of(ty) + "}";
} return string out;
given tynode_fix (5):("struct point{99}")
given tynode_fix (3):("union {0}")
