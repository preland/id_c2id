
// void has width 0 but still has to have an alignment of 1, or align_up
// would divide by zero. Plus the two token-eating helpers used all over the
// parser: one that discards a token if it is there, one that says whether it
// was.

align_of_size(int n) {
  int r = n;
  if(n < 1) {
    r = 1;
  }
} return int r;

skip_tok(int[] pos, string s) {
  if(at_text(pos, s)) {
    advance(pos);
  }
} return void;

take_tok(int[] pos, string s) {
  int ok = 0;
  if(at_text(pos, s)) {
    advance(pos);
    ok = 1;
  }
} return int ok;
