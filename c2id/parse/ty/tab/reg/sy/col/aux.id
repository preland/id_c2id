// dname after a real declarator name has been reported, for decl_name's
// second case (ty_setup alone always leaves dname at "").
dname_x_fix() {
  ty_setup();
  set_dname("x");
} return void;
():() then decl_name:("x")
():() then calls set_dname:("x")
