
// The type of a member, and the one arithmetic helper layout needs.

// type node of member `name` inside record `ty`, or -1
member_type(int ty, string name) {
  int i = mem_find(ty, name);
  int r = 0 - 1;
  if(i >= 0) {
    r = (import syids)[i];
  }
} return int r;
given mem_row_fix (1, "x"):(0)
given mem_row_fix (1, "z"):(-1)

// m_of(ty) must not be re-read as part of the while condition itself, so
// find.id's mem_find loop test becomes this named step instead.
mem_more(int ty, int i, int found) {
  int[] m = m_of(ty);
  int k = len(m);
  int ok = i < k && found < 0;
} return int ok;
given tynode_fix (5, 0, -1):(1)
given tynode_fix (5, 1, -1):(0)

// An alignment of 0 is possible -- a void type has one -- so the guard is not
// decoration: without it this divides by zero.
align_up(int n, int a) {
  int r = n;
  if(a > 0) {
    r = ((n + a - 1) / a) * a;
  }
} return int r;
(5, 4):(8)
(5, 0):(5)
