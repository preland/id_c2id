
// A parenthesised declarator, e.g. the `(*fp)` of `int (*fp)(char*, int)`.
// The group binds to the type the *outer* suffixes produce, which are not
// known yet -- so the group is skipped, the suffixes after it are parsed, and
// the cursor is then wound back to re-read the group against the finished
// type. That rewind is why the group case is three functions.

dcl_group(int[] pos, int inner) {
  advance(pos);
  int i = pos[0];
  skip_bal(pos);
} return int grp_suffix(pos, inner, i);

grp_suffix(int[] pos, int inner, int i) {
  int r = type_suffix(pos, inner);
  int n = pos[0];
  pos[0] = i;
} return int grp_inner(pos, r, n);

grp_inner(int[] pos, int inner, int n) {
  int r = parse_declarator(pos, inner);
  pos[0] = n;
} return int r;
