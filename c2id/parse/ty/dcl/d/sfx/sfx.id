
// Suffixes bind left to right, so `a[3][4]` is an array of 3 arrays of 4 --
// which falls out of recursing on the remaining suffixes *before* wrapping
// the current one.

ty_suffix2(int[] pos, int inner) {
  int r = inner;
  if(at_text(pos, "(")) {
    r = fn_suffix(pos, inner);
  }
} return int r;

arr_suffix(int[] pos, int inner) {
  advance(pos);
  int n = arr_count(pos);
} return int arr_make(pos, inner, n);

// an unspecified bound, `[]`, is recorded as -1
arr_count(int[] pos) {
  int n = 0 - 1;
  if(at_text(pos, "]") == 0) {
    n = ce_expr(pos);
  }
  skip_tok(pos, "]");
} return int n;
