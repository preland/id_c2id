
// Suffixes bind left to right, so `a[3][4]` is an array of 3 arrays of 4 --
// which falls out of recursing on the remaining suffixes *before* wrapping
// the current one.

ty_suffix2(int[] pos, int inner) {
  int r = inner;
  if(at_text(pos, "(")) {
    r = fn_suffix(pos, inner);
  }
} return int r;
given boot_a given lexfix stdin "x" ([0], 0):(0)
given boot_a given lexfix stdin "( )" ([0], 0):(0) then calls fn_suffix:([2], 0)

arr_suffix(int[] pos, int inner) {
  advance(pos);
  int n = arr_count(pos);
  int r = arr_make(pos, inner, n);
} return int r;
given boot_a given lexfix stdin "[ 3 ]" ([0], 0):(0) then calls newleaf:("arr", 0, 3, "", "")
given boot_a given lexfix stdin "[ ]" ([0], 0):(0) then calls newleaf:("arr", 0, -1, "", "")

// an unspecified bound, `[]`, is recorded as -1
arr_count(int[] pos) {
  int n = 0 - 1;
  if(at_text(pos, "]") == 0) {
    n = ce_expr(pos);
  }
  skip_tok(pos, "]");
} return int n;
given lexfix stdin "3 ]" ([0]):(3)
given lexfix stdin "]" ([0]):(-1)
