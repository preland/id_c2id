
// Array and function suffixes.

arr_make(int[] pos, int inner, int n) {
  int r = type_suffix(pos, inner);
  int a = newleaf("arr", r, n, "", "");
} return int a;

fn_suffix(int[] pos, int inner) {
  int[] ps = fn_params(pos);
  int r = fn_make(pos, inner, ps);
} return int r;

fn_make(int[] pos, int inner, int[] ps) {
  int r = type_suffix(pos, inner);
  int a = newlist("fn", r, 0, "", ps);
} return int a;
