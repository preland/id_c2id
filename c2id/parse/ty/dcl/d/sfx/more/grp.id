
// Telling `(` that opens a group from `(` that opens a parameter list: a
// parameter list starts with a type or is empty, a group does not.

is_group(int[] pos) {
  int ok = 0;
  if(at_text(pos, "(")) {
    ok = grp_open_inside(pos);
  }
} return int ok;
given ty_setup given lexfix stdin "( x" ([0]):(1)
given ty_setup given lexfix stdin "x" ([0]):(0)

grp_inside(string s) {
  int ok = 1;
  if(s == ")" || is_type_word(s) || is_typedef(s)) {
    ok = 0;
  }
} return int ok;
given ty_setup (")"):(0)
given ty_setup ("xyz"):(1)

type_suffix(int[] pos, int inner) {
  int r = 0;
  if(at_text(pos, "[")) {
    r = arr_suffix(pos, inner);
  } else {
    r = ty_suffix2(pos, inner);
  }
} return int r;
given boot_a given lexfix stdin "[ 3 ]" ([0], 0):(0) then calls newleaf:("arr", 0, 3, "", "")
given boot_a given lexfix stdin "x" ([0], 0):(0)
