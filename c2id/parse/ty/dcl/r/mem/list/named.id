
// A named member, possibly a bitfield.

mem_named(int[] pos, int ty, int[] lay, int inner) {
  int r = parse_declarator(pos, inner);
  string name = decl_name();
  int r2 = mem_place(pos, ty, lay, r, name);
} return int r2;
given tynode_fix given ty_setup given lexfix stdin "x ;" ([0], 1, [0, 0, 0], 0):(0) then calls place:(1, [32, 4, 4], 0, "x", -1)
given tynode_fix given ty_setup given lexfix stdin "* x ;" ([0], 1, [0, 0, 0], 0):(6) then calls place:(1, [64, 8, 8], 6, "x", -1)

mem_place(int[] pos, int ty, int[] lay, int r, string name) {
  int w = mem_width(pos);
  place(ty, lay, r, name, w);
} return int r;
given tynode_fix given ty_setup given lexfix stdin ";" ([0], 1, [0, 0, 0], 0, "x"):(0) then calls place:(1, [32, 4, 4], 0, "x", -1)
given tynode_fix given ty_setup given lexfix stdin ": 3" ([0], 1, [0, 0, 0], 0, "x"):(0) then calls place:(1, [3, 4, 4], 0, "x", 3)

// `unsigned int x : 3` -- width in bits, or -1 for an ordinary member
mem_width(int[] pos) {
  int w = 0 - 1;
  if(at_text(pos, ":")) {
    advance(pos);
    w = ce_expr(pos);
  }
} return int w;
given lexfix stdin ": 3" ([0]):(3)
given lexfix stdin ";" ([0]):(-1)
