
// A whole member: round the cursor up to the member's own alignment, take
// that as its offset, and advance past it. A union member always sits at 0
// and only contributes to the maximum size.

place_ws(int ty, int[] lay, int r) {
  int n = place_ws_off(ty, lay, r);
  place_ws_cur(lay, r, n);
  place_max(lay, r);
} return int n;
given tynode_fix (1, [3, 0, 0], 0):(32)
given tynode_fix (0, [3, 0, 0], 2):(0)

// A bitfield goes at the cursor if it still fits in the storage unit of its
// declared type, and otherwise starts a fresh unit. A zero-width field never
// fits, which is exactly what makes it force alignment.
place_bf(int ty, int[] lay, int r, int w) {
  int n = place_bf_off(ty, lay, r, w);
  lset(lay, 0, n + w);
  place_max(lay, r);
} return int n;
given tynode_fix (1, [10, 0, 0], 0, 0):(32)
given tynode_fix (0, [10, 0, 0], 0, 0):(0)

bf_pos(int n, int sz, int w) {
  int v = align_up(n, 8 * sz);
  if(bf_fits(n, sz, w)) {
    v = n;
  }
} return int v;
(3, 1, 5):(3)
(5, 1, 0):(8)
