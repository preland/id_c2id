
// The record's size before the final round-up: a struct ends where its last
// member ended, a union is as wide as its widest.

rec_bytes(int ty, int[] lay) {
  int n = lay[1];
  if(b_of(ty) == 0) {
    n = (lay[0] + 7) / 8;
  }
} return int n;
given tynode_fix (0, [0, 7, 0]):(7)
given tynode_fix (5, [10, 7, 0]):(2)

rec_size_a(int ty, int[] lay) {
  int b = rec_bytes(ty, lay);
  int w = align_up(b, lay[2]);
  set_a(ty, w);
} return void;
given tynode_fix (0, [0, 7, 8]):(0, [0, 7, 8]) then calls set_a:(0, 8)
given tynode_fix (5, [10, 7, 8]):(5, [10, 7, 8]) then calls set_a:(5, 8)

rec_size_b(int ty, int[] lay) {
  int[] m = m_of(ty);
  lset(m, 0, lay[2]);
} return void;
given lm_fixture (0, [10, 20, 99]):() then m0_of:([99])
given lm_fixture (0, [1, 2, 42]):() then m0_of:([42])
