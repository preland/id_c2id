
// A fresh rec node starts empty: size 0, no members, alignment 1. nm is
// [alignment, row, row, ...] and nl collects member types; both are filled in
// as the body is read, through the lists themselves rather than by rebuilding
// the node.

rec_get(int un, string name) {
  int ty = rec_look(un, name);
  if(ty < 0) {
    ty = new_su(un, name);
  }
} return int ty;
given boot_a given ty_setup (0, ""):(0)
given struct_foo_fix (0, "foo"):(5)

new_su(int un, string name) {
  int ty = mk_rec(un, name);
  su_reg(un, name, ty);
} return int ty;
given boot_a given ty_setup (0, "foo"):(0) then calls su_reg:(0, "foo", 0)
given boot_a given ty_setup (1, "bar"):(0) then calls su_reg:(1, "bar", 0)

mk_rec(int un, string name) {
  int[] l = [];
  int[] m = [1];
  int ty = newnode("rec", 0, un, name, "", l, m);
} return int ty;
given boot_a (0, "foo"):(0) then calls newnode:("rec", 0, 0, "foo", "", [], [1])
given boot_a (1, "bar"):(0) then calls newnode:("rec", 0, 1, "bar", "", [], [1])
