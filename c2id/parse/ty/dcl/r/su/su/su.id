
// struct and union. A tag is registered under "struct T" / "union T" in the
// same table as typedef names, so `struct list_head *next;` inside
// `struct list_head` finds the node that is still being built -- which is what
// makes self-referential records work at all.

parse_su(int[] pos) {
  int un = su_head(pos);
  int r = su_tag(pos, un);
} return int r;

su_kw(int[] pos) {
  int n = 0;
  if(at_text(pos, "union")) {
    n = 1;
  }
} return int n;

su_tag(int[] pos, int un) {
  string name = take_ident(pos);
  int r = su_body(pos, un, name);
} return int r;
