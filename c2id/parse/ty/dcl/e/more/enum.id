
// enum. The type is plain `int`; what matters is the enumerators, which go
// into the constant table so array bounds, bitfield widths and the
// expression parser can all resolve them.

parse_enum(int[] pos) {
  enum_head(pos);
  int r = enum_body(pos);
} return int r;
given boot_a given ty_setup given lexfix stdin "enum { x }" ([0]):(0) then calls scan_enums:([4])
given boot_a given ty_setup given lexfix stdin "enum foo" ([0]):(0) then calls int_type:()

enum_body(int[] pos) {
  enum_items(pos);
  int r = int_type();
} return int r;
given boot_a given ty_setup given lexfix stdin "{ x }" ([0]):(0) then calls scan_enums:([3])
given boot_a given ty_setup given lexfix stdin "x" ([0]):(0) then calls int_type:()

enum_items(int[] pos) {
  if(at_text(pos, "{")) {
    scan_enums(pos);
  }
} return void;
given ty_setup given lexfix stdin "{ x }" ([0]):([3])
given ty_setup given lexfix stdin "x" ([0]):([0])
