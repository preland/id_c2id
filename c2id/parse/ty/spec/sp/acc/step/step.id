
// One specifier: qualifier noise first (it can appear anywhere in the list),
// then a built-in type word, then struct/union/enum or a typedef name.

spec_step(int[] pos, int[] sp) {
  int ok = skip_noise(pos);
  if(ok == 0) {
    ok = spec_word(pos, sp);
  }
} return int ok;

spec_word(int[] pos, int[] sp) {
  int ok = spec_basic(pos, sp);
  if(ok == 0) {
    ok = spec_tag(pos, sp);
  }
} return int ok;

spec_basic(int[] pos, int[] sp) {
  int i = spec_basic_idx(pos);
  bump_spec(pos, sp, i);
  int ok = has_idx(i);
} return int ok;
