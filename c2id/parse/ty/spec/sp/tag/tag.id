
// struct / union / enum / typedef-name specifiers, all of which name a type
// outright rather than contributing to the width arithmetic.

spec_tag(int[] pos, int[] sp) {
  int ok = spec_su(pos, sp);
  if(ok == 0) {
    ok = spec_en(pos, sp);
  }
} return int ok;

spec_su(int[] pos, int[] sp) {
  int ok = 0;
  if(at_text(pos, "struct") || at_text(pos, "union")) {
    int ty = parse_su(pos);
    lset(sp, 10, ty);
    ok = 1;
  }
} return int ok;

spec_en(int[] pos, int[] sp) {
  int ok = 0;
  if(at_text(pos, "enum")) {
    int ty = parse_enum(pos);
    lset(sp, 10, ty);
    ok = 1;
  } else {
    ok = spec_td(pos, sp);
  }
} return int ok;
