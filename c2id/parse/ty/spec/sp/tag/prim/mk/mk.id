
// Turning the counted specifiers into a prim node. Every combination that C
// allows collapses onto one of sixteen canonical types, so the whole of
// `long unsigned int` vs `unsigned long` is one index computation and three
// table lookups.

mk_prim(int[] sp) {
  int i = prim_idx(sp);
  int ty = mk_prim_leaf(i);
} return int ty;

prim_names() {
  string[] names = ["void", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long", "float", "double", "long double"];
} return string[] names;

// LP64, which is what the kernel assumes: long and long long are both 8.
prim_sizes() {
  int[] xs = [0, 1, 1, 1, 1, 2, 2, 4, 4, 8, 8, 8, 8, 4, 8, 16];
} return int[] xs;
