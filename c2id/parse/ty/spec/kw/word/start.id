
// is_type_start is the public predicate; norm_kw folds the GNU alias
// `__signed__` onto `signed` so the specifier table needs only one entry.

is_type_start(int[] pos) {
  string s = cur_text(pos);
  int ok = is_type_word(s);
  if(ok == 0) {
    string s2 = cur_text(pos);
    ok = is_typedef(s2);
  }
} return int ok;
given ty_setup given lexfix stdin "int" ([0]):(1)
given ty_setup given lexfix stdin "xyz" ([0]):(0)

norm_kw(string s) {
  string out = s;
  if(s == "__signed__" || s == "__signed") {
    out = "signed";
  }
} return string out;
  ("__signed__"):("signed")
  ("int"):("int")
