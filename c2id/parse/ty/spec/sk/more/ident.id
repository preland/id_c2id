
// The declared name, or "" when there is none (an abstract declarator, as in
// a cast or a parameter type). A keyword is never a name.

take_ident(int[] pos) {
  string name = "";
  if(cur_kind(pos) == "id") {
    name = ident_maybe(pos, name);
  }
} return string name;
given lexfix stdin "foo" ([0]):("foo")
given lexfix stdin "123" ([0]):("")

// is_type_word(cur_text(pos)) must not run when cur_kind(pos) != "id", so the
// short-circuited `&&` in take_ident becomes this named step instead.
ident_maybe(int[] pos, string name) {
  string s = cur_text(pos);
  int ok = is_type_word(s);
  if(ok == 0) {
    name = s;
    advance(pos);
  }
} return string name;
given lexfix stdin "foo" ([0], ""):("foo")
given lexfix stdin "int" ([0], ""):("")
