
// Skip to just past the `)` matching an already-consumed `(`. Also used by
// the declarator parser, which has to jump over a parenthesised group before
// it can know what type that group applies to.

skip_bal(int[] pos) {
  int depth = 1;
  while(depth > 0 && cur_kind(pos) != "eof") {
    depth = bal_step(pos, depth);
  }
} return void;
given lexfix stdin "a) z" ([0]):([2])
given lexfix stdin "(a)) z" ([0]):([4])

bal_step(int[] pos, int depth) {
  string s = cur_text(pos);
  int n = depth + bal_delta(s);
  advance(pos);
} return int n;
given lexfix stdin "(" ([0], 1):(2)
given lexfix stdin ")" ([0], 1):(0)

bal_delta(string s) {
  int n = 0;
  if(s == "(") {
    n = 1;
  } else {
    n = close_delta(s);
  }
} return int n;
  ("("):(1)
  (")"):(-1)
