// Shared by do_break and do_continue, whose only difference is which stack
// they read the target from: a call may not be an argument to a call, and
// naming cur_blk()/brk_top() (or cont_top()) leaves no room in either
// caller's own block for term_jmp, new_block and set_cur too.
jmp_open(int c, int b) {
  term_jmp(c, b);
  int n = new_block();
  set_cur(n);
} return void;
