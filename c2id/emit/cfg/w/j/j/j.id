// The last link of the chain, and the jumps. `expr` and `decl` -- and any
// node kind that is not control flow -- fall through to add_stmt.
walk_stmt12(int id) {
  if(k_of(id) == "continue") {
    do_continue();
  } else {
    add_stmt(id);
  }
} return void;

do_break() {
  int c = cur_blk();
  int b = brk_top();
  jmp_open(c, b);
} return void;

do_continue() {
  int c = cur_blk();
  int b = cont_top();
  jmp_open(c, b);
} return void;
