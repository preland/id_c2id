// A backward goto resolves here; a forward one leaves -1 in the edge and is
// parked for the fix-up pass.
goto_edge(int blk, string name) {
  int nxt = label_blk(name);
  term_jmp(blk, nxt);
  need_fix(blk, name, nxt);
} return void;
