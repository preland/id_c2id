// A label starts a block, and the statements before it fall into it -- code
// can reach a label both by falling through and by jumping.
do_label(int id) {
  int blk = new_block();
  int cur = cur_blk();
  do_label_cont(id, cur, blk);
} return void;

do_label_cont(int id, int cur, int blk) {
  term_jmp(cur, blk);
  string s = s_of(id);
  lab_add(s, blk);
} return void;

// A `case` is the same thing with a different table: the fall-through edge
// from the previous case is what makes C's fallthrough work with no effort at
// all. do_switch turns the table into the dispatch chain afterwards.
do_case(int id) {
  int blk = new_block();
  int c = cur_blk();
  do_case2(id, blk, c);
} return void;
