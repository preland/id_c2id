// `default` is skipped: it is the chain's tail, not a test in it.
sw_test(int id, int i, int nxt) {
  int blk = nxt;
  if(case_val(i) >= 0) {
    blk = mk_test(id, i, nxt);
  }
} return int blk;

// One test block, holding no statements: the whole test is the terminator's
// condition, `subject == case value`.
mk_test(int id, int i, int nxt) {
  int blk = new_block();
  term_cond(blk, eq_node(a_of(id), case_val(i)), case_blk(i), nxt);
} return int blk;
