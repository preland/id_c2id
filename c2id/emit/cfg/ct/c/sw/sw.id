// `switch (v) B`:
//
//   cur:          jmp -> test0                (written last, once the chain
//   test0:        cond v == k0 -> case0 / test1     exists)
//   test1:        cond v == k1 -> case1 / default-or-exit
//   case0: ...    jmp -> case1                (C's fallthrough, for free)
//   exit:  (filling continues here)
//
// The body is walked as ordinary statements: `case` and `default` are
// statements in it, and each one starts a block and records itself in the
// case table (see ../../st/tab/lab/cas.id). Only afterwards is the table
// turned into the chain of equality tests, which is why the switch's own
// entry block is terminated at the very end.
//
// break -> exit. `continue` is *not* caught here: it belongs to the enclosing
// loop, which is why the break and continue stacks are separate.

do_switch(int id) {
  int blk = cur_blk();
  int alt = new_block();
  sw_body(id, blk, alt);
} return void;
given walk_ast_fixture ((import wswid)):() then term0:("jmp") then succ0:(1)
given walk_ast_fixture ((import wswid)):() then cfg_nblocks:(3)

sw_body(int id, int blk, int alt) {
  int mark = case_mark();
  push_brk(alt);
  sw_walk(id, blk, alt, mark);
} return void;
given walk_ast_fixture ((import wswid), 0, 1):() then term0:("jmp") then succ0:(1)
given walk_ast_fixture ((import wswid), 0, 1):() then cfg_nblocks:(2)

// The body starts in a fresh block: statements before the first `case` are
// unreachable, and giving them their own block keeps them out of the entry
// block without needing to detect them.
sw_walk(int id, int blk, int alt, int mark) {
  int nxt = new_block();
  set_cur(nxt);
  sw_walk2(id, blk, alt, mark);
} return void;
given sw_ready_fixture ((import wswid), 0, 1, 0):() then term0:("jmp") then succ0:(1)
given sw_ready_fixture ((import wswid), 0, 1, 0):() then cfg_nblocks:(2)
