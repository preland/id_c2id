// wh_end2/wh_end/dw_end/dw_end_cont all reach loop_close, which pops the
// break/continue stacks; dowhile_ast_fixture (and, through it,
// while_ast_fixture) never pushes onto them, so pop() there traps on an
// empty list, the same failure st/tab/stk/stk3/ready.id exists to avoid.
loop_pushed_fixture() {
  dowhile_ast_fixture();
  push_loop(99, 98);
} return void;
