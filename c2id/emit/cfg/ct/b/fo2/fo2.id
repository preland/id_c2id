// The continue target is the step block, not the condition block.
fo_run(int id, int nxt, int stp, int blk, int alt) {
  fo_test(id, nxt, blk, alt);
  push_loop(alt, stp);
  fo_walk(id, nxt, stp, alt);
} return void;

// Eager chain: the unconditional edge is written first and the conditional
// one replaces it when there is a condition, so `for (;;)` needs no `else`.
fo_test(int id, int nxt, int blk, int alt) {
  term_jmp(nxt, blk);
  int a = a_of(id);
  fo_test2(id, nxt, blk, alt, a);
} return void;

fo_walk(int id, int nxt, int stp, int alt) {
  int[] m = m_of(id);
  walk_list(m);
  fo_walk2(id, nxt, stp, alt);
} return void;
