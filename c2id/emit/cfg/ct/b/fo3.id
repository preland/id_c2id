fo_step(int id, int nxt, int stp) {
  int b = b_of(id);
  fo_incr(b, stp);
  term_jmp(stp, nxt);
} return void;

fo_incr(int b, int stp) {
  if(b >= 0) {
    add_step(b, stp);
  }
} return void;

// The step goes into its own block by number rather than through add_stmt,
// because by now the walker has moved on to the loop's exit block.
add_step(int b, int stp) {
  int id = expr_stmt(b);
  int[] l = cfg_stmts(stp);
  push(l, id);
} return void;
