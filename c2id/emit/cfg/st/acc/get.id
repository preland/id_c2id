// The interface the emitter reads the graph through. Everything else in this
// directory is machinery; these six functions plus cfg_build() are the whole
// contract, and none of them exposes a list index that the emitter has to get
// right by hand.

cfg_nblocks() {
  int n = len((import bkind));
} return int n;

cfg_stmts(int blk) {
  int[] l = (import bstmt)[blk];
} return int[] l;

// "jmp", "cond" or "end".
cfg_term(int blk) {
  string kind = (import bkind)[blk];
} return string kind;
