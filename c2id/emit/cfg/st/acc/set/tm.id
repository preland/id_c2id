set_ex(int blk, int a) {
  lset((import bex), blk, a);
} return void;

// An unconditional edge. This is what `goto`, `break`, `continue`, a loop's
// back-edge and the join after an `if` all reduce to.
term_jmp(int blk, int nxt) {
  set_kind(blk, "jmp");
  set_sa(blk, nxt);
} return void;

// `return e` -- the emitted block stores e to fp+0 and returns the end
// marker. `a` is -1 for `return;`.
term_end(int blk, int a) {
  set_kind(blk, "end");
  set_ex(blk, a);
} return void;
