// Writing a block's row. An imported list cannot be index-assigned directly
// -- `(import bsa)[i] = v` parses as a comparison and silently does nothing --
// so every store goes through lset/sset (see ../../../../../lex/drv/st/store/append.id).

set_kind(int blk, string kind) {
  sset((import bkind), blk, kind);
} return void;
given cfg_body_fixture (0, "jmp"):() then term0:("jmp")
given cfg_body_fixture (0, "cond"):() then term0:("cond")

set_sa(int blk, int nxt) {
  lset((import bsa), blk, nxt);
} return void;
given cfg_body_fixture (0, 5):() then succ0:(5)
given cfg_body_fixture (0, 9):() then succ0:(9)

set_sb(int blk, int alt) {
  lset((import bsb), blk, alt);
} return void;
given cfg_body_fixture (0, 5):() then alt0:(5)
given cfg_body_fixture (0, 9):() then alt0:(9)
