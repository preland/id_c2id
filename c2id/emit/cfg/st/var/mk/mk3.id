// The statement list of the block being filled. It is the list itself, not a
// copy -- `id` lists are reference-semantic -- so pushing into it stores into
// the block.
cur_stmts() {
  int blk = cur_blk();
  int[] l = cfg_stmts(blk);
} return int[] l;
given cfg_body_fixture ():([])
given cond_body_fixture ():([])

// A statement with no control flow of its own just lands in the current
// block: `expr`, `decl`, and anything the walker does not recognise.
add_stmt(int id) {
  int[] l = cur_stmts();
  push(l, id);
} return void;
given cfg_body_fixture (77):() then cur_stmts:([77])
given cfg_body_fixture (5):() then cur_stmts:([5])

// Top of a target stack, or -1 when the stack is empty -- which means a
// `break` or `continue` outside any loop or switch, i.e. C that a front end
// should have rejected.
top_of(int[] xs) {
  int blk = 0 - 1;
  if(len(xs) > 0) {
    blk = xs[len(xs) - 1];
  }
} return int blk;
