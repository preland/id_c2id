// Creating a block. A new block starts empty and unterminated; the walker
// always keeps the block it is filling unterminated, so a terminator is never
// written twice.

init_cfg5() {
  export int[] casv = [];
  export int[] casb = [];
} return void;

// Append a block and return its number.
new_block() {
  int[] ids = [];
  push((import bstmt), ids);
  push_bterm();
} return int len((import bkind)) - 1;

push_bterm() {
  push((import bkind), "none");
  push((import bsa), 0 - 1);
  push_bedge();
} return void;
