// One C function's blocks.
//
// `cfg_build` resets the graph, so a function is built and consumed before the
// next one starts -- the same contract emit/fr/ has for frame layout.

emit_blocks(int fn, int body) {
  cfg_build(body);
  int n = cfg_nblocks();
  emit_nb(fn, n);
} return void;

emit_nb(int fn, int n) {
  int b = 0;
  while(b < n) {
    if(skip_blk(b) == 0) {
      emit_blk(fn, b);
    }
    b = b + 1;
  }
} return void;

emit_blk(int fn, int b) {
  emit_mark();
  emit_open(fn, b);
  emit_term(b);
} return void;
