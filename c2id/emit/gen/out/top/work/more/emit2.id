// One C function's blocks.
//
// `cfg_build` resets the graph, so a function is built and consumed before the
// next one starts -- the same contract emit/fr/ has for frame layout.

emit_blocks(int fn, int body) {
  cfg_build(body);
  int n = cfg_nblocks();
  emit_nb(fn, n);
} return void;
given txt_fixture given init_tu (0, 0):() then calls cfg_build:(0)
given txt_fixture given init_tu (1, 0):() then calls cfg_build:(0)

emit_nb(int fn, int n) {
  int b = 0;
  while(b < n) {
    if(skip_blk(b) == 0) {
      emit_blk(fn, b);
    }
    b = b + 1;
  }
} return void;
given txt_fixture (0, 0):() then calls skip_blk:[0]
given txt_fixture (5, 0):() then calls skip_blk:[0]

emit_blk(int fn, int b) {
  emit_mark();
  emit_open(fn, b);
  emit_term(b);
} return void;
given init_gfn given cfg_body_fixture (0, 0):() then prints:("==== FILE b/0/0/0/0/0/f0.id\nblk0_0(word fp) {\n  poke64(fp, 0);\n  word nxt = 0 - 1;\n} return word nxt;\n")
given init_gfn given cfg_body_fixture (0, 1):() then prints:("==== FILE b/0/0/0/0/0/f0.id\nblk0_1(word fp) {\n  poke64(fp, 0);\n  word nxt = 0 - 1;\n} return word nxt;\n")
