// The straight-line statements of a block, and the start of its terminator.

emit_stmts(int b) {
  int[] xs = cfg_stmts(b);
  int i = 0;
  emit_each(xs, i);
} return void;

emit_each(int[] xs, int i) {
  while(i < len(xs)) {
    emit_stmt1(xs, i);
    i = i + 1;
  }
} return void;

// A call cannot be an argument to a call, so the text is named before it is
// printed rather than nested into the print -- and the temporaries that text
// refers to are printed before it.
emit_stmt1(int[] xs, int i) {
  string txt = st_txt(xs[i]);
  flush_pend();
  print("  " + txt);
} return void;
