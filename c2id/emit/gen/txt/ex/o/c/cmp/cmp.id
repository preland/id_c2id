// Comparisons.
//
// `id`'s `< <= > >=` are signed and its only unsigned comparison is the
// builtin `ult`, so the four unsigned relations are all written in terms of
// it. `==` and `!=` are the same test on the same bits whatever the
// signedness, so they never need it.
//
// Which one applies is decided by the usual arithmetic conversions over
// *both* operands, not by either alone: `-1 < 1u` is false in C, because the
// int becomes unsigned before the comparison. A pointer comparison lands here
// too, and comes out unsigned, which is what comparing addresses means.

cmp_txt(int id) {
  string s = "";
  if(s_of(id) == "==" || s_of(id) == "!=" || is_signed_cmp(id) == 1) {
    s = cmp_sgn(id);
  } else {
    s = ucmp_txt(id);
  }
} return string s;
given txt_fixture (0):("(NEEDS_CFG_prim int NEEDS_CFG_prim)") then calls cmp_sgn:(0)
given txt_fixture (5):("(NEEDS_CFG_prim  NEEDS_CFG_prim)") then calls cmp_sgn:(5)

cmp_sgn(int id) {
  int a = a_of(id);
  int b = b_of(id);
  string s = "(" + ex_txt(a) + " " + s_of(id) + " " + ex_txt(b) + ")";
} return string s;
given txt_fixture (0):("(NEEDS_CFG_prim int NEEDS_CFG_prim)")
given txt_fixture (5):("(NEEDS_CFG_prim  NEEDS_CFG_prim)")

// a > b is ult(b, a); a <= b is ult(b, a) negated; a >= b is ult(a, b)
// negated. So the operand order is decided here and the negation in
// ucmp_neg.
ucmp_txt(int id) {
  string s = ucmp_body(id);
  string out = ucmp_final(s, id);
} return string out;
given txt_fixture given pend_setup (0):("t0") then calls ucmp_body:(0)
given txt_fixture given pend_setup (5):("t0") then calls ucmp_body:(5)
