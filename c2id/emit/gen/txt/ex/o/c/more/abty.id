// The type of each operand of a binary-ish node, split out because id
// forbids a call nested inside another call's argument list --
// ex_ty(a_of(id)) needs a_of(id) named before it can be passed on. Shared
// by ty/r/bin.id, ex/o/b/bin.id, ex/o/c/cmp.id and ex/o/p/ptr.id, which all
// need the type of one or both operands of a two-child node.

a_ty(int id) {
  int a = a_of(id);
  int ty = ex_ty(a);
} return int ty;

b_ty(int id) {
  int b = b_of(id);
  int ty = ex_ty(b);
} return int ty;

// The usual arithmetic conversions applied to both operands of id.
pair_uty(int id) {
  int aty = a_ty(id);
  int bty = b_ty(id);
  int uty = usual_ty(aty, bty);
} return int uty;
