// Pointer arithmetic. C counts in elements and the flat store counts in
// bytes, so every one of these is a scaling by the pointee's size -- which is
// a translation-time constant, so it costs nothing at run time.

ptr_bin(int id) {
  string s = "";
  if(is_ptr_pair(id) == 1) {
    s = ptr_diff(id);
  } else {
    s = ptr_off(id);
  }
} return string s;
given txt_fixture (0):("(NEEDS_CFG_prim int (NEEDS_CFG_prim * 4))") then calls ptr_off:(0)
given txt_fixture (5):("(NEEDS_CFG_prim  (NEEDS_CFG_prim * 4))") then calls ptr_off:(5)

// The pointer may be on either side of a `+`. Naming which operand is which
// here is what lets ptr_off2 be written once.
ptr_off(int id) {
  string s = "";
  if(is_a_ptr(id) == 1) {
    string op = s_of(id);
    s = ptr_off_ab(id, op);
  } else {
    string op2 = s_of(id);
    s = ptr_off_ba(id, op2);
  }
} return string s;
given txt_fixture (0):("(NEEDS_CFG_prim int (NEEDS_CFG_prim * 4))") then calls ptr_off_ba:(0, "int")
given txt_fixture (5):("(NEEDS_CFG_prim  (NEEDS_CFG_prim * 4))") then calls ptr_off_ba:(5, "")

// No conv_txt: the result is an address, already 64 bits, and narrowing it
// would be wrong.
ptr_off2(int a, int b, string op) {
  int sz = ptr_off2_sz(a);
  string exb = ex_txt(b);
  string out = "(" + ex_txt(a) + " " + op + " " + scale_txt(exb, sz, "*") + ")";
} return string out;
given txt_fixture (1, 4, "+"):("(NEEDS_CFG_prim + (NEEDS_CFG_prim * 4))")
given txt_fixture (0, 5, "-"):("(NEEDS_CFG_prim - (NEEDS_CFG_ptr * 4))")
