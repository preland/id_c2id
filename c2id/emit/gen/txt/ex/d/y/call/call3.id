// assign_txt's two branches, split out because each needs a call's result
// named before the next call can take it, and assign_txt has no room left.

// `x = e`: aty and addr are ex_ty(a_of(id)) and addr_txt(a_of(id)),
// computed by the caller so this only has to name b's text.
assign_store(int id, int aty, string addr) {
  string exb = b_ex(id);
  string s = store_txt(aty, addr, exb);
} return string s;
given txt_fixture (0, 0, "fp + 8"):("poke32(fp + 8, NEEDS_CFG_prim)")
given txt_fixture (5, 2, "fp + 0"):("poke64(fp + 0, NEEDS_CFG_prim)")

// The rewritten-to-a-bin-node compound assignment.
assign_comp(int id, string head) {
  int a = a_of(id);
  int b = b_of(id);
  string s = comp_asg(a, b, head);
} return string s;
given txt_fixture given pend_setup (0, "in"):("poke32(NOT_AN_LVALUE_prim, t0)")
given txt_fixture given pend_setup (5, "XY"):("poke32(NOT_AN_LVALUE_prim, t0)")
