// call_txt's two halves -- the callee name and the parenthesised argument
// list -- split out because id forbids nesting args_txt(l_of(id)) inside
// the concatenation that names the whole call.

call_head(int id) {
  string s = "crt_call";
  int a = a_of(id);
  if(k_of(a) == "var") {
    string op = s_of(a);
    s = "c_" + op;
  }
} return string s;

call_wrap(string s, int id) {
  int[] ids = l_of(id);
  string out = s + "(" + args_txt(ids) + ")";
} return string out;

// s_of(id), read once and turned into the C operator it stands for.
assign_head(int id) {
  string op = s_of(id);
  string head = op_head(op);
} return string head;
