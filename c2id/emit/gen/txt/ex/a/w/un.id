// Unary operators, loosest binding first.

// `*p` is an lvalue like any other: address, then load. lval_txt gets the
// array case right for free -- `*p` where p is `char (*)[8]` is the array,
// whose value is its address, so nothing is loaded.
un_txt(int id) {
  string s = "";
  if(s_of(id) == "*") {
    s = lval_txt(id);
  } else {
    s = un2(id);
  }
} return string s;
given txt_fixture given pend_setup (0):("t0") then calls un2:(0)
given txt_fixture given pend_setup (5):("t0") then calls un2:(5)

// `&x` is the frame address and nothing else. Parenthesised for the same
// reason val_txt parenthesises a decayed array: `&b - &a` must not read
// `fp + 12 - fp + 8`.
un2(int id) {
  string s = "";
  if(s_of(id) == "&") {
    int a = a_of(id);
    s = "(" + addr_txt(a) + ")";
  } else {
    s = un3(id);
  }
} return string s;
given txt_fixture given pend_setup (0):("t0") then calls un3:(0)
given txt_fixture given pend_setup (5):("t0") then calls un3:(5)

// `id` has no `!`. C's is "compare against zero", which is what this is.
un3(int id) {
  string s = "";
  if(s_of(id) == "!") {
    int a = a_of(id);
    s = "(" + ex_txt(a) + " == 0)";
  } else {
    s = un4(id);
  }
} return string s;
given txt_fixture given pend_setup (0):("t0") then calls un4:(0)
given txt_fixture given pend_setup (5):("t0") then calls un4:(5)
