// C's integer promotion: anything narrower than int arrives at an operator as
// an int. This is why `(char)200 + (char)200` is 400 and not -112.
promote_ty(int ty) {
  int r = ty;
  if(k_of(ty) == "prim" && type_size(ty) < 4) {
    r = ty_int();
  }
} return int r;

// Does `s` contain byte `c` or byte `k`? Used only to read a literal's
// suffix, where the pair is the lower- and upper-case spelling of the same
// letter -- `4000000000u` and `4000000000U` are the same literal.
has_ch(string s, int c, int k) {
  int i = 0;
  int found = 0;
  while(i < len(s)) {
    if(charat(s, i) == c || charat(s, i) == k) {
      found = 1;
    }
    i = i + 1;
  }
} return int found;

// The C type of a local. Not a local -- a global, or a name the frame pass
// never saw -- answers `int`, which is what C itself assumes for an
// undeclared name.
local_ty(string name) {
  int i = find_local(name);
  int ty = ty_int();
  if(i >= 0) {
    ty = (import lvtys)[i];
  }
} return int ty;
