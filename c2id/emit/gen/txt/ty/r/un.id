// The type of a unary expression.
//
// `*p` is the pointee, `&x` is a pointer to whatever x is, `!e` is int
// whatever e is, and `- + ~ ++ --` all have their operand's promoted type --
// which is why `-c` on a char is an int, and why `-x` on an unsigned int
// wraps at 32 bits rather than becoming negative.

un_ty(int id) {
  int ty = elem_ty(ex_ty(a_of(id)));
  if(s_of(id) != "*") {
    ty = un_ty2(id);
  }
} return int ty;

// The `&` case builds a fresh ptr node. Lazily -- an eager arm here would
// allocate one on every unary operator in the program.
un_ty2(int id) {
  int ty = 0;
  if(s_of(id) == "&") {
    ty = newleaf("ptr", ex_ty(a_of(id)), 0, "", "");
  } else {
    ty = un_ty3(id);
  }
} return int ty;

un_ty3(int id) {
  int ty = promote_ty(ex_ty(a_of(id)));
  if(s_of(id) == "!") {
    ty = ty_int();
  }
} return int ty;
