// The rest of stdty, and the signedness question every operator asks.

ty_ulong() {
  int ty = (import stdty)[3];
} return int ty;

// `char *`, the type of a string literal.
ty_charp() {
  int ty = (import stdty)[4];
} return int ty;

// 1 when C's signed operators are the right ones for `ty`. A pointer, an
// array and a record are all "not signed": nothing divides or shifts them,
// and comparing two pointers is an unsigned comparison, which is what
// falling through to 0 here gives.
ty_signed(int ty) {
  int ok = 0;
  if(k_of(ty) == "prim") {
    ok = b_of(ty);
  }
} return int ok;
