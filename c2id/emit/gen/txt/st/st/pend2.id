// Taking the last temporary back, and printing the rest.

unname_pop(int k) {
  pop((import pend));
  string out = pop((import pendc));
  lset((import pendn), 0, k);
} return string out;

// Printed in the order they were named, then forgotten. The counter is not
// reset here, so a later statement in the same block cannot reuse a name.
flush_pend() {
  int i = 0;
  while(i < len((import pend))) {
    print("  " + (import pend)[i]);
    i = i + 1;
  }
  pend_clear();
} return void;

pend_clear() {
  while(len((import pend)) > 0) {
    pop((import pend));
    pop((import pendc));
  }
} return void;
